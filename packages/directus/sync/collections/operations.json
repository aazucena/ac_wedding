  {
    "name": "Compute New Amount Paid",
    "key": "compute_payment",
    "type": "exec",
    "position_x": 73,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function({ data }) {\n  const budget = data.find_budget_category[0];\n  const vendor = data.read_vendor;\n\n  if (!budget) return { skipped: true };\n\n  const contracts = vendor.contracts || [];\n  const totalCost = contracts.reduce((sum, c) => sum + (parseFloat(c.total_value) || 0), 0);\n\n  const currentPaid = parseFloat(budget.amount_paid) || 0;\n\n  return {\n    budget_id: budget.id,\n    new_amount_paid: currentPaid + totalCost\n  };\n}"
    },
