[
  {
    "name": "Allocate Budget",
    "key": "allocate_budget",
    "type": "exec",
    "position_x": 73,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function({ data }) {\n  const budget = data.find_budget_category[0];\n  const vendor = data.read_vendor;\n\n  if (!budget) return { skipped: true, reason: 'No budget category found for: ' + vendor.category };\n\n  const contracts = vendor.contracts || [];\n  const totalCost = contracts.reduce((sum, c) => sum + (parseFloat(c.total_value) || 0), 0);\n\n  const currentAllocated = parseFloat(budget.amount_allocated) || 0;\n  const newAllocated = currentAllocated + totalCost;\n\n  const ceiling = parseFloat(budget.ceiling_amount) || 0;\n  const contingency = (budget.contingency_percent || 10) / 100;\n  const effectiveCeiling = ceiling * (1 + contingency);\n  const isOverBudget = newAllocated > effectiveCeiling;\n\n  return {\n    budget_id: budget.id,\n    new_allocated: newAllocated,\n    is_over_budget: isOverBudget,\n    effective_ceiling: effectiveCeiling,\n    vendor_cost: totalCost\n  };\n}"
    },
    "resolve": "ef670742-8d3c-481e-9ec9-76d335e2e117",
    "reject": null,
    "flow": "e13a1d5a-0a9d-4964-85e4-45b18a01a76f",
    "_syncId": "e34f2f34-de6b-46c2-b718-b158b679d7b4"
  },
  {
    "name": "Apply Recessional Orders",
    "key": "apply_recessional_orders",
    "type": "exec",
    "position_x": 55,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function({ data, services, database, getSchema }) {\n  const { ItemsService } = services;\n  const schema = await getSchema();\n  const entourageService = new ItemsService('entourage', { database, schema });\n\n  const updates = data.compute_recessional.updates;\n  if (!updates || updates.length === 0) return { updated: 0 };\n\n  // Update each member's recessional_order individually\n  // (Directus updateMany sets the same value for all — we need per-item updates)\n  await Promise.all(\n    updates.map(({ id, recessional_order }) =>\n      entourageService.updateOne(id, { recessional_order })\n    )\n  );\n\n  return { updated: updates.length };\n}"
    },
    "resolve": "e6765ecd-5608-4f18-974b-576444575d5c",
    "reject": null,
    "flow": "d2de6d84-28bf-4827-93ae-33cf2af06c1a",
    "_syncId": "86da0433-0e71-4b92-bb69-92acc14bbb81"
  },
