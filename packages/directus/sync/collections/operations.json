  {
    "name": "Reverse Budget Allocation",
    "key": "reverse_allocation",
    "type": "exec",
    "position_x": 73,
    "position_y": 19,
    "options": {
      "code": "module.exports = async function({ data }) {\n  const budget = data.find_budget_category_for_reversal[0];\n  const vendor = data.read_vendor;\n\n  if (!budget) return { skipped: true };\n\n  const contracts = vendor.contracts || [];\n  const totalCost = contracts.reduce((sum, c) => sum + (parseFloat(c.total_value) || 0), 0);\n\n  const currentAllocated = parseFloat(budget.amount_allocated) || 0;\n  const newAllocated = Math.max(0, currentAllocated - totalCost);\n\n  const ceiling = parseFloat(budget.ceiling_amount) || 0;\n  const contingency = (budget.contingency_percent || 10) / 100;\n  const effectiveCeiling = ceiling * (1 + contingency);\n  const isOverBudget = newAllocated > effectiveCeiling;\n\n  return {\n    budget_id: budget.id,\n    new_allocated: newAllocated,\n    is_over_budget: isOverBudget\n  };\n}"
    },
    "resolve": "474bbc9f-5583-448b-949c-f44008550816",
    "reject": null,
    "flow": "e13a1d5a-0a9d-4964-85e4-45b18a01a76f",
    "_syncId": "6f9ba512-69be-4229-bb37-0994d52f49ad"
  },
  {
    "name": "Generate RSVP Token",
    "key": "rsvp",
    "type": "exec",
    "position_x": 37,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function(data) {\n    const CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789';\n    const BLACKLIST_FILTER = [\n        'FAMILY',\n        'PARTY',\n        'GROUP',\n        'EXTENDED',\n        'THE',\n        'AND',\n        'MEMBERS',\n        'FRIENDS',\n        'COWORKERS',\n        'COLLEAGUES'\n    ];\n    function randomChars(n) {\n        var s = '';\n        for (var i = 0; i < n; i++) {\n            s += CHARS[Math.floor(Math.random() * CHARS.length)];\n        }\n        return s;\n    }\n    const party = data?.party;\n    const group = party?.group;\n    function generateToken(str, maxLength = 8, delim = '-') {\n      const suggestedLength = Math.ceil(maxLength / 2);\n      const remainingLength = Math.floor(maxLength / 2);\n      if (!str) return randomChars(maxLength);\n      let prefix = str.toUpperCase()\n        .split(/\\\\s+/)\n        .filter(w => BLACKLIST_FILTER.indexOf(w) === -1)\n        .join('')\n        .replace(/[^A-Z0-9]/g, '')\n        .slice(0, suggestedLength);\n      if (!prefix) return randomChars(maxLength);\n      return [prefix, randomChars(remainingLength)].join(delim);\n    }\n    const timestamp = new Date().toISOString().split(\".\")[0].replace('T', ' ');\n    \n    const groupName = group?.name ?? party?.name ?? '';\n    const token = generateToken(groupName);\n    return {\n      ...data,\n      token,\n      timestamp,\n    };\n}"
    },
    "resolve": "6ad5491c-8edd-4f65-afc8-d93b9dcd46f0",
    "reject": null,
    "flow": "9978a209-4a98-429c-b32e-d233ecef70b7",
    "_syncId": "5891d591-64b1-477a-a83d-d186a3a5f015"
  },
