  {
    "name": "Check Deadline & Mark Non-Responders",
    "key": "check_and_mark",
    "type": "exec",
    "position_x": 19,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function({ data, services, database, getSchema }) {\n  const { ItemsService } = services;\n  const schema = await getSchema();\n\n  // Read RSVP deadline from settings\n  const settingsService = new ItemsService('wedding_settings', { database, schema });\n  const settings = await settingsService.readOne(1, { fields: ['rsvp_deadline'] });\n\n  if (!settings?.rsvp_deadline) {\n    return { skipped: true, reason: 'No rsvp_deadline set in wedding_settings' };\n  }\n\n  const deadline = new Date(settings.rsvp_deadline);\n  const now = new Date();\n\n  if (now <= deadline) {\n    return { skipped: true, reason: 'Deadline has not passed yet', deadline: settings.rsvp_deadline };\n  }\n\n  // Batch-update all parties that have not responded\n  const partiesService = new ItemsService('parties', { database, schema });\n  const updated = await partiesService.updateByQuery(\n    {\n      filter: {\n        _and: [\n          { status: { _nin: ['confirmed', 'declined', 'no_response'] } }\n        ]\n      }\n    },\n    { status: 'no_response' }\n  );\n\n  return {\n    marked: Array.isArray(updated) ? updated.length : 0,\n    deadline: settings.rsvp_deadline,\n    ran_at: now.toISOString()\n  };\n}"
    },
    "resolve": "bcb61151-97c2-4c29-af32-42b4cdbe80b6",
    "reject": "bcb61151-97c2-4c29-af32-42b4cdbe80b6",
