  {
    "name": "Compute Recessional Orders",
    "key": "compute_recessional",
    "type": "exec",
    "position_x": 37,
    "position_y": 1,
    "options": {
      "code": "module.exports = async function({ data }) {\n  const members = data.fetch_all;\n  if (!members || members.length === 0) return { updates: [] };\n\n  // Couple roles always exit first (recessional_order = 1)\n  const COUPLE_ROLES = ['bride', 'groom'];\n\n  const withOrder = members.filter(m => m.sequence_order !== null);\n  const maxOrder = Math.max(...withOrder.map(m => m.sequence_order));\n\n  const updates = members.map(member => {\n    const isCouple = COUPLE_ROLES.includes(member.role);\n    const recessionalOrder = isCouple\n      ? 1\n      : (maxOrder + 1) - member.sequence_order;\n\n    return {\n      id: member.id,\n      recessional_order: recessionalOrder\n    };\n  });\n\n  return { updates, count: updates.length };\n}"
    },
    "resolve": "86da0433-0e71-4b92-bb69-92acc14bbb81",
    "reject": null,
    "flow": "d2de6d84-28bf-4827-93ae-33cf2af06c1a",
    "_syncId": "108ce3dd-0aba-4e88-90cc-01051e8669df"
  },
