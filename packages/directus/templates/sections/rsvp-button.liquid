{% comment %} packages/directus/templates/sections/rsvp-button.liquid {% endcomment %}
{% comment %} RSVP call-to-action button + deadline reminder {% endcomment %}
{% comment %} URL built from constants.public_url (env var via exec op) + party rsvp_token (auto-generated by Flow 01) {% endcomment %}

<!-- Accent bar — mirrors website .card accent bar -->
<tr>
  <td style="height:5px; background:linear-gradient(90deg, {{ read_wedding_settings.color_primary }} 0%, {{ read_wedding_settings.color_secondary }} 100%);"></td>
</tr>

<!-- ─── RSVP BUTTON ───────────────────────────────── -->
<tr>
  <td class="rsvp-wrap" style="padding-top:32px;">
    <a href="{{ constants.public_url }}/rsvp/{{ read_guest.rsvp_token }}" class="rsvp-btn">
      Kindly Reply
    </a>
    <p class="rsvp-deadline">
      Please respond by <strong>{{ read_wedding_settings.rsvp_deadline }}</strong>
    </p>
  </td>
</tr>
