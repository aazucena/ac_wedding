<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>You're Invited — {{ read_wedding_settings.groom.first_name }} & {{ read_wedding_settings.bride.first_name }}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    {% comment %}
      CSS lives here in <head> — email clients require it inline, not in an external file.
      Design system mirrors apps/web/src/styles/global.css.
      color_primary (#A8D4B8) and color_secondary (#C5B8E0) are Liquid vars from read_wedding_settings.
      No flexbox, grid, or color-mix() — email-client-safe only.
    {% endcomment %}

    /* ─── Reset ─────────────────────────────────── */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; }
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }

    /* ─── Web Fonts ──────────────────────────────── */
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap');

    /* ─── Base ───────────────────────────────────── */
    body { background-color: #f4f0ec; font-family: 'Jost', Arial, sans-serif; }
    .email-wrapper { background-color: #f4f0ec; padding: 40px 16px; }
    .email-container { max-width: 600px; margin: 0 auto; background: #fdfaf7; border-radius: 2px; overflow: hidden; box-shadow: 0 8px 48px rgba(26,26,46,0.08), 0 2px 12px rgba(26,26,46,0.04); border: 1px solid rgba(196,186,220,0.25); }

    /* ─── Decorative Bands ───────────────────────── */
    .band-top { height: 6px; background: linear-gradient(90deg, {{ read_wedding_settings.color_primary }} 0%, {{ read_wedding_settings.color_secondary }} 50%, {{ read_wedding_settings.color_primary }} 100%); }
    .band-bottom { height: 4px; background: linear-gradient(90deg, {{ read_wedding_settings.color_secondary }} 0%, {{ read_wedding_settings.color_primary }} 50%, {{ read_wedding_settings.color_secondary }} 100%); }

    /* ─── Hero ───────────────────────────────────── */
    .hero { position: relative; background-color: #1a1a2e; overflow: hidden; }
    .hero-image { width: 100%; height: 340px; object-fit: cover; display: block; opacity: 0.82; }
    /* Gradient mirrors website: dark+warm → secondary+warm → primary+warm at 165deg */
    .hero-placeholder { width: 100%; height: 340px; background: linear-gradient(165deg, #9d9aa0 0%, #7a6b9a 35%, #2d2248 70%, #1a1a2e 100%); text-align: center; position: relative; overflow: hidden; }
    .hero-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 36px 40px 32px; background: linear-gradient(to top, rgba(26,26,46,0.92) 0%, rgba(26,26,46,0.60) 55%, transparent 100%); text-align: center; }
    .hero-eyebrow { font-family: 'Jost', Arial, sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; color: rgba(255,255,255,0.70); margin-bottom: 14px; }
    .hero-names { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 52px; font-weight: 300; font-style: italic; color: #fdfaf7; line-height: 1.05; letter-spacing: -0.5px; }
    .hero-names .ampersand { color: {{ read_wedding_settings.color_secondary }}; font-style: normal; font-weight: 300; }
    .hero-divider-symbol { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; color: {{ read_wedding_settings.color_secondary }}; line-height: 1; }
    .hero-date { font-family: 'Jost', Arial, sans-serif; font-size: 11px; font-weight: 400; letter-spacing: 3.5px; text-transform: uppercase; color: #8a8499; }

    /* ─── Section Badge (mirrors .header-eyebrow pill) ── */
    .section-badge { display: inline-block; font-family: 'Jost', Arial, sans-serif; font-size: 10px; font-weight: 500; letter-spacing: 3.5px; text-transform: uppercase; background: linear-gradient(135deg, #e9f4ed 0%, #f0edf7 100%); color: #565170; border: 1px solid #eeeaf6; border-radius: 999px; padding: 6px 16px; margin-bottom: 20px; }

    /* ─── Greeting Band ──────────────────────────── */
    .greeting-band { background: linear-gradient(135deg, {{ read_wedding_settings.color_primary }} 0%, {{ read_wedding_settings.color_secondary }} 100%); padding: 20px 40px; text-align: center; }
    .greeting-band p { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; font-weight: 400; font-style: italic; color: #1a1a2e; letter-spacing: 0.3px; }

    /* ─── Body ───────────────────────────────────── */
    .body-section { padding: 48px 48px 32px; text-align: center; }
    .invite-verse { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; font-weight: 300; font-style: italic; color: #5a5570; line-height: 1.9; margin-bottom: 32px; padding: 0 8px; }
    .invite-verse strong { font-style: normal; font-weight: 500; color: #3d3752; }

    /* ─── Ornament ───────────────────────────────── */
    .ornament-symbol { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 18px; color: {{ read_wedding_settings.color_secondary }}; line-height: 1; }

    /* ─── Event Details (mirrors EventStrip cards) ── */
    .details-grid { display: table; width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 32px; }
    .detail-cell { display: table-cell; width: 50%; padding: 20px; vertical-align: top; text-align: center; background: #fdfaf7; border: 1px solid rgba(196,186,220,0.45); }
    .detail-cell:first-child { border-right: none; }
    .detail-label-badge { display: inline-block; font-family: 'Jost', Arial, sans-serif; font-size: 9px; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; background: linear-gradient(135deg, #e9f4ed 0%, #f0edf7 100%); color: #565170; border-radius: 999px; padding: 4px 12px; margin-bottom: 10px; }
    .detail-label-badge.reception { background: linear-gradient(135deg, #f0edf7 0%, #e9f4ed 100%); }
    .detail-icon { font-size: 20px; margin-bottom: 8px; display: block; }
    .detail-value { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; font-weight: 400; color: #1a1a2e; line-height: 1.3; }
    .detail-sub { font-family: 'Jost', Arial, sans-serif; font-size: 12px; font-weight: 300; color: #8a8499; margin-top: 4px; display: block; }

    /* ─── RSVP Button (mirrors submit button) ────── */
    .rsvp-wrap { padding: 0 48px 32px; text-align: center; }
    .rsvp-btn { display: inline-block; background: linear-gradient(135deg, #1a1a2e 0%, #2d2248 100%); color: {{ read_wedding_settings.color_primary }} !important; text-decoration: none; padding: 18px 56px; font-family: 'Jost', Arial, sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 4px; text-transform: uppercase; border-radius: 14px; box-shadow: 0 8px 32px rgba(26,26,46,0.20); }
    .rsvp-deadline { margin-top: 14px; font-family: 'Jost', Arial, sans-serif; font-size: 12px; font-weight: 300; color: #9a95a8; letter-spacing: 0.5px; }
    .rsvp-deadline strong { color: {{ read_wedding_settings.color_secondary }}; font-weight: 500; }

    /* ─── Info Cards (mirrors .card) ─────────────── */
    .info-section { padding: 32px 48px; border-top: 1px solid rgba(196,186,220,0.45); }
    .info-cards { display: table; width: 100%; border-collapse: separate; border-spacing: 8px 0; }
    .info-card { display: table-cell; width: 50%; background: #fdfaf7; border-radius: 2px; padding: 0; vertical-align: top; border: 1px solid rgba(196,186,220,0.45); box-shadow: 0 4px 20px rgba(26,26,46,0.05); overflow: hidden; }
    .info-card-accent { height: 4px; background: linear-gradient(90deg, {{ read_wedding_settings.color_secondary }}, {{ read_wedding_settings.color_primary }}); }
    .info-card.mint .info-card-accent { background: linear-gradient(90deg, {{ read_wedding_settings.color_primary }}, {{ read_wedding_settings.color_secondary }}); }
    .info-card-body { padding: 16px 18px 18px; }
    .info-card-title { font-family: 'Jost', Arial, sans-serif; font-size: 10px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; color: #3d3752; margin-bottom: 8px; display: block; }
    .info-card p { font-family: 'Jost', Arial, sans-serif; font-size: 13px; font-weight: 300; color: #5a5570; line-height: 1.7; }
    .info-card a { color: {{ read_wedding_settings.color_secondary }}; text-decoration: underline; text-underline-offset: 2px; }

    /* ─── Dress Code ─────────────────────────────── */
    .dresscode-section { padding: 32px 48px; background: linear-gradient(135deg, rgba(168,212,184,0.06) 0%, rgba(197,184,224,0.06) 100%); border-top: 1px solid rgba(196,186,220,0.45); text-align: center; }
    .swatch { width: 32px; height: 32px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.8); box-shadow: 0 2px 8px rgba(0,0,0,0.12); }
    .dresscode-note { font-family: 'Jost', Arial, sans-serif; font-size: 12px; font-weight: 300; color: #7a7488; font-style: italic; }

    /* ─── Wedding Website ────────────────────────── */
    .website-section { padding: 28px 48px; border-top: 1px solid rgba(196,186,220,0.45); text-align: center; }
    .website-section p { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 16px; font-style: italic; color: #5a5570; margin-bottom: 10px; }
    .website-link { font-family: 'Jost', Arial, sans-serif; font-size: 12px; font-weight: 500; letter-spacing: 2px; color: {{ read_wedding_settings.color_secondary }} !important; text-decoration: none; border-bottom: 1px solid rgba(197,184,224,0.4); padding-bottom: 2px; }

    /* ─── Heritage Section ───────────────────────── */
    .heritage-section { padding: 32px 48px; background: #1a1a2e; text-align: center; }
    .heritage-verse { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 17px; font-weight: 300; font-style: italic; color: rgba(253,250,247,0.7); line-height: 1.8; margin-bottom: 8px; }
    .heritage-attribution { font-family: 'Jost', Arial, sans-serif; font-size: 10px; font-weight: 400; letter-spacing: 2px; text-transform: uppercase; color: {{ read_wedding_settings.color_primary }}; }

    /* ─── Footer ─────────────────────────────────── */
    .footer { padding: 32px 48px; text-align: center; border-top: 1px solid rgba(196,186,220,0.45); }
    .footer-hashtag { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-style: italic; color: {{ read_wedding_settings.color_secondary }}; margin-bottom: 16px; }
    .footer-couple { font-family: 'Jost', Arial, sans-serif; font-size: 11px; font-weight: 300; letter-spacing: 0.5px; color: #9a95a8; line-height: 1.8; }
    .footer-couple a { color: {{ read_wedding_settings.color_secondary }} !important; }
    .footer-fine { margin-top: 20px; font-family: 'Jost', Arial, sans-serif; font-size: 10px; font-weight: 300; color: #bbb5c8; line-height: 1.6; }

    /* ─── Responsive ─────────────────────────────── */
    @media only screen and (max-width: 480px) {
      .body-section, .rsvp-wrap, .info-section,
      .dresscode-section, .website-section,
      .heritage-section, .footer { padding-left: 24px; padding-right: 24px; }
      .hero-names { font-size: 38px; }
      .details-grid { display: block; }
      .detail-cell { display: block; width: 100%; border-right: 1px solid rgba(196,186,220,0.45) !important; border-bottom: none; margin-bottom: 8px; }
      .info-cards { display: block; }
      .info-card { display: block; width: 100%; margin-bottom: 8px; }
      .rsvp-btn { padding: 16px 32px; }
    }
  </style>
</head>
<body>
<div class="email-wrapper">
<table class="email-container" width="100%" cellpadding="0" cellspacing="0" role="presentation">

  {% render 'sections/hero.liquid', read_wedding_settings: read_wedding_settings, constants: constants %}
  {% render 'sections/greeting.liquid', read_guest: read_guest %}
  {% render 'sections/details.liquid', read_wedding_settings: read_wedding_settings %}
  {% render 'sections/rsvp-button.liquid', read_guest: read_guest, read_wedding_settings: read_wedding_settings, constants: constants %}
  {% render 'sections/dresscode.liquid', read_wedding_settings: read_wedding_settings %}
  {% render 'sections/info-cards.liquid', read_wedding_settings: read_wedding_settings %}
  {% render 'sections/website.liquid', constants: constants %}
  {% render 'sections/heritage.liquid' %}
  {% render 'sections/footer.liquid', read_wedding_settings: read_wedding_settings, constants: constants %}

</table>
</div>
</body>
</html>
