---
export const prerender = false;
// apps/web/src/pages/gallery.astro
import Layout          from '../layouts/Layout.astro';
import PageHeader      from '../components/PageHeader.astro';
import GalleryGrid     from '../components/gallery/GalleryGrid.astro';
import GalleryLightbox from '../components/gallery/GalleryLightbox.astro';
import { getSettings, getGalleryPhotos, type Vendors } from '../lib/directus';
import { formatDate, assetUrl } from '../lib/utils/format';
import Hashtag from '~/components/Hashtag.astro';
import { PUBLIC_DOWNLOAD_GALLERY_IMAGES } from 'astro:env/client';

const [settings, photos] = await Promise.all([getSettings(), getGalleryPhotos()]);
const groom = settings.groom?.first_name ?? 'Aldrin';
const bride  = settings.bride?.first_name ?? 'Christine';
const weddingDateLabel = formatDate(settings.wedding_date ?? '2026-09-26');

const placeholders = Array.from({ length: 9 }, (_, i) => ({
  id: `placeholder-${i}`, title: null, description: null, image: null, sort: i,
}));

const items = photos.length > 0 ? photos : (import.meta.env.DEV ? placeholders : []);
const _photo = typeof settings.photographer === 'object'
  ? (settings.photographer as Vendors)
  : null;

const CATEGORY_ORDER = [
  'engagement', 'details', 'preparation', 'bridesmaids', 'groomsmen',
  'ceremony', 'group_photos', 'reception', 'portraits', 'candids', 'family_formals',
];
const CATEGORY_LABELS: Record<string, string> = {
  engagement:     'Engagement',
  details:        'Details',
  preparation:    'Preparation',
  bridesmaids:    'Bridesmaids',
  groomsmen:      'Groomsmen',
  ceremony:       'Ceremony',
  group_photos:   'Group Photos',
  reception:      'Reception',
  portraits:      'Portraits',
  candids:        'Candids',
  family_formals: 'Family Formals',
};

const categoriesInUse = new Set(photos.map(p => p.category).filter(Boolean));
const activeCategories = CATEGORY_ORDER.filter(c => categoriesInUse.has(c));
const hasBW      = photos.some(p => p.bw);
const showFilter = activeCategories.length > 1 || hasBW;
---

<Layout
  title={`Gallery — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="gallery"
>

  <div class="page-wide gallery-page" id="photos">

    <PageHeader
      groomName={groom}
      brideName={bride}
      eyebrow="Memories together"
      date={`Our Gallery · ${weddingDateLabel}`}
    />

    {showFilter && (
      <div class="gallery-filter" id="gallery-filter" role="group" aria-label="Filter photos">
        <button class="gallery-filter-btn active" data-filter="all">All</button>
        {activeCategories.map(cat => (
          <button class="gallery-filter-btn" data-filter={cat}>
            {CATEGORY_LABELS[cat]}
          </button>
        ))}
        {hasBW && (
          <>
            <span class="gallery-filter-sep" aria-hidden="true"></span>
            <button class="gallery-filter-bw" id="gallery-filter-bw" aria-pressed="false">
              B&amp;W
            </button>
          </>
        )}
      </div>
    )}

    {items.length > 0 && <GalleryGrid items={items} />}

    <p class="gallery-filter-empty" id="gallery-filter-empty" aria-live="polite"></p>

    {photos.length === 0 && (
      <p class="gallery-empty">Photos will be added soon. Check back after the wedding!</p>
    )}

    {_photo?.name && (
      <div class="photographer-card">
        {_photo.logo?.id && (
          <img
            src={assetUrl(_photo.logo, { height: 72 })}
            alt={_photo.name}
            class="photographer-logo"
          />
        )}
        <p class="photographer-label">Official Photographer</p>
        <p class="photographer-name">{_photo.name}</p>
        {_photo.subtitle && <p class="photographer-subtitle">{_photo.subtitle}</p>}
        {_photo.website && (
          <a href={_photo.website} target="_blank" rel="noopener noreferrer" class="photographer-link">
            Visit website ↗
          </a>
        )}
      </div>
    )}

    {_photo?.name && <div class="pictime-card">
      <p class="pictime-label">Official Photo Gallery</p>
      <p class="pictime-heading">Full Collection &amp; Prints</p>
      <p class="pictime-desc">Browse the full collection — from our engagement shoot through the wedding day and beyond. Order prints, and download your favourite moments.</p>
      <a
        href="https://kvnmcbnqlshoots.pic-time.com/client/azucena-wedding"
        target="_blank"
        rel="noopener noreferrer"
        class="pictime-btn"
      >
        Open Gallery ↗
      </a>
    </div>}

  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>

  <GalleryLightbox slot="overlay" photographer={_photo?.name ?? null} photographerLogo={_photo?.logo ?? null} showDownload={PUBLIC_DOWNLOAD_GALLERY_IMAGES ?? false} />

</Layout>

<style>
.gallery-page { display: flex; flex-direction: column; align-items: center; }
.gallery-empty {
  font-family: var(--fb); font-size: 14px; font-weight: 300;
  color: var(--muted); text-align: center; margin-top: 16px;
  font-style: italic;
}

/* ── Category filter ─────────────────────────────────────── */
.gallery-filter {
  display: flex; flex-wrap: wrap;
  align-items: center; justify-content: center;
  gap: 2px; width: 100%; margin-bottom: 32px;
}

.gallery-filter-btn {
  position: relative;
  background: none; border: none; cursor: pointer;
  font-family: var(--fb); font-size: 9.5px; font-weight: 500;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--muted);
  padding: 8px 14px;
  transition: color 0.2s ease;
}
.gallery-filter-btn::after {
  content: '';
  position: absolute; bottom: 4px; left: 14px; right: 14px;
  height: 1px;
  background: var(--cp);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.25s ease;
}
.gallery-filter-btn:hover { color: var(--dark); }
.gallery-filter-btn.active {
  color: var(--dark); font-weight: 600;
}
.gallery-filter-btn.active::after { transform: scaleX(1); }

.gallery-filter-sep {
  width: 1px; height: 12px; align-self: center;
  background: var(--border); margin: 0 6px; flex-shrink: 0;
}

.gallery-filter-bw {
  position: relative;
  background: none; border: none; cursor: pointer;
  font-family: var(--fb); font-size: 9.5px; font-weight: 500;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--muted);
  padding: 8px 14px;
  transition: color 0.2s ease;
}
.gallery-filter-bw::after {
  content: '';
  position: absolute; bottom: 4px; left: 14px; right: 14px;
  height: 1px;
  background: var(--dark);
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 0.25s ease;
}
.gallery-filter-bw:hover { color: var(--dark); }
.gallery-filter-bw.active {
  color: var(--dark); font-weight: 600;
}
.gallery-filter-bw.active::after { transform: scaleX(1); }

.gallery-filter-empty {
  font-family: var(--fd); font-size: 18px; font-weight: 300;
  font-style: italic; color: var(--muted);
  text-align: center; margin: 24px 0; min-height: 0;
}

.photographer-card {
  margin-top: 40px; width: 100%;
  background: var(--ivory); border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow-card);
  padding: 40px 32px; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.photographer-logo {
  height: 72px; width: auto; max-width: 240px;
  object-fit: contain; margin-bottom: 8px;
}
.photographer-label {
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--cp);
}
.photographer-name {
  font-family: var(--fd); font-size: 26px; font-weight: 300;
  font-style: italic; color: var(--dark); line-height: 1.2;
}
.photographer-subtitle {
  font-family: var(--fb); font-size: 12px; font-weight: 300;
  color: var(--muted);
}
.photographer-link {
  margin-top: 4px;
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase;
  color: var(--cs); text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--cs) 40%, transparent);
  padding-bottom: 1px; transition: opacity 0.2s;
}
.photographer-link:hover { opacity: 0.7; }

.pictime-card {
  margin-top: 16px; width: 100%;
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--cp) 12%, var(--ivory)),
    color-mix(in srgb, var(--cs) 10%, var(--ivory))
  );
  border: 1px solid color-mix(in srgb, var(--cp) 30%, var(--border));
  border-radius: var(--radius); box-shadow: var(--shadow-card);
  padding: 40px 32px; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 10px;
}
.pictime-label {
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--cp);
}
.pictime-heading {
  font-family: var(--fd); font-size: 26px; font-weight: 300;
  font-style: italic; color: var(--dark); line-height: 1.2;
}
.pictime-desc {
  font-family: var(--fb); font-size: 13px; font-weight: 300;
  color: var(--muted); max-width: 420px; line-height: 1.7;
}
.pictime-btn {
  margin-top: 6px;
  display: inline-block; padding: 14px 36px;
  background: linear-gradient(135deg, var(--dark), var(--dark2));
  color: color-mix(in srgb, var(--cp) 80%, white);
  border-radius: var(--radius-sm); text-decoration: none;
  font-family: var(--fb); font-size: 11px; font-weight: 600;
  letter-spacing: 3px; text-transform: uppercase;
  box-shadow: 0 8px 24px rgba(26,26,46,0.18);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.pictime-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(26,26,46,0.25); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const filterBtns  = document.querySelectorAll<HTMLButtonElement>('.gallery-filter-btn');
    const bwBtn       = document.getElementById('gallery-filter-bw') as HTMLButtonElement | null;
    const gridItems   = document.querySelectorAll<HTMLElement>('.gallery-item:not(.gallery-item--pad)');
    const padItems    = document.querySelectorAll<HTMLElement>('.gallery-item--pad');
    const emptyMsg    = document.getElementById('gallery-filter-empty');

    if (!filterBtns.length || !gridItems.length) return;

    let activeCategory = 'all';
    let bwOnly = false;

    function applyFilter() {
      let visible = 0;
      gridItems.forEach(item => {
        const cat   = item.dataset.category ?? '';
        const isBW  = item.dataset.bw === 'true';
        const catOk = activeCategory === 'all' || cat === activeCategory;
        const bwOk  = !bwOnly || isBW;
        const show  = catOk && bwOk;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      const showPads = activeCategory === 'all' && !bwOnly;
      padItems.forEach(p => { p.style.display = showPads ? '' : 'none'; });
      if (emptyMsg) {
        emptyMsg.textContent = visible === 0
          ? 'No photos in this category yet — check back soon.'
          : '';
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCategory = btn.dataset.filter ?? 'all';
        applyFilter();
      });
    });

    bwBtn?.addEventListener('click', () => {
      bwOnly = !bwOnly;
      bwBtn.classList.toggle('active', bwOnly);
      bwBtn.setAttribute('aria-pressed', String(bwOnly));
      applyFilter();
    });
  });
</script>