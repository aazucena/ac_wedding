---
// apps/web/src/pages/memories.astro — guest-submitted wedding photos slideshow
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/gallery/GalleryGrid.astro';
import GalleryLightbox from '../components/gallery/GalleryLightbox.astro';
import { getSettings } from '../lib/directus';
import { getMemories } from '../lib/api/content';
import { formatDate } from '../lib/utils/format';
import { DateTime } from 'luxon';
import { toDateTime } from '../lib/date';
import Hashtag from '~/components/Hashtag.astro';

const [settings, memories] = await Promise.all([getSettings(), getMemories()]);

// Post-wedding gate: redirect to home if wedding hasn't happened yet
if (DateTime.now() < toDateTime(settings.wedding_date ?? '2099-12-31')) {
  return Astro.redirect('/', 307);
}

const groom = settings.groom?.first_name ?? 'Aldrin';
const bride = settings.bride?.first_name ?? 'Christine';
const weddingDateLabel = formatDate(settings.wedding_date ?? '2026-09-26');

const items = memories.map(m => ({
  id: m.id,
  title: m.title ?? null,
  description: m.description ?? null,
  image: m.image,
  sort: null,
}));
---

<Layout
  title={`Wedding Memories — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="memories"
>
  <div class="page-wide memories-page" id="memories">

    <header class="header">
      <div class="header-eyebrow">Our Wedding Memories</div>
      <h1 class="header-title font-display">{groom} & {bride}</h1>
      <p class="header-subtitle">
        Photos shared by our guests on {weddingDateLabel}.
      </p>
    </header>

    {items.length > 0 ? (
      <GalleryGrid items={items} />
    ) : (
      <div class="empty-state">
        <span class="empty-icon">📷</span>
        <p class="empty-title font-display">Photos coming soon</p>
        <p class="empty-body">
          Guest photos will appear here after the wedding.
          Check back soon!
        </p>
      </div>
    )}

  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>

  <GalleryLightbox slot="overlay" />
</Layout>

<style>
.memories-page { display: flex; flex-direction: column; align-items: center; }

.empty-state {
  display: flex; flex-direction: column; align-items: center;
  gap: 12px; padding: 64px 24px; text-align: center;
  max-width: 400px; margin: 0 auto;
}
.empty-icon { font-size: 40px; opacity: 0.4; }
.empty-title {
  font-size: 22px; font-style: italic; font-weight: 300;
  color: var(--dark);
}
.empty-body {
  font-family: var(--fb); font-size: 14px; font-weight: 300;
  color: var(--muted); line-height: 1.6;
}
</style>
