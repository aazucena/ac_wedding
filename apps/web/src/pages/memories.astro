---
// apps/web/src/pages/memories.astro — guest-submitted wedding photos + guestbook messages
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import MemoryGrid from "../components/memories/MemoryGrid.astro";
import GalleryLightbox from "../components/gallery/GalleryLightbox.astro";
import GuestbookSwiper from "../components/guestbook/GuestbookSwiper.astro";
import MemoryUpload from "../components/memories/MemoryUpload.astro";
import { getSettings } from "../lib/directus";
import { getMemories } from "../lib/api/content";
import { getGuestbookEntries } from "../lib/api/guestbook";
import { formatDate } from "../lib/utils/format";
import { parseMarkdown } from "../lib/markdown";
import { DateTime } from "luxon";
import { toDateTime } from "../lib/date";
import Hashtag from "~/components/Hashtag.astro";
import type { Persons } from "../lib/types";

const [settings, memories, entries] = await Promise.all([
  getSettings(),
  getMemories(),
  getGuestbookEntries(),
]);

// Post-wedding gate. Dev mode is exempt so the page can be worked on before
// the wedding date, matching how /print/* and /admin/* are already gated in
// middleware.ts. Production is unaffected: import.meta.env.DEV is false there.
if (
  !Astro.locals.isPreview &&
  !import.meta.env.DEV &&
  DateTime.now() < toDateTime(settings.wedding_date ?? "2099-12-31")
) {
  return Astro.redirect("/", 307);
}

const groom = settings.groom?.first_name ?? "Aldrin";
const bride = settings.bride?.first_name ?? "Christine";
const weddingDateLabel = formatDate(settings.wedding_date ?? "2026-09-26");
const hashtag = settings.hashtag ?? null;

function shortDate(iso?: string): string {
  if (!iso) return "";
  return formatDate(iso, "MMM d, yyyy");
}

/**
 * Who took the photo. Preferred name wins — it's the name they'd be called at
 * the reception. Empty for photos uploaded with a party invitation token,
 * which identifies a household rather than a person.
 */
function authorName(
  person?: Pick<Persons, "first_name" | "preferred_name" | "last_name"> | null,
): string {
  if (!person) return "";
  const first = person.preferred_name ?? person.first_name ?? "";
  return [first, person.last_name ?? ""].filter(Boolean).join(" ").trim();
}

const slides = entries.map((e) => ({
  name: e.name,
  messageHtml: e.message ? parseMarkdown(e.message) : "",
  dateFormatted: shortDate(e.date_created),
  verified: e.verified,
}));

const items = memories.map((m) => ({
  id: m.id,
  title: m.title ?? null,
  description: m.description ?? null,
  image: m.image,
  sort: null,
  // Formatted here rather than in the grid: the same helper already dates the
  // guestbook slides, so both read the same way.
  date: shortDate(m.date_created),
  author: authorName(m.person),
}));
---

<Layout
  title={`Wedding Memories — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="memories"
>
  <div class="page-wide memories-page" id="memories">
    {
      /* The same header every other page uses. This page used to hand-roll
        its own, which is why it looked like a different site. */
    }
    <PageHeader
      groomName={groom}
      brideName={bride}
      eyebrow="Our wedding memories"
      date={`Photos & wishes from our guests · ${weddingDateLabel}`}
    />

    {
      hashtag && (
        <p class="memories-hashtag">
          Tag your photos with{" "}
          <Hashtag tag={hashtag} as="strong" class="memories-hashtag-tag" /> to
          be featured here.
        </p>
      )
    }

    <!-- ── Photo gallery ─────────────────────────────────────── -->
    {
      items.length > 0 ? (
        <section class="photos-section">
          <p class="section-eyebrow">
            <span>{items.length}</span>{" "}
            {items.length === 1 ? "Photo" : "Photos"}
          </p>
          <MemoryGrid items={items} />
        </section>
      ) : (
        <div class="empty-state">
          <span class="empty-icon" aria-hidden="true">
            📷
          </span>
          <p class="empty-title font-display">Photos coming soon</p>
          <p class="empty-body">
            Guest photos will appear here after the wedding. Be the first to
            share one below!
          </p>
        </div>
      )
    }

    <!-- ── Photo upload ───────────────────────────────────────── -->
    <MemoryUpload />

    {
      slides.length > 0 && (
        <>
          <div class="section-divider" aria-hidden="true" />

          {/* ── Guestbook entries (Swiper card stack) ───────────── */}
          <section class="wishes-section">
            <p class="section-eyebrow">
              <span>{slides.length}</span>{" "}
              {slides.length === 1 ? "Wish" : "Wishes"}
            </p>
            <GuestbookSwiper slides={slides} />
          </section>
        </>
      )
    }
  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>

  <GalleryLightbox slot="overlay" />
</Layout>

<style>
  .memories-page {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Header ────────────────────────────────────────────── */
  /* The tag line belongs to the header, so it sits tight under the date
     instead of floating 60px below it: PageHeader carries margin-bottom 52px,
     and the line's own 8px sat on top of that. The header's trailing space
     moves onto this line, so the rhythm reads header → tag → content. */
  .memories-page :global(.header) {
    margin-bottom: 12px;
  }
  .memories-hashtag {
    font-family: var(--fb);
    font-size: 13.5px;
    font-weight: 300;
    /* 12px muted grey was too faint to read as part of the header. */
    color: color-mix(in srgb, var(--muted) 65%, var(--dark));
    margin: 0 0 28px;
    line-height: 1.5;
    text-align: center;
  }
  :global(.memories-hashtag-tag) {
    font-weight: 600;
    color: color-mix(in srgb, var(--cp) 75%, var(--dark));
  }

  /* ── Section eyebrow ───────────────────────────────────── */
  .section-eyebrow {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 20px;
    align-self: flex-start;
  }
  .section-eyebrow span {
    color: var(--dark);
  }

  /* ── Wishes section ────────────────────────────────────── */
  .wishes-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .wishes-section .section-eyebrow {
    align-self: center;
  }

  /* ── Section divider ───────────────────────────────────── */
  .section-divider {
    width: 100%;
    height: 1px;
    margin: 40px 0;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--cp) 30%, transparent) 30%,
      color-mix(in srgb, var(--cs) 20%, transparent) 70%,
      transparent
    );
  }

  /* ── Photos section ────────────────────────────────────── */
  .photos-section {
    width: 100%;
    margin-bottom: 12px;
  }

  /* ── Empty state ───────────────────────────────────────── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 48px 24px;
    text-align: center;
    max-width: 400px;
    margin: 0 auto;
  }
  .empty-icon {
    font-size: 40px;
    opacity: 0.4;
  }
  .empty-title {
    font-size: 22px;
    font-style: italic;
    font-weight: 300;
    color: var(--dark);
  }
  .empty-body {
    font-family: var(--fb);
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.6;
  }
</style>
