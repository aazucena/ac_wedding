---
export const prerender = true;
// apps/web/src/pages/events.astro — public wedding weekend events
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Hashtag from "~/components/Hashtag.astro";
import EventsCalendar from "../components/EventsCalendar.astro";
import EventsTimeline from "../components/EventsTimeline.astro";
import { getSettings, getEvents } from "../lib/directus";
import { eventRange } from "../lib/date";
import { formatDate, formatTime } from "../lib/utils/format";
import "../styles/events.css";

const [settings, events] = await Promise.all([getSettings(), getEvents()]);

const groom = settings.groom?.first_name ?? "Aldrin";
const bride = settings.bride?.first_name ?? "Christine";
const weddingDate = settings.wedding_date ?? "2026-09-26";
const weddingDateLabel = formatDate(weddingDate);

/** schedule-x payload format, and Directus-style time for formatTime(). */
const CAL_FMT = "yyyy-MM-dd HH:mm";
const TIME_FMT = "HH:mm:ss";

// Build synthetic timeline entries from ceremony / reception settings
type TimelineEvent = (typeof events)[number] & { icsKey?: string };

const settingsTimelineEvents: TimelineEvent[] = [];

if (settings.ceremony?.start_time) {
  // The ceremony has no end_time field — derive one from estimated_duration.
  const { end, hasEnd } = eventRange(
    weddingDate,
    settings.ceremony.start_time,
    null,
    settings.ceremony.estimated_duration,
  );
  settingsTimelineEvents.push({
    id: "__ceremony",
    status: "published",
    name: "Wedding Ceremony",
    date: weddingDate,
    start_time: settings.ceremony.start_time,
    end_time: hasEnd ? end.toFormat(TIME_FMT) : undefined,
    venue: settings.ceremony.venue ?? undefined,
    public: true,
    icsKey: "ceremony",
  });
}

if (settings.reception?.start_time) {
  settingsTimelineEvents.push({
    id: "__reception",
    status: "published",
    name: "Wedding Reception",
    date: weddingDate,
    start_time: settings.reception.start_time,
    end_time: settings.reception.end_time ?? undefined,
    venue: settings.reception.venue ?? undefined,
    public: true,
    icsKey: "reception",
  });
}

// Group events by date (for timeline view) — settings events first
const allTimelineEvents = [...settingsTimelineEvents, ...events];
const byDate = new Map<string, typeof allTimelineEvents>();
for (const ev of allTimelineEvents) {
  const d = ev.date ?? weddingDate;
  if (!byDate.has(d)) byDate.set(d, []);
  byDate.get(d)!.push(ev);
}

const groupedDates = [...byDate.keys()].sort().map((date) => ({
  date,
  label: formatDate(date, "EEEE, MMMM d"),
  isWeddingDay: date === weddingDate,
  events: (byDate.get(date) ?? []).sort((a, b) =>
    (a.start_time ?? "").localeCompare(b.start_time ?? ""),
  ),
}));

// ── Calendar events ──────────────────────────────────────────────────────────

/**
 * schedule-x payload for one event. When an event has no end time, end === start
 * — schedule-x then renders a single time rather than a fabricated range. The
 * `timeLabel` is formatted here so the client tooltip does no date math.
 */
function toCalendarEvent(opts: {
  id: string;
  title: string;
  date: string;
  start?: string | null;
  end?: string | null;
  durationMinutes?: number | null;
  location?: string | null;
}) {
  const r = eventRange(opts.date, opts.start, opts.end, opts.durationMinutes);
  const startLabel = formatTime(r.start.toFormat(TIME_FMT));
  return {
    id: opts.id,
    title: opts.title,
    start: r.start.toFormat(CAL_FMT),
    end: r.end.toFormat(CAL_FMT),
    timeLabel: r.hasEnd
      ? `${startLabel} – ${formatTime(r.end.toFormat(TIME_FMT))}`
      : startLabel,
    ...(opts.location ? { location: opts.location } : {}),
    calendarId: "wedding",
  };
}

const calendarEvents = events
  .filter((ev) => ev.date)
  .map((ev, i) =>
    toCalendarEvent({
      id: String(i + 1),
      title: ev.name,
      date: ev.date!,
      start: ev.start_time,
      end: ev.end_time,
      location: ev.venue?.name,
    }),
  );

// Prepend ceremony & reception from settings as fixed wedding-day events
const settingsEvents: typeof calendarEvents = [];

if (settings.ceremony?.start_time) {
  settingsEvents.push(
    toCalendarEvent({
      id: "ceremony",
      title: "Wedding Ceremony",
      date: weddingDate,
      start: settings.ceremony.start_time,
      durationMinutes: settings.ceremony.estimated_duration,
      location: settings.ceremony.venue?.name,
    }),
  );
}

if (settings.reception?.start_time) {
  settingsEvents.push(
    toCalendarEvent({
      id: "reception",
      title: "Wedding Reception",
      date: weddingDate,
      start: settings.reception.start_time,
      end: settings.reception.end_time,
      location: settings.reception.venue?.name,
    }),
  );
}

const allCalendarEvents = [...settingsEvents, ...calendarEvents];
---

<Layout
  title={`Events — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="events"
>
  <div class="page-wide events-page">
    <PageHeader
      groomName={groom}
      brideName={bride}
      eyebrow="Wedding Weekend"
      date={`${weddingDateLabel} · Lethbridge, Alberta`}
    />

    {
      events.length === 0 ? (
        <div
          class="card"
          style="max-width:480px; text-align:center; padding:56px 32px;"
        >
          <p style="font-family:var(--fd); font-size:20px; font-style:italic; color:var(--muted);">
            Event details coming soon.
          </p>
        </div>
      ) : (
        <>
          {/* View toggle */}
          <div class="view-toggle" role="group" aria-label="View mode">
            <button
              class="toggle-btn active"
              id="btn-calendar"
              aria-pressed="true"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <rect
                  x="1"
                  y="2"
                  width="12"
                  height="11"
                  rx="1.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  fill="none"
                />
                <line
                  x1="1"
                  y1="5.5"
                  x2="13"
                  y2="5.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <rect
                  x="3.5"
                  y="0.5"
                  width="1.5"
                  height="3"
                  rx="0.75"
                  fill="currentColor"
                />
                <rect
                  x="9"
                  y="0.5"
                  width="1.5"
                  height="3"
                  rx="0.75"
                  fill="currentColor"
                />
                <rect
                  x="3"
                  y="8"
                  width="2"
                  height="2"
                  rx="0.5"
                  fill="currentColor"
                />
                <rect
                  x="6.5"
                  y="8"
                  width="2"
                  height="2"
                  rx="0.5"
                  fill="currentColor"
                />
                <rect
                  x="10"
                  y="8"
                  width="1"
                  height="2"
                  rx="0.5"
                  fill="currentColor"
                />
              </svg>
              Calendar
            </button>
            <button class="toggle-btn" id="btn-timeline" aria-pressed="false">
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <rect
                  x="0"
                  y="1"
                  width="4"
                  height="4"
                  rx="1"
                  fill="currentColor"
                />
                <rect
                  x="6"
                  y="1"
                  width="8"
                  height="1.5"
                  rx="0.75"
                  fill="currentColor"
                />
                <rect
                  x="6"
                  y="3.5"
                  width="5"
                  height="1.5"
                  rx="0.75"
                  fill="currentColor"
                />
                <rect
                  x="0"
                  y="7"
                  width="4"
                  height="4"
                  rx="1"
                  fill="currentColor"
                />
                <rect
                  x="6"
                  y="7"
                  width="8"
                  height="1.5"
                  rx="0.75"
                  fill="currentColor"
                />
                <rect
                  x="6"
                  y="9.5"
                  width="5"
                  height="1.5"
                  rx="0.75"
                  fill="currentColor"
                />
              </svg>
              Timeline
            </button>
          </div>

          {/* Calendar view — visible by default so skeleton shows immediately */}
          <div id="view-calendar">
            <EventsCalendar
              events={allCalendarEvents}
              weddingDate={weddingDate}
            />
          </div>
          {/* Timeline view — hidden until toggled */}
          <div id="view-timeline" class="hidden">
            <EventsTimeline groupedDates={groupedDates} />
          </div>
        </>
      )
    }
  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>
</Layout>

<script>
  import "../scripts/events-view";
</script>
