---
// apps/web/src/pages/maintenance.astro
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import Insignia from '~/assets/insignia.png';
import { getContactDetails, getMaintenanceStatus } from '~/lib/directus';
import { MAINTENANCE_MODE } from 'astro:env/server';

const active = MAINTENANCE_MODE || await getMaintenanceStatus();
if (!active) {
  // @ts-ignore -- variable IS read in return expression; Astro TS checker false-positive
  const r = Astro.request.headers.get('referer') ?? '';
  return Astro.redirect(r && !new URL(r, Astro.url).pathname.startsWith('/maintenance') ? r : '/', 307);
}

const { email, phone } = await getContactDetails();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Back Soon — Aldrin & Christine</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
</head>
<body>
  <div class="grain" aria-hidden="true"></div>

  <div class="page">
    <div class="card">
      <img src={Insignia.src} alt="" class="insignia" />
      <span class="ornament" aria-hidden="true">✦</span>
      <p class="eyebrow">September 26, 2026</p>
      <h1 class="headline">Back Soon</h1>
      <p class="message">
        We're putting the finishing touches on our little corner of the internet.
        Check back shortly — we can't wait to celebrate with you.
      </p>
      <p class="names">Aldrin &amp; Christine</p>
      {(email || phone) && (
        <p class="contact">
          {email && <a href={`mailto:${email}`}>{email}</a>}
          {email && phone && <span aria-hidden="true">·</span>}
          {phone && <a href={`tel:${phone}`}>{phone}</a>}
        </p>
      )}
    </div>
  </div>
</body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cp: #A8D4B8;
    --cs: #C5B8E0;
    --dark: #1a1a2e;
    --ivory: #fdfaf7;
    --warm: #f4f0ec;
    --muted: #8a8499;
    --border: rgba(196, 186, 220, 0.45);
    --fd: 'Cormorant Garamond', Georgia, serif;
    --fb: 'Jost', Arial, sans-serif;
    --shadow-card: 0 8px 48px rgba(26,26,46,0.08), 0 2px 12px rgba(26,26,46,0.04);
    --radius: 24px;
  }

  html { height: 100%; }

  body {
    font-family: var(--fb);
    background: var(--warm);
    color: var(--dark);
    min-height: 100dvh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .grain {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.18;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.08'/%3E%3C/svg%3E");
  }

  .page {
    position: relative; z-index: 1;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
  }

  .card {
    background: var(--ivory);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    padding: 64px 48px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 480px;
    width: 100%;
    position: relative;
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s ease forwards;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cp), var(--cs));
  }

  .insignia {
    width: 400px;
    height: 400px;
    object-fit: contain;
    opacity: 0.75;
    margin-bottom: -4rem; margin-top: -6rem;
  }

  .ornament {
    font-size: 28px;
    color: color-mix(in srgb, var(--cs) 60%, transparent);
    animation: spin 18s linear infinite;
    display: inline-block;
    line-height: 1;
  }

  .eyebrow {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .headline {
    font-family: var(--fd);
    font-size: 52px;
    font-weight: 300;
    font-style: italic;
    color: var(--dark);
    line-height: 1.1;
    margin: 0;
  }

  .message {
    font-family: var(--fb);
    font-size: 14px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.9;
    max-width: 340px;
  }

  .names {
    font-family: var(--fd);
    font-size: 18px;
    font-weight: 400;
    font-style: italic;
    color: color-mix(in srgb, var(--dark) 55%, var(--cs));
    margin-top: 4px;
  }

  .contact {
    font-family: var(--fb);
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .contact a {
    color: var(--muted);
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--dark);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 480px) {
    .card { padding: 48px 28px; }
    .headline { font-size: 40px; }
  }
</style>
