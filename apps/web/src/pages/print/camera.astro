---
export const prerender = true;
// apps/web/src/pages/print/camera.astro
// Roll Call table cards, in four formats. The artwork is identical across all
// of them (components/print/RollCallTent.astro); only the sheet changes.
//
//   tent  4 × 6 in  folded to a 4 × 3 tent — the default, one per table
//   4up   Letter    four 4 × 5 tents to cut apart (15 tables → 4 sheets)
//   flat  4 × 6 in  single-sided, for venues with acrylic stands
//   sign  5 × 7 in  one big QR for the entrance or a photo corner
//
// Four 4 × 6 cards would need 8 × 12 in, so the 4-up sheet uses 4 × 5 cards —
// 8 × 10 in of card on a Letter sheet, with room for the cut guides.

import { getSettings } from "@lib/directus";
import { formatDate } from "@lib/utils/format";
import { SHOT_LIMIT } from "@lib/constants/camera";
import PrintLayout from "@layouts/PrintLayout.astro";
import RollCallTent from "@components/print/RollCallTent.astro";
import { DateTime } from "luxon";
import "../../styles/camera-card.css";

const settings = await getSettings();
const weddingDate = settings.wedding_date ?? "2026-09-26";
const weddingDateLabel = formatDate(weddingDate);

const BASE_URL = import.meta.env.SITE ?? "https://wedding.aazucena.com";
const cameraUrl = `${BASE_URL}/camera`;
const shortUrl = cameraUrl.replace(/^https?:\/\//, "");

const developsOn = DateTime.fromISO(weddingDate)
  .plus({ days: 1 })
  .toFormat("LLLL d");

const PAPERS = [
  { id: "tent", label: "Tent 4×6" },
  { id: "4up", label: "4-up Letter" },
  { id: "flat", label: "Flat 4×6" },
  { id: "sign", label: "Sign 5×7" },
] as const;

const card = {
  shots: SHOT_LIMIT,
  cameraUrl,
  shortUrl,
  developsOn,
  weddingDateLabel,
  hashtag: settings.hashtag,
};
---

<PrintLayout
  title="Roll Call Cards — Print"
  cardWidth="4in"
  cardHeight="6in"
  toolbarHint="Pick a format. Tent folds to 4 × 3 in; 4-up puts four smaller tents on one Letter sheet to cut apart; flat suits acrylic stands; sign is for the entrance."
>
  <div class="toolbar-controls" slot="toolbar-controls">
    <div class="seg-control">
      {
        PAPERS.map((p, i) => (
          <button
            type="button"
            class:list={["seg-btn", i === 0 && "active"]}
            data-paper-btn={p.id}
          >
            {p.label}
          </button>
        ))
      }
    </div>
  </div>

  {
    /* Only the pane matching data-paper shows, on screen and in print, so
      printing emits exactly the format selected. */
  }
  <div class="paper-pane is-active" data-pane="tent">
    <RollCallTent variant="tent" {...card} />
  </div>

  <div class="paper-pane" data-pane="4up">
    <div class="sheet-4up">
      {
        Array.from({ length: 4 }).map(() => (
          <RollCallTent variant="tent" compact {...card} />
        ))
      }
    </div>
  </div>

  <div class="paper-pane" data-pane="flat">
    <RollCallTent variant="flat" {...card} />
  </div>

  <div class="paper-pane" data-pane="sign">
    <RollCallTent variant="sign" {...card} />
  </div>
</PrintLayout>

<script is:inline src="/scripts/camera-preview.js"></script>
