---
export const prerender = true;
// apps/web/src/pages/print/menu.astro
// Menu Card — portrait, double-sided; stock is switchable (5×7 / A5 / 4×9)
// Front: the menu.  Back: the embellished A&C crest.
// Prime Catering · Classic Buffet

import { getSettings } from "@lib/directus";
import { formatDate } from "@lib/utils/format";
import PrintLayout from "@layouts/PrintLayout.astro";
import Hashtag from "@components/Hashtag.astro";
import CardWatermark from "@components/CardWatermark.astro";
import AccentMark from "@assets/accent_mark.png";
import Insignia from "@assets/insignia.png";
import { Image } from "astro:assets";
import "../../styles/menu-card.css";

const settings = await getSettings();

const groomFirst = settings.groom?.first_name ?? "Aldrin";
const brideFirst = settings.bride?.first_name ?? "Christine";

const weddingDate = formatDate(
  settings.wedding_date ?? "2026-09-26",
  "cccc, MMMM d, yyyy",
);

// Each course carries its own label, so adding or reordering one is a data
// edit. A null label marks an uncategorised opener/closer flourish.
const menu = [
  { label: null, items: [{ name: "Artisan Bread & Butter" }] },
  {
    label: "Gourmet Salads",
    items: [
      { name: "Italian Table" },
      { name: "Caesar" },
      { name: "Greek Pasta" },
      { name: "Macaroni" },
    ],
  },
  {
    label: "Main Entrées",
    items: [
      { name: "Roast Beef", note: "With demi glaze" },
      {
        name: "Chicken with Lemon Pan Sauce",
        note: "Lemon, cream, rice flour",
      },
    ],
  },
  {
    label: "Sides",
    items: [
      { name: "Pickled Vegetable Tray" },
      { name: "Roasted Vegetables" },
      { name: "Jasmine Rice" },
      { name: "Mashed Potato" },
    ],
  },
  {
    label: "Sweets & Finish",
    items: [
      { name: "Seasonal Fresh Fruit" },
      { name: "Cheesecake" },
      { name: "Assorted Squares" },
    ],
  },
  { label: null, items: [{ name: "Coffee & Tea" }] },
];
---

<PrintLayout
  title="Menu Card — Print"
  cardWidth="5in"
  cardHeight="7in"
  toolbarHint="Portrait · Double-sided · choose card stock below"
>
  <div class="toolbar-controls" slot="toolbar-controls">
    <div class="seg-control">
      <button class="seg-btn active" data-size-btn="5x7">5 × 7 in</button>
      <button class="seg-btn" data-size-btn="a5">A5</button>
      <button class="seg-btn" data-size-btn="4x9">4 × 9 in</button>
    </div>
    <div class="seg-control">
      <button class="seg-btn active" id="btnFront" onclick="showFace('front')"
        >Front</button
      >
      <button class="seg-btn" id="btnBack" onclick="showFace('back')"
        >Back</button
      >
    </div>
  </div>

  <!-- ── Flip container ── -->
  <div class="flip-container" id="flipContainer" onclick="toggleFlip()">
    <div class="flipper" id="flipper">
      <!-- ████ FRONT ████ -->
      <div class="face front">
        <div class="card" style="position:relative;">
          <div class="accent-bar"></div>

          <CardWatermark opacity={0.035} size={160} />

          <!-- Header -->
          <div class="card-header">
            <Image src={AccentMark} class="header-accent" alt="" />
            <div class="header-eyebrow">Dinner Menu</div>
            <div class="header-title">Ce soir</div>
            <div class="header-names">
              {groomFirst}
              <span class="header-amp">&amp;</span>
              {brideFirst}
            </div>
            <div class="header-date">{weddingDate}</div>
          </div>

          <!-- Menu -->
          <div class="menu-body">
            {
              menu.map((section) => (
                <div
                  class:list={[
                    "menu-section",
                    !section.label && "menu-flourish",
                  ]}
                >
                  {section.label && (
                    <div class="section-label">{section.label}</div>
                  )}
                  {section.items.map((m) => (
                    <div class="menu-item">
                      <span class="item-name">{m.name}</span>
                      {m.note && <span class="item-note">{m.note}</span>}
                    </div>
                  ))}
                </div>
              ))
            }
          </div>

          <div class="accent-bar-bottom"></div>
        </div>
      </div>

      <!-- ████ BACK ████ -->
      <div class="face back">
        <div class="card">
          <div class="accent-bar"></div>

          <div class="back-body">
            <Image src={Insignia} class="back-crest" alt="" />
            <Hashtag tag={settings.hashtag} class="back-hashtag" />
          </div>

          <div class="accent-bar-bottom"></div>
        </div>
      </div>
    </div>
  </div>
</PrintLayout>

<script is:inline src="/scripts/enclosure-preview.js"></script>
<script is:inline src="/scripts/menu-preview.js"></script>
