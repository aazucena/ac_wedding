---
export const prerender = true;
// apps/web/src/pages/print/thank-you.astro
// Thank You Card — single-sided 5×7 vertical card, three selectable styles.
//
// The printer available can only print one side, so each style puts the whole
// message — "Thank You", the salutation, both paragraphs, the closing and both
// names — on a single face. No photo.
//
// Only the active .variant-pane is displayed, on screen and in print, so
// printing emits exactly the style currently selected.

import { getSettings } from "@lib/directus";
import { formatDate } from "@lib/utils/format";
import PrintLayout from "@layouts/PrintLayout.astro";
import ThankYouCard from "@components/print/ThankYouCard.astro";
import "~/styles/thank-you.css";

const settings = await getSettings();

// Familiar names, not legal first names — matches place-cards/escort-cards
// and keeps the monogram as "A&C" (cf. the #AlTine2026 hashtag).
const groomFirst =
  settings.groom?.preferred_name ?? settings.groom?.first_name ?? "Aldrin";
const brideFirst =
  settings.bride?.preferred_name ?? settings.bride?.first_name ?? "Christine";

const weddingDate = formatDate(settings.wedding_date ?? "2026-09-26");

const VARIANTS = [
  { id: "a", label: "Letter" },
  { id: "b", label: "Framed" },
  { id: "c", label: "Monogram" },
] as const;

const PAPERS = [
  { id: "5x7", label: "5×7 in" },
  { id: "letter", label: "Letter" },
  { id: "a4", label: "A4" },
  { id: "2up", label: "2-up" },
] as const;
---

<PrintLayout
  title="Thank You Card — Print"
  cardWidth="5in"
  cardHeight="7in"
  toolbarHint="5 × 7 in · Portrait · Single-sided · Pick a style, then a paper size. 2-up puts two cards on one landscape Letter sheet to cut apart."
>
  <div class="toolbar-controls" slot="toolbar-controls">
    <div class="seg-control">
      {
        VARIANTS.map((v, i) => (
          <button
            type="button"
            class:list={["seg-btn", i === 0 && "active"]}
            data-variant-btn={v.id}
          >
            {v.label}
          </button>
        ))
      }
    </div>
    <div class="seg-control">
      {
        PAPERS.map((p, i) => (
          <button
            type="button"
            class:list={["seg-btn", i === 0 && "active"]}
            data-paper-btn={p.id}
          >
            {p.label}
          </button>
        ))
      }
    </div>
  </div>

  {
    VARIANTS.map((v, i) => (
      <div
        class:list={["variant-pane", i === 0 && "is-active"]}
        data-pane={v.id}
      >
        <div class="sheet">
          <ThankYouCard
            variant={v.id}
            groomFirst={groomFirst}
            brideFirst={brideFirst}
            weddingDate={weddingDate}
            hashtag={settings.hashtag}
          />
          <ThankYouCard
            variant={v.id}
            class="card-dupe"
            groomFirst={groomFirst}
            brideFirst={brideFirst}
            weddingDate={weddingDate}
            hashtag={settings.hashtag}
          />
        </div>
      </div>
    ))
  }
</PrintLayout>

<script is:inline src="/scripts/thank-you-preview.js"></script>
