---
export const prerender = true;
// apps/web/src/pages/print/rsvp.astro
// RSVP Card — 6×4 horizontal, double-sided flip card
// Front: name, attending, meal preference per guest, dietary, song request
// Back:  QR code linking to RSVP website

import { getSettings } from '@lib/directus';
import { formatDate } from '@lib/utils/format';
import PrintLayout      from '@layouts/PrintLayout.astro';
import Hashtag          from '@components/Hashtag.astro';
import QRCodeWidget     from '@components/QRCode.astro';
import AccentMark       from '@assets/accent_mark.png';
import Insignia         from '@assets/insignia.png';
import Favicon          from '@assets/favicon.svg';
import { Image } from 'astro:assets';
import '../../styles/print-rsvp.css';

const settings = await getSettings();

const groomFirst = settings.groom?.first_name ?? 'Aldrin';
const brideFirst = settings.bride?.first_name ?? 'Christine';

const rsvpDeadline = formatDate(settings.rsvp_deadline ?? '2026-06-01');

const BASE_URL = import.meta.env.SITE?.replace(/\/$/, '') ?? '';
const websiteUrl = BASE_URL || 'yourweddingsite.com';

const weddingDate = formatDate(settings.wedding_date ?? '2026-09-26');
---

<PrintLayout
  title="RSVP Card — Print"
  cardWidth="6in" cardHeight="4in"
  toolbarHint="6 × 4 in · Landscape · Double-sided"
>

  <div class="toolbar-controls" slot="toolbar-controls">
    <div class="seg-control">
      <button class="seg-btn active" id="btnFront" onclick="showFace('front')">Front</button>
      <button class="seg-btn"        id="btnBack"  onclick="showFace('back')">Back</button>
    </div>
  </div>

  <div class="flip-container" id="flipContainer" onclick="toggleFlip()">
    <div class="flipper" id="flipper">

      <!-- ████ FRONT ████ -->
      <div class="face front">
        <div class="card">
          <div class="accent-bar"></div>

          <div class="card-body">

            <!-- ── Left: header ── -->
            <div class="header-col">
              <Image src={AccentMark} class="header-accent" alt="" />
              <div class="header-eyebrow">Kindly Reply</div>
              <div class="header-script">RSVP</div>
              <div class="header-rule">
                <div class="header-rule-line"></div>
                <span class="header-rule-gem">✦</span>
                <div class="header-rule-line"></div>
              </div>
              <div class="header-names">
                {groomFirst} <span class="header-amp">&amp;</span><br/>{brideFirst}
              </div>
              <div class="header-date">{weddingDate}</div>
            </div>

            <!-- ── Right: fields ── -->
            <div class="fields-col">

              <!-- M__ name line -->
              <div class="m-block">
                <div class="m-line-row">
                  <span class="m-prefix">M</span>
                  <div class="write-line"></div>
                </div>
                <span class="m-hint">your full name</span>
              </div>

              <!-- Attendance checkboxes -->
              <div class="attend-options">
                <div class="check-opt">
                  <div class="check-box"></div>
                  <span class="check-label">Joyfully Accepts</span>
                </div>
                <div class="check-opt">
                  <div class="check-box"></div>
                  <span class="check-label">Regretfully Declines</span>
                </div>
              </div>

              <div class="field-divider"></div>

              <!-- Seats reserved paragraph -->
              <p class="seats-para">
                <span class="seats-blank-inline"></span> seat(s) reserved in your honor.
                We hope and pray you can join us as we celebrate this joyful blessing with God and family.
              </p>

              <div class="field-divider"></div>

              <!-- Dietary restrictions -->
              <div class="field-block">
                <div class="field-block-header">
                  <span class="field-label">Dietary Preferences</span>
                  <span class="field-hint">e.g. allergies, vegetarian, seafood</span>
                </div>
                <div class="write-line"></div>
                <div class="write-line"></div>
              </div>

              <!-- Song request -->
              <div class="field-block">
                <div class="field-block-header">
                  <span class="field-label">Song Request</span>
                  <span class="field-hint">what song gets you on the dance floor?</span>
                </div>
                <div class="write-line"></div>
                <div class="write-line"></div>
              </div>

              <div class="footer">
                <span class="footer-deadline">Reply by <strong>{rsvpDeadline}</strong></span>
                <span class="footer-online-hint">or RSVP online · see reverse</span>
              </div>
            </div>
          </div>

          <div class="accent-bar-bottom"></div>
        </div>
      </div><!-- /face.front -->

      <!-- ████ BACK ████ -->
      <div class="face back">
        <div class="back-card" style="position:relative;">
          <div class="accent-bar"></div>

          <div class="qr-wrapper">
            <section class="rsvp-section">
              <p class="rsvp-heading">Kindly RSVP</p>
              <div class="qr-embellish">
                <Image src={Insignia} width={240} height={240} alt="" class="qr-bg-insignia" />
                <span class="qr-corner qr-corner--tl"><Image src={AccentMark} width={18} height={18} alt="" /></span>
                <span class="qr-corner qr-corner--tr"><Image src={AccentMark} width={18} height={18} alt="" /></span>
                <span class="qr-corner qr-corner--bl"><Image src={AccentMark} width={18} height={18} alt="" /></span>
                <span class="qr-corner qr-corner--br"><Image src={AccentMark} width={18} height={18} alt="" /></span>
                <QRCodeWidget url={(BASE_URL || 'https://yourweddingsite.com')+'/invite'} size={120} logo={Favicon.src} />
              </div>
              <p class="rsvp-url">{websiteUrl}</p>
              <Hashtag tag={settings.hashtag} class="rsvp-hashtag" />
            </section>
          </div>

          <div class="accent-bar-bottom"></div>
        </div>
      </div><!-- /face.back -->

    </div><!-- /flipper -->
  </div><!-- /flip-container -->

</PrintLayout>

<script is:inline src="/scripts/rsvp-preview.js"></script>
