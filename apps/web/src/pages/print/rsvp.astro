---
export const prerender = true;
// apps/web/src/pages/print/rsvp.astro
// RSVP Card — 6×4 horizontal, single-sided

import { getSettings } from "@lib/directus";
import { formatDate, formatPhone } from "@lib/utils/format";
import PrintLayout from "@layouts/PrintLayout.astro";
import Hashtag from "@components/Hashtag.astro";
import QRCodeWidget from "@components/QRCode.astro";
import AccentMark from "@assets/accent_mark.png";
import Insignia from "@assets/insignia.png";
import Favicon from "@assets/favicon.svg";
import { Image } from "astro:assets";
import "../../styles/print-rsvp.css";

const settings = await getSettings();

const groomFirst = settings.groom?.first_name ?? "Aldrin";
const brideFirst = settings.bride?.first_name ?? "Christine";

const rsvpDeadline = formatDate(settings.rsvp_deadline ?? "2026-06-01");

const BASE_URL = import.meta.env.SITE?.replace(/\/$/, "") ?? "";
const websiteUrl = BASE_URL || "yourweddingsite.com";

const weddingDate = formatDate(settings.wedding_date ?? "2026-09-26");
const contactPhone = settings.phone ? formatPhone(settings.phone) : null;
---

<PrintLayout
  title="RSVP Card — Print"
  cardWidth="6in"
  cardHeight="4in"
  toolbarHint="6 × 4 in · Landscape · Single-sided"
>
  <div class="toolbar-controls" slot="toolbar-controls">
    <div class="seg-control">
      <button class="seg-btn active" id="btnFront" onclick="showFace('front')"
        >Front</button
      >
      <button class="seg-btn" id="btnBack" onclick="showFace('back')"
        >Back</button
      >
    </div>
  </div>

  <div class="flip-container" id="flipContainer" onclick="toggleFlip()">
    <div class="flipper" id="flipper">
      <div class="face front">
        <div class="card">
          <div class="accent-bar"></div>

          <div class="card-body">
            <!-- ── Left: header ── -->
            <div class="header-col">
              <Image src={AccentMark} class="header-accent" alt="" />
              <div class="header-eyebrow">Kindly Reply</div>
              <div class="header-script">RSVP</div>
              <div class="header-rule">
                <div class="header-rule-line"></div>
                <span class="header-rule-gem">✦</span>
                <div class="header-rule-line"></div>
              </div>
              <div class="header-names">
                {groomFirst}
                <span class="header-amp">&amp;</span><br />{brideFirst}
              </div>
              <div class="header-date">{weddingDate}</div>
            </div>

            <!-- ── Right: copy + QR ── -->
            <div class="fields-col">
              <p class="seats-para">
                We have <span class="seats-blank-inline"></span> seat(s) reserved
                in your honour.
              </p>
              <p class="rsvp-request">
                The pleasure of your response is requested by <strong
                  >{rsvpDeadline}</strong
                >.
              </p>
              <p class="rsvp-instruction">
                Please scan the QR code below{
                  contactPhone && (
                    <>
                      , or call <em class="fw-bold">{contactPhone}</em>,
                    </>
                  )
                } to RSVP.
              </p>

              <div class="qr-embellish">
                <Image
                  src={Insignia}
                  width={200}
                  height={200}
                  alt=""
                  class="qr-bg-insignia"
                />
                <span class="qr-corner qr-corner--tl"
                  ><Image
                    src={AccentMark}
                    width={16}
                    height={16}
                    alt=""
                  /></span
                >
                <span class="qr-corner qr-corner--tr"
                  ><Image
                    src={AccentMark}
                    width={16}
                    height={16}
                    alt=""
                  /></span
                >
                <span class="qr-corner qr-corner--bl"
                  ><Image
                    src={AccentMark}
                    width={16}
                    height={16}
                    alt=""
                  /></span
                >
                <span class="qr-corner qr-corner--br"
                  ><Image
                    src={AccentMark}
                    width={16}
                    height={16}
                    alt=""
                  /></span
                >
                <QRCodeWidget
                  url={(BASE_URL || "https://yourweddingsite.com") + "/invite"}
                  size={120}
                  logo={Favicon.src}
                  logoRatio={0.8}
                />
              </div>

              <div class="rsvp-footer">
                <p class="rsvp-url-pill">{websiteUrl}/invite</p>
                <Hashtag tag={settings.hashtag} class="rsvp-hashtag" />
              </div>
            </div>
          </div>

          <div class="accent-bar-bottom"></div>
        </div>
      </div>

      <!-- ████ BACK (print only) ████ -->
      <div class="face back">
        <div class="back-card">
          <div class="accent-bar"></div>
          <div class="back-body">
            <Image src={Insignia} class="back-insignia" alt="" />
          </div>
          <div class="accent-bar-bottom"></div>
        </div>
      </div>
    </div>
  </div>
</PrintLayout>

<script is:inline src="/scripts/rsvp-preview.js"></script>
