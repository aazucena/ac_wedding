---
export const prerender = true;
// apps/web/src/pages/partners.astro — partner showcase / shoutout
import { Icon } from 'astro-icon/components';
import Layout     from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Hashtag    from '~/components/Hashtag.astro';
import { getSettings, getVendors } from '../lib/directus';
import { formatDate, toTelHref } from '../lib/utils/format';
import { DIRECTUS_URL } from 'astro:env/server';

const [settings, vendors] = await Promise.all([getSettings(), getVendors()]);

const groom            = settings.groom?.first_name ?? 'Aldrin';
const bride            = settings.bride?.first_name ?? 'Christine';
const weddingDateLabel = formatDate(settings.wedding_date ?? '2026-09-26');

function categoryLabel(cat: string): string {
  return cat
    .split(/[_\s]+/)
    .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
    .join(' ');
}

function contactName(p: { first_name?: string; last_name?: string; preferred_name?: string | null }): string {
  return `${p.preferred_name ?? p.first_name ?? ''} ${p.last_name ?? ''}`.trim();
}

function imgUrl(id: string): string {
  return `${DIRECTUS_URL}/assets/${id}?fit=cover&quality=82`;
}

const SOCIAL_ICONS: Record<string, string> = {
  instagram:  'simple-icons:instagram',
  facebook:   'simple-icons:facebook',
  tiktok:     'simple-icons:tiktok',
  youtube:    'simple-icons:youtube',
  x:          'simple-icons:x',
  twitter:    'simple-icons:x',
  pinterest:  'simple-icons:pinterest',
  linkedin:   'simple-icons:linkedin',
  threads:    'simple-icons:threads',
  snapchat:   'simple-icons:snapchat',
};

function socialIcon(platform: string): string {
  return SOCIAL_ICONS[platform.toLowerCase()] ?? 'simple-icons:link';
}

import type { Vendors } from '../lib/types';

function isIndividual(v: Vendors): boolean {
  const contacts = v.contacts ?? [];
  if (contacts.length !== 1) return false;
  const cName = contactName(contacts[0]!).toLowerCase().trim();
  const vName = v.name.toLowerCase().trim();
  return cName === vName || vName.includes(cName) || cName.includes(vName);
}

function socialLabel(platform: string): string {
  const key = platform.toLowerCase();
  if (key === 'x' || key === 'twitter') return 'X / Twitter';
  return platform.charAt(0).toUpperCase() + platform.slice(1);
}
---

<Layout
  title={`Our Partners — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="partners"
>

  <div class="page-wide vendors-page">

    <PageHeader
      groomName={groom}
      brideName={bride}
      eyebrow="With gratitude"
      date={`${weddingDateLabel} · Lethbridge, Alberta`}
    />

    <p class="vendors-intro">
      Our wedding wouldn't be what it is without the care and dedication of everyone behind it.
      Thank you to everyone who made this day beautiful.
    </p>

    {vendors.length === 0 ? (
      <p class="vendors-empty">Partner details coming soon.</p>
    ) : (
      <div class="vendors-grid">
        {vendors.map((v, i) => (
          <>
            {/* ── Card ── */}
            <button
              class="vendor-card"
              style={`animation-delay: ${0.1 + i * 0.04}s`}
              onclick={`document.getElementById('vd-${v.id}').showModal()`}
              aria-haspopup="dialog"
            >
              {v.image?.id ? (
                <div class="vendor-photo">
                  <img
                    src={imgUrl(v.image.id)}
                    alt={v.name}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="vendor-photo vendor-photo--placeholder">
                  <span class="vendor-photo-initial">{v.name.split('')[0]}</span>
                </div>
              )}

              <div class="vendor-body">
                {v.category && (
                  <span class="vendor-category">{categoryLabel(v.category)}</span>
                )}
                <p class="vendor-name">{v.name}</p>
                {v.subtitle && <p class="vendor-subtitle">{v.subtitle}</p>}
                {v.city && <p class="vendor-location">{v.city}</p>}
                <span class="vendor-cta">View details</span>
              </div>
            </button>

            {/* ── Modal ── */}
            <dialog id={`vd-${v.id}`} class="vendor-modal">
              <button class="modal-close" aria-label="Close" onclick="this.closest('dialog').close()">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <line x1="1" y1="1" x2="11" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="11" y1="1" x2="1" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>

              {/* Photo */}
              {v.image?.id ? (
                <div class="modal-photo">
                  <img
                    src={imgUrl(v.image.id)}
                    alt={v.name}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ) : (
                <div class="modal-photo modal-photo--placeholder">
                  <span class="modal-photo-initial">{v.name.split('')[0]}</span>
                </div>
              )}

              <div class="modal-body">
                {/* Header */}
                <div class="modal-header">
                  {v.category && (
                    <span class="vendor-category">{categoryLabel(v.category)}</span>
                  )}
                  <h2 class="modal-name">{v.name}</h2>
                  {v.subtitle && <p class="modal-subtitle">{v.subtitle}</p>}
                  {v.city && <p class="modal-location">{v.city}</p>}
                </div>

                {/* Contact — for individuals, fall back to contacts[0] if vendor fields are empty */}
                {(() => {
                  const solo = isIndividual(v);
                  const email = v.email ?? (solo ? v.contacts?.[0]?.email : undefined);
                  const phone = v.phone ?? (solo ? v.contacts?.[0]?.phone : undefined);
                  return (email || phone) ? (
                    <div class="modal-section">
                      <p class="modal-section-label">Contact</p>
                      {email && (
                        <a href={`mailto:${email}`} class="modal-contact-link">
                          <Icon name="simple-icons:minutemailer" size={13} class="modal-icon" />
                          {email}
                        </a>
                      )}
                      {phone && (
                        <a href={toTelHref(phone)} class="modal-contact-link">
                          <Icon name="simple-icons:whatsapp" size={13} class="modal-icon" />
                          {phone}
                        </a>
                      )}
                    </div>
                  ) : null;
                })()}

                {/* Team — hidden for individual vendors */}
                {!isIndividual(v) && (v.contacts ?? []).length > 0 && (
                  <div class="modal-section">
                    <p class="modal-section-label">Team</p>
                    {(v.contacts ?? []).map(c => (
                      <div class="modal-person">
                        <p class="modal-person-name">{contactName(c)}</p>
                        {c.email && (
                          <a href={`mailto:${c.email}`} class="modal-contact-link">
                            <Icon name="simple-icons:minutemailer" size={13} class="modal-icon" />
                            {c.email}
                          </a>
                        )}
                        {c.phone && (
                          <a href={toTelHref(c.phone)} class="modal-contact-link">
                            <Icon name="simple-icons:whatsapp" size={13} class="modal-icon" />
                            {c.phone}
                          </a>
                        )}
                      </div>
                    ))}
                  </div>
                )}

                {/* Social media */}
                {(v.social_media ?? []).length > 0 && (
                  <div class="modal-section">
                    <p class="modal-section-label">Social Media</p>
                    <div class="modal-socials">
                      {(v.social_media ?? []).map(s => (
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="modal-social-link"
                          aria-label={socialLabel(s.platform)}
                        >
                          <Icon name={socialIcon(s.platform)} size={16} class="social-icon" />
                          <span>{socialLabel(s.platform)}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {/* Links */}
                {(v.website || v.maps_url) && (
                  <div class="modal-section modal-links">
                    {v.website && (
                      <a
                        href={v.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="modal-link-btn modal-link-btn--primary"
                      >
                        Visit website ↗
                      </a>
                    )}
                    {v.maps_url && (
                      <a
                        href={v.maps_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="modal-link-btn"
                      >
                        View on map →
                      </a>
                    )}
                  </div>
                )}
              </div>
            </dialog>
          </>
        ))}
      </div>
    )}

  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>

</Layout>

<script>
  // Close dialog when clicking the backdrop
  document.querySelectorAll<HTMLDialogElement>('.vendor-modal').forEach(dialog => {
    dialog.addEventListener('click', e => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>

<style>
.vendors-page {
  display: flex; flex-direction: column; align-items: center;
}

.vendors-intro {
  font-family: var(--fd); font-size: 20px; font-weight: 300; font-style: italic;
  color: var(--muted); text-align: center; line-height: 1.7;
  max-width: 520px; margin: -24px auto 52px;
  opacity: 0; animation: fadeUp 0.8s 0.25s ease forwards;
}

.vendors-empty {
  font-family: var(--fd); font-size: 20px; font-style: italic; color: var(--muted);
  text-align: center;
}

.vendors-grid {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 20px; width: 100%;
}

/* ── Card ──────────────────────────────────────────────── */
.vendor-card {
  width: 240px;
  background: var(--ivory);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  display: flex; flex-direction: column;
  position: relative; text-align: center;
  opacity: 0; animation: fadeUp 0.6s ease forwards;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
  /* Reset button styles */
  padding: 0; font: inherit; color: inherit;
}
.vendor-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
}

/* ── Photo ─────────────────────────────────────────────── */
.vendor-photo {
  width: 100%; height: 160px;
  overflow: hidden; flex-shrink: 0;
  background: color-mix(in srgb, var(--cp) 12%, var(--warm));
}
.vendor-photo img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
  transition: transform 0.4s ease;
}
.vendor-card:hover .vendor-photo img { transform: scale(1.04); }

.vendor-photo--placeholder {
  display: flex; align-items: center; justify-content: center;
}
.vendor-photo-initial {
  font-family: var(--fd); font-size: 56px; font-weight: 300; font-style: italic;
  color: color-mix(in srgb, var(--cs) 60%, var(--dark));
  opacity: 0.5;
}

/* ── Card Body ─────────────────────────────────────────── */
.vendor-body {
  padding: 16px 18px 18px;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  flex: 1; position: relative;
}
.vendor-body::before {
  content: '';
  position: absolute; top: 0; left: 18px; right: 18px; height: 1px;
  background: linear-gradient(90deg, var(--cp), var(--cs));
  opacity: 0.4;
}

.vendor-category {
  display: inline-block;
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 3px; text-transform: uppercase; color: var(--dark);
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--cs) 22%, white),
    color-mix(in srgb, var(--cp) 18%, white));
  border: 1px solid color-mix(in srgb, var(--cs) 25%, transparent);
  border-radius: 999px; padding: 4px 12px;
  margin-bottom: 2px;
}

.vendor-name {
  font-family: var(--fd); font-size: 20px; font-weight: 400; font-style: italic;
  color: var(--dark); line-height: 1.2;
}

.vendor-subtitle {
  font-family: var(--fb); font-size: 10px; font-weight: 400;
  color: color-mix(in srgb, var(--cp) 70%, var(--muted)); letter-spacing: 0.5px;
}

.vendor-location {
  font-family: var(--fb); font-size: 11px; font-weight: 300;
  color: var(--muted); letter-spacing: 0.5px;
}

.vendor-cta {
  margin-top: auto; padding-top: 12px;
  font-family: var(--fb); font-size: 10px; font-weight: 500;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--cs);
  transition: color 0.2s ease;
}
.vendor-card:hover .vendor-cta { color: var(--dark); }

/* ── Modal ─────────────────────────────────────────────── */
.vendor-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
  width: min(480px, calc(100vw - 32px));
  max-height: calc(100dvh - 48px);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  box-shadow: 0 24px 64px rgba(0,0,0,0.18);
  background: var(--ivory);
  padding: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
}
.vendor-modal::backdrop {
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(2px);
}

.modal-close {
  position: absolute; top: 12px; right: 12px; z-index: 10;
  width: 28px; height: 28px;
  background: color-mix(in srgb, var(--dark) 8%, white);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: background 0.2s ease;
  color: var(--dark);
}
.modal-close:hover { background: color-mix(in srgb, var(--dark) 15%, white); }

.modal-photo {
  width: 100%; height: 220px;
  overflow: hidden; flex-shrink: 0;
  background: color-mix(in srgb, var(--cp) 12%, var(--warm));
}
.modal-photo img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center;
  display: block;
}
.modal-photo--placeholder {
  display: flex; align-items: center; justify-content: center;
}
.modal-photo-initial {
  font-family: var(--fd); font-size: 72px; font-weight: 300; font-style: italic;
  color: color-mix(in srgb, var(--cs) 60%, var(--dark));
  opacity: 0.4;
}

.modal-body {
  padding: 24px 28px 28px;
  display: flex; flex-direction: column; gap: 20px;
}

.modal-header {
  display: flex; flex-direction: column; align-items: center;
  gap: 4px; text-align: center;
}

.modal-name {
  font-family: var(--fd); font-size: 28px; font-weight: 400; font-style: italic;
  color: var(--dark); line-height: 1.2;
  margin: 0;
}

.modal-subtitle {
  font-family: var(--fb); font-size: 11px; font-weight: 400;
  color: color-mix(in srgb, var(--cp) 70%, var(--muted)); letter-spacing: 0.5px;
}

.modal-location {
  font-family: var(--fb); font-size: 11px; font-weight: 300;
  color: var(--muted); letter-spacing: 0.5px;
}

/* ── Modal Sections ────────────────────────────────────── */
.modal-section {
  display: flex; flex-direction: column; gap: 6px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.modal-section-label {
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase; color: var(--muted);
  margin-bottom: 2px;
}

.modal-contact-link {
  display: flex; align-items: center; gap: 7px;
  font-family: var(--fb); font-size: 12px; font-weight: 300;
  color: var(--dark); text-decoration: none;
  transition: color 0.2s ease;
}
.modal-contact-link:hover { color: var(--cs); }

.modal-icon { flex-shrink: 0; opacity: 0.5; }

.modal-person {
  display: flex; flex-direction: column; gap: 4px;
  padding: 10px 12px;
  background: color-mix(in srgb, var(--cs) 6%, white);
  border-radius: var(--radius-sm);
  border: 1px solid color-mix(in srgb, var(--cs) 12%, transparent);
}

.modal-person-name {
  font-family: var(--fb); font-size: 12px; font-weight: 500;
  color: var(--dark); margin-bottom: 2px;
}

/* ── Social media ──────────────────────────────────────── */
.modal-socials {
  display: flex; flex-wrap: wrap; gap: 8px;
}

.modal-social-link {
  display: inline-flex; align-items: center; gap: 7px;
  font-family: var(--fb); font-size: 11px; font-weight: 400;
  color: var(--dark); text-decoration: none;
  padding: 6px 12px;
  background: color-mix(in srgb, var(--dark) 5%, white);
  border: 1px solid var(--border);
  border-radius: 999px;
  transition: background 0.2s ease, border-color 0.2s ease;
}
.modal-social-link:hover {
  background: color-mix(in srgb, var(--cs) 10%, white);
  border-color: color-mix(in srgb, var(--cs) 30%, transparent);
}
.social-icon { flex-shrink: 0; }

/* ── Modal Links ───────────────────────────────────────── */
.modal-links {
  flex-direction: row !important;
  gap: 8px !important;
}

.modal-link-btn {
  flex: 1;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase; text-decoration: none;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  color: var(--muted);
  transition: background 0.2s ease, color 0.2s ease;
}
.modal-link-btn:hover { background: color-mix(in srgb, var(--dark) 6%, white); color: var(--dark); }
.modal-link-btn--primary {
  background: var(--cs); color: white; border-color: var(--cs);
}
.modal-link-btn--primary:hover { background: var(--dark); border-color: var(--dark); color: white; }

/* ── Mobile ────────────────────────────────────────────── */
@media (max-width: 580px) {
  .vendor-card { width: 100%; }
  .modal-links { flex-direction: column !important; }
}
</style>
