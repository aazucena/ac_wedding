---
// apps/web/src/pages/seating.astro — reception seating finder
import Layout           from '../layouts/Layout.astro';
import PageHeader       from '../components/PageHeader.astro';
import Hashtag          from '~/components/Hashtag.astro';
import SeatingSearchCard from '../components/seating/SeatingSearchCard.astro';
import { getSettings }  from '../lib/directus';
import { formatDate }   from '../lib/utils/format';

const settings         = await getSettings();
const groom            = settings.groom?.first_name ?? 'Aldrin';
const bride            = settings.bride?.first_name ?? 'Christine';
const weddingDateLabel = formatDate(settings.wedding_date ?? '2026-09-26');
const weddingLocation = settings.location;
---

<Layout
  title={`Find Your Seat — ${groom} & ${bride}`}
  colorPrimary={settings.color_primary}
  colorSecondary={settings.color_secondary}
  activeNav="seating"
>

  <div class="page-narrow">

    <PageHeader
      groomName={groom}
      brideName={bride}
      eyebrow="Reception Seating"
      date={`${weddingDateLabel} · ${weddingLocation}`}
    />

    <SeatingSearchCard />

    <p class="seating-note">
      Seating assignments are for the reception dinner.
      If you can't find your name, ask one of our ushers at the venue.
    </p>

  </div>

  <Fragment slot="footer-extra">
    <Hashtag tag={settings.hashtag} class="footer-hashtag" />
    <p class="footer-note">{groom} & {bride} · {weddingDateLabel}</p>
  </Fragment>

</Layout>

<style>
.seating-note {
  font-family: var(--fb); font-size: 12px; font-weight: 300;
  color: var(--muted); text-align: center; line-height: 1.7;
  max-width: 380px; margin: 4px auto 0;
  opacity: 0; animation: fadeUp 0.8s 0.55s ease forwards;
}
</style>
