---
// apps/web/src/layouts/Layout.astro
interface Props {
  title: string;
  description?: string;
  colorPrimary?: string;
  colorSecondary?: string;
  activeNav?:
    | "home"
    | "rsvp"
    | "sponsors"
    | "info"
    | "story"
    | "invite"
    | "gallery"
    | "wedding-party"
    | "seating"
    | "guestbook"
    | "ceremony"
    | "partners"
    | "events"
    | "memories";
  envelope?: boolean;
  toc?: boolean;
  tocShowAfter?: string; // CSS selector passed to TableOfContents showAfter
}

const {
  title,
  description,
  colorPrimary = "#A8D4B8",
  colorSecondary = "#C5B8E0",
  activeNav,
  envelope = true,
  toc = false,
  tocShowAfter,
} = Astro.props;

import Insignia from "@assets/insignia.png";
import { Image } from "astro:assets";
import "@fontsource/cormorant-garamond/300-italic.css";
import "@fontsource/cormorant-garamond/300.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "@fontsource/jost/300.css";
import "@fontsource/jost/400.css";
import "@fontsource/jost/500.css";
import "@fontsource/jost/600.css";
import { MAIN_NAV_ITEMS as NAV_ITEMS } from "@lib/constants";
import { PREVIEW_TOKEN } from "astro:env/server";
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import DynamicBackground from "../components/DynamicBackground.astro";
import Navbar from "../components/Navbar.astro";
import AnchorProvider from "../components/ui/AnchorProvider.astro";
import BackToTop from "../components/ui/BackToTop.astro";
import TableOfContents from "../components/ui/TableOfContents.astro";
import EnvelopePreloader from "../components/home/EnvelopePreloader.astro";
import { getSettings } from "@lib/directus";
import { formatDate } from "@lib/utils/format";

const isPreview = Astro.locals.isPreview ?? false;
const previewSuffix =
  isPreview && PREVIEW_TOKEN ? `?preview=${PREVIEW_TOKEN}` : "";

const envelopeData = envelope ? await getSettings() : null;
const groomFull = envelopeData
  ? `${envelopeData.groom?.first_name ?? "Aldrin"} ${envelopeData.groom?.last_name ?? "Azucena"}`
  : "Aldrin Azucena";
const brideFull = envelopeData
  ? `${envelopeData.bride?.first_name ?? "Christine"} ${envelopeData.bride?.last_name ?? "Ranada"}`
  : "Christine Ranada";
const weddingDateLabel = envelopeData
  ? formatDate(envelopeData.wedding_date ?? "2026-09-26")
  : "";
const weddingLocation = envelopeData
  ? (envelopeData.location ?? "Lethbridge, Alberta")
  : "";

const ogDescription =
  description ??
  (weddingDateLabel
    ? `Join us as ${groomFull} & ${brideFull} celebrate their wedding on ${weddingDateLabel} in ${weddingLocation}.`
    : `${groomFull} & ${brideFull} — Wedding celebration`);
const ogImage = new URL("/api/social/dm.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={ogDescription} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${groomFull} & ${brideFull}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <ClientRouter />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style define:vars={{ colorPrimary, colorSecondary }}>
      :root {
        --cp: var(--colorPrimary, #a8d4b8);
        --cs: var(--colorSecondary, #c5b8e0);
      }
    </style>
  </head>
  <body>
    <div transition:animate="fade" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <Navbar
      items={NAV_ITEMS}
      activeNav={activeNav}
      scrollSpy={activeNav === "home"}
      previewSuffix={previewSuffix}
    />

    <main class="page">
      <slot />
      <footer class="footer">
        <Image src={Insignia} class="footer-seal" alt="" />
        <slot name="footer-extra" />
        <p class="footer-note footer-copyright">
          &copy; 2026 {groomFull} &amp; {brideFull}
        </p>
      </footer>
    </main>
    <slot name="overlay" />
    {
      envelope && (
        <EnvelopePreloader
          groomFull={groomFull}
          brideFull={brideFull}
          weddingDateLabel={weddingDateLabel}
          weddingLocation={weddingLocation}
        />
      )
    }
    <DynamicBackground />
    <BackToTop />
    <AnchorProvider />
    {toc && <TableOfContents showAfter={tocShowAfter} />}
  </body>
</html>
