---
// src/components/FoldLine.astro
// Dashed fold / score line for tent-fold cards and program spreads.

interface Props {
  direction?: 'horizontal' | 'vertical';  // default 'horizontal'
  label?: boolean;                          // show 'fold' text, default true
}

const { direction = 'horizontal', label = true } = Astro.props;
---

<div class:list={['fold-line', `fold-line--${direction}`]}>
  {label && <span class="fold-label">fold</span>}
</div>

<style>
  .fold-line {
    position: relative; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .fold-line--horizontal {
    width: 100%; height: 0;
    border-top: 1px dashed rgba(197,184,224,0.6);
  }
  .fold-line--vertical {
    height: 100%; width: 0;
    border-left: 1px dashed rgba(197,184,224,0.6);
  }
  .fold-label {
    position: absolute;
    font-family: 'Jost', Arial, sans-serif; font-size: 7px; font-weight: 500;
    letter-spacing: 2px; text-transform: uppercase; color: rgba(197,184,224,0.8);
    background: var(--ivory, #fdfaf7); padding: 0 6px;
  }
  @media print { .fold-line { border-color: #ddd; } }
</style>
