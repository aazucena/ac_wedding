---
// apps/web/src/components/ClosedCard.astro
interface Props {
  groomName:    string;
  brideName:    string;
  hashtag:      string;
  weddingDate:  string;
  coupleEmail?: string;
}

const { groomName, brideName, hashtag, weddingDate, coupleEmail } = Astro.props;
---

<div class="closed-card">

  <div class="closed-glow" aria-hidden="true"></div>

  <span class="closed-icon">💍</span>

  <h2 class="closed-title">
    {groomName}
    <span class="amp">&amp;</span>
    {brideName}
  </h2>

  <p class="closed-badge">Married · {weddingDate}</p>

  <div class="closed-divider">
    <span class="rule"></span>
    <span class="closed-divider-symbol">✦</span>
    <span class="rule r"></span>
  </div>

  <p class="closed-body">
    Thank you to everyone who celebrated with us.<br />
    RSVP is now closed.
  </p>

  <p class="closed-hashtag">{hashtag}</p>

  {coupleEmail && (
    <p class="closed-contact">
      Questions? Reach us at{' '}
      <a href={`mailto:${coupleEmail}`}>{coupleEmail}</a>
    </p>
  )}

</div>

<style>
.closed-card {
  background: var(--ivory);
  border-radius: var(--radius);
  width: 100%; max-width: 580px;
  box-shadow: var(--shadow-card);
  border: 1px solid var(--border);
  overflow: hidden; text-align: center;
  padding: 72px 52px;
  position: relative;
  opacity: 0; animation: fadeUp 0.9s 0.3s ease forwards;
}

.closed-glow {
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse at 20% 10%, color-mix(in srgb, var(--cp) 14%, transparent) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 90%, color-mix(in srgb, var(--cs) 12%, transparent) 0%, transparent 55%);
}

.closed-icon {
  font-size: 56px; display: block; margin-bottom: 24px;
  animation: floatIn 1s 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes floatIn {
  from { opacity: 0; transform: scale(0.6) translateY(10px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}

.closed-title {
  font-family: var(--fd);
  font-size: clamp(36px, 7vw, 52px);
  font-weight: 300; font-style: italic;
  color: var(--dark); line-height: 1.05; margin-bottom: 14px;
}
.closed-title .amp { color: var(--cs); font-style: normal; }

.closed-badge {
  display: inline-block;
  font-family: var(--fb); font-size: 10px; font-weight: 600;
  letter-spacing: 3px; text-transform: uppercase; color: var(--dark);
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--cp) 28%, white),
    color-mix(in srgb, var(--cs) 22%, white)
  );
  border: 1px solid color-mix(in srgb, var(--cs) 25%, transparent);
  border-radius: 999px;
  padding: 6px 18px;
  margin-bottom: 28px;
}

.closed-divider {
  display: flex; align-items: center; justify-content: center;
  gap: 14px; margin: 4px 0 28px;
}
.closed-divider .rule { height: 1px; width: 56px; background: linear-gradient(90deg, transparent, var(--cs)); }
.closed-divider .rule.r { background: linear-gradient(90deg, var(--cs), transparent); }
.closed-divider-symbol { font-family: var(--fd); font-size: 15px; color: var(--cs); }

.closed-body {
  font-family: var(--fb); font-size: 15px; font-weight: 300;
  color: var(--muted); line-height: 2; margin-bottom: 28px;
}

.closed-hashtag {
  font-family: var(--fd); font-size: 26px; font-style: italic;
  color: var(--cs); display: block; margin-bottom: 20px;
}

.closed-contact {
  font-family: var(--fb); font-size: 12px; font-weight: 300;
  color: #b0abbe; line-height: 1.8;
}
.closed-contact a {
  color: var(--cs); text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--cs) 40%, transparent);
  padding-bottom: 1px; transition: opacity 0.2s;
}
.closed-contact a:hover { opacity: 0.7; }

@media (max-width: 520px) {
  .closed-card { padding: 48px 28px; }
}
</style>