---
// DynamicBackground.astro — CSS-only bokeh background; no PixiJS, no JS runtime per frame.
// Each orb uses CSS custom properties from the original ORBS data.
// GPU-composited CSS animations replace the 60fps JS render loop.

const ORBS = [
  // Greens
  { cx: 8,  cy: 10, fx: 34, ax: 30, ay: 22, sz: 62, color: '#a8d4b8', alpha: 0.40, dx: '8vw',   dy: '5vh'  },
  { cx: 48, cy: 85, fx: 41, ax: 22, ay: 20, sz: 46, color: '#a8d4b8', alpha: 0.35, dx: '-6vw',  dy: '-4vh' },
  { cx: 72, cy: 55, fx: 27, ax: 16, ay: 18, sz: 30, color: '#a8d4b8', alpha: 0.20, dx: '4vw',   dy: '6vh'  },
  { cx: 30, cy: 40, fx: 58, ax: 20, ay: 24, sz: 22, color: '#a8d4b8', alpha: 0.15, dx: '-5vw',  dy: '-3vh' },
  // Purples
  { cx: 90, cy: 12, fx: 38, ax: 24, ay: 22, sz: 60, color: '#c5b8e0', alpha: 0.38, dx: '-7vw',  dy: '4vh'  },
  { cx: 18, cy: 68, fx: 31, ax: 20, ay: 26, sz: 42, color: '#c5b8e0', alpha: 0.32, dx: '5vw',   dy: '-5vh' },
  { cx: 62, cy: 22, fx: 47, ax: 18, ay: 16, sz: 34, color: '#c5b8e0', alpha: 0.22, dx: '-4vw',  dy: '3vh'  },
  { cx: 85, cy: 75, fx: 22, ax: 14, ay: 20, sz: 25, color: '#c5b8e0', alpha: 0.18, dx: '3vw',   dy: '-4vh' },
  // Warm peach
  { cx: 52, cy: 30, fx: 55, ax: 18, ay: 20, sz: 34, color: '#e8b4a0', alpha: 0.30, dx: '-5vw',  dy: '5vh'  },
  { cx: 15, cy: 90, fx: 44, ax: 12, ay: 14, sz: 20, color: '#e8b4a0', alpha: 0.15, dx: '3vw',   dy: '-3vh' },
  // Soft lavender
  { cx: 40, cy: 60, fx: 63, ax: 24, ay: 18, sz: 28, color: '#d4c8f0', alpha: 0.10, dx: '6vw',   dy: '4vh'  },
  { cx: 78, cy: 38, fx: 36, ax: 16, ay: 22, sz: 18, color: '#d4c8f0', alpha: 0.05, dx: '-3vw',  dy: '-2vh' },
];
---

<div id="bokeh-bg" aria-hidden="true">
  {ORBS.map((orb, i) => (
    <div
      class="orb"
      style={[
        `--cx:${orb.cx}vw`,
        `--cy:${orb.cy}vh`,
        `--sz:${orb.sz}vmin`,
        `--color:${orb.color}`,
        `--alpha:${orb.alpha}`,
        `--fx:${orb.fx}s`,
        `--dx:${orb.dx}`,
        `--dy:${orb.dy}`,
        `--delay:${(i * 1.3).toFixed(1)}s`,
      ].join(';')}
    />
  ))}
</div>

<script>
  // Apply time-of-day class to <html> so --warm cascades into the html background
  const hour = new Date().getHours();
  const cl = document.documentElement.classList;
  if      (hour >= 5  && hour < 12) cl.add('tod-morning');
  else if (hour >= 12 && hour < 17) cl.add('tod-afternoon');
  else if (hour >= 17 && hour < 20) cl.add('tod-evening');
  else                              cl.add('tod-night');
</script>

<style is:global>
  #bokeh-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--warm);
  }

  .orb {
    position: absolute;
    left: var(--cx);
    top:  var(--cy);
    width:  var(--sz);
    height: var(--sz);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color) calc(var(--alpha) * 100%), transparent) 0%,
      transparent 70%
    );
    filter: blur(clamp(20px, calc(var(--sz) * 0.2), 80px));
    animation: orb-float var(--fx) ease-in-out var(--delay) infinite alternate;
    will-change: transform;
  }

  @keyframes orb-float {
    from { transform: translate(-50%, -50%) translate(0, 0); }
    to   { transform: translate(-50%, -50%) translate(var(--dx), var(--dy)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orb { animation: none; }
  }
</style>
