---
// invite/InviteSearchCard.astro — name search + token fallback form
---

<div class="invite-card" id="search-section">
  <div class="card-header">
    <span class="card-header-label">Find your invitation</span>
    <p class="card-header-title">What's your name?</p>
  </div>
  <div class="card-body">
    <div class="error-banner" id="error-banner"></div>

    <div class="field">
      <label class="field-label" for="name-input">Your name</label>
      <input
        id="name-input"
        type="text"
        placeholder="e.g. Juan dela Cruz"
        autocomplete="off"
        autocorrect="off"
      />
      <div class="suggestions" id="suggestions" style="display:none;"></div>
    </div>

    <div id="results-section" style="display:none;">
      <p class="results-label">
        We found the following parties — select yours:
      </p>
      <div class="results-list" id="results-list"></div>
    </div>

    <button class="submit-btn" id="search-btn" onclick="handleSearch()">
      <span class="btn-text">Find My Invitation</span>
      <div class="btn-dots">
        <div class="dot"></div><div class="dot"></div><div class="dot"></div>
      </div>
    </button>
  </div>
</div>

<script>
  import { actions } from "astro:actions";

  declare global {
    interface Window {
      handleSearch: () => Promise<void>;
    }
  }

  let debounceTimer: ReturnType<typeof setTimeout> | null = null;

  function renderSuggestions(
    parties: Array<{ id: string; name: string; status?: string }>,
  ) {
    const box = document.getElementById("suggestions") as HTMLElement;
    box.replaceChildren();
    if (!parties.length) { box.style.display = "none"; return; }

    const label = document.createElement("p");
    label.className = "suggestions-label";
    label.textContent = "Select your party";
    box.appendChild(label);

    parties.forEach((party) => {
      const btn = document.createElement("button");
      btn.className = "suggestion-item";
      btn.onclick = () => { window.location.href = `/api/rsvp/party?id=${party.id}`; };

      const nameSpan = document.createElement("span");
      nameSpan.textContent = party.name;
      btn.appendChild(nameSpan);

      if (party.status === "confirmed") {
        const badge = document.createElement("span");
        badge.className = "suggestion-badge suggestion-badge--confirmed";
        badge.textContent = "RSVP'd";
        btn.appendChild(badge);
      } else if (party.status === "declined") {
        const badge = document.createElement("span");
        badge.className = "suggestion-badge suggestion-badge--declined";
        badge.textContent = "Declined";
        btn.appendChild(badge);
      }

      box.appendChild(btn);
    });

    box.style.display = "flex";
    box.classList.remove("visible");
    void box.offsetWidth;
    box.classList.add("visible");
  }

  function hideSuggestions() {
    const box = document.getElementById("suggestions") as HTMLElement;
    if (box) box.style.display = "none";
  }

  function renderResults(
    parties: Array<{ id: string; name: string }>,
  ) {
    const list = document.getElementById("results-list") as HTMLElement;
    const section = document.getElementById("results-section") as HTMLElement;
    list.replaceChildren();
    parties.forEach((party) => {
      const btn = document.createElement("button");
      btn.className = "result-item";
      btn.textContent = party.name;
      btn.onclick = () => {
        window.location.href = `/api/rsvp/party?id=${party.id}`;
      };
      list.appendChild(btn);
    });
    section.style.display = "block";
  }

  window.handleSearch = async function () {
    hideSuggestions();
    const name = (
      document.getElementById("name-input") as HTMLInputElement
    ).value.trim();
    const btn = document.getElementById("search-btn") as HTMLElement;
    const btnText = btn.querySelector(".btn-text") as HTMLElement;
    const err = document.getElementById("error-banner") as HTMLElement;
    const resultsSection = document.getElementById(
      "results-section",
    ) as HTMLElement;

    err.textContent = "";
    err.classList.remove("visible");
    resultsSection.style.display = "none";

    if (!name) {
      err.textContent = "Please enter your name to search.";
      err.classList.add("visible");
      return;
    }

    btn.classList.add("loading");
    let navigating = false;

    try {
      const { data, error } = await actions.searchParties({ name });
      const parties = data?.parties ?? [];

      if (error || !parties.length) {
        err.textContent =
          "We couldn't find your name on the guest list. Please try a different spelling or contact us directly.";
        err.classList.add("visible");
      } else if (parties.length === 1) {
        navigating = true;
        btnText.textContent = "Opening your invitation…";
        window.location.href = `/api/rsvp/party?id=${parties[0]!.id}`;
      } else {
        renderResults(parties);
        resultsSection.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    } catch {
      err.textContent =
        "Something went wrong. Please try again or use your invitation code.";
      err.classList.add("visible");
    } finally {
      // Keep loading state if we're navigating — page will change before user notices
      if (!navigating) btn.classList.remove("loading");
    }
  };

  document.addEventListener("astro:page-load", () => {
    const input = document.getElementById("name-input") as HTMLInputElement;

    input?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") window.handleSearch();
      if (e.key === "Escape") hideSuggestions();
    });

    input?.addEventListener("input", () => {
      if (debounceTimer) clearTimeout(debounceTimer);
      const val = input.value.trim();
      if (val.length < 2) { hideSuggestions(); return; }
      debounceTimer = setTimeout(async () => {
        const { data } = await actions.searchParties({ name: val });
        renderSuggestions(data?.parties ?? []);
      }, 300);
    });

    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest("#name-input, #suggestions")) {
        hideSuggestions();
      }
    });
  });
</script>

<style>
  .invite-card {
    background: var(--ivory);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    width: 100%;
    overflow: hidden;
    opacity: 0;
    animation: fadeUp 0.8s 0.35s ease forwards;
    margin-bottom: 16px;
  }

  /* .suggestions is in the static template — scoped style applies fine */
  .suggestions {
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    overflow: hidden;
    margin-top: 2px;
  }

  .suggestions.visible {
    animation: suggestionFadeIn 0.2s ease forwards;
  }

  @keyframes suggestionFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* :global() required — these elements are created dynamically in JS
     and never receive Astro's data-astro-cid-* scope attribute */
  :global(.suggestions-label) {
    padding: 8px 16px 7px;
    font-family: var(--fb);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--cp) 8%, transparent),
      transparent
    );
  }

  :global(.suggestion-item) {
    width: 100%;
    padding: 13px 18px;
    background: color-mix(in srgb, var(--warm) 50%, white);
    border: none;
    border-left: 2px solid transparent;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
    font-family: var(--fd);
    font-size: 18px;
    font-weight: 400;
    font-style: italic;
    color: var(--dark);
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    transition:
      background 0.2s ease,
      border-left-color 0.2s ease;
  }

  :global(.suggestion-badge) {
    flex-shrink: 0;
    font-family: var(--fb);
    font-size: 9px;
    font-weight: 600;
    font-style: normal;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 999px;
  }

  :global(.suggestion-badge--confirmed) {
    background: color-mix(in srgb, var(--cp) 22%, white);
    color: color-mix(in srgb, var(--cp) 60%, var(--dark));
    border: 1px solid color-mix(in srgb, var(--cp) 40%, transparent);
  }

  :global(.suggestion-badge--declined) {
    background: rgba(212, 100, 100, 0.08);
    color: #8a3a3a;
    border: 1px solid rgba(212, 100, 100, 0.25);
  }

  :global(.suggestion-item:last-child) {
    border-bottom: none;
  }

  :global(.suggestion-item:hover) {
    background: color-mix(in srgb, var(--cp) 12%, white);
    border-left-color: var(--cp);
  }

  .results-label {
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 4px;
  }

  .result-item {
    width: 100%;
    padding: 14px 18px;
    background: color-mix(in srgb, var(--warm) 60%, white);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-xs);
    font-family: var(--fd);
    font-size: 18px;
    font-weight: 400;
    color: var(--dark);
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .result-item:hover {
    border-color: color-mix(in srgb, var(--cp) 60%, transparent);
    background: color-mix(in srgb, var(--cp) 8%, white);
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(26, 26, 46, 0.07);
  }
</style>
