---
// rsvp/RsvpGuestRow.astro — single guest card row.
// Two explicit response segments; attending expands detail fields below.

interface Props {
  guestId: string;
  name: string;
  dietary: string;
}
const { guestId, name, dietary } = Astro.props;
---

<div class="guest-card" id={`guest-${guestId}`} data-guest-id={guestId}>
  <div class="guest-card-header" id={`header-${guestId}`}>
    <span class="guest-name">{name}</span>
    <div class="response-seg" role="group" aria-label="Response">
      <button
        type="button"
        class="seg seg--yes"
        id={`yes-${guestId}`}
        onclick={`onResponseChange('${guestId}', 'attending')`}
      >
        ✓ Attending
      </button>
      <span class="seg-divider" aria-hidden="true"></span>
      <button
        type="button"
        class="seg seg--no"
        id={`no-${guestId}`}
        onclick={`onResponseChange('${guestId}', 'declined')`}
        >✗ Declining</button
      >
    </div>
  </div>

  <!-- Expands when attending -->
  <div class="attending-panel" id={`panel-${guestId}`}>
    <div class="attending-content">
      <div class="attending-inner">
        <div class="field">
          <label class="field-label">Attending</label>
          <div class="card-option-list">
            <label class="card-option card-option--radio">
              <input
                type="radio"
                name={`attendance_type_${guestId}`}
                value="both"
                checked
              />
              <span class="card-option-icon">🎉</span>
              <span class="card-option-body">
                <span class="card-option-title">Ceremony &amp; Reception</span>
              </span>
              <span class="card-option-check">✓</span>
            </label>
            <label class="card-option card-option--radio">
              <input
                type="radio"
                name={`attendance_type_${guestId}`}
                value="ceremony"
              />
              <span class="card-option-icon">⛪</span>
              <span class="card-option-body">
                <span class="card-option-title">Ceremony Only</span>
              </span>
              <span class="card-option-check">✓</span>
            </label>
            <label class="card-option card-option--radio">
              <input
                type="radio"
                name={`attendance_type_${guestId}`}
                value="reception"
              />
              <span class="card-option-icon">🥂</span>
              <span class="card-option-body">
                <span class="card-option-title">Reception Only</span>
              </span>
              <span class="card-option-check">✓</span>
            </label>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for={`dietary-${guestId}`}>
            Dietary Restrictions <span class="optional">optional</span>
          </label>
          <textarea
            id={`dietary-${guestId}`}
            rows={2}
            placeholder="Allergies, intolerances, or other requirements…"
            >{dietary}</textarea
          >
        </div>
      </div>
    </div>
  </div>
</div>
