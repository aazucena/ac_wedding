---
// rsvp/RsvpStepReview.astro — Step 5: Review summary + submit
---

<div class="wizard-step" id="step-5">
  <p class="step-eyebrow">Review Your RSVP</p>
  <p class="step-sub">Everything look good? Submit when you're ready.</p>
  <div class="review-content" id="review-content"></div>
  <div class="error-banner" id="error-5"></div>
  <div class="submit-wrap">
    <div class="wizard-nav wizard-nav--between">
      <button type="button" class="wizard-btn wizard-btn--back" id="back-5"
        >← Back</button
      >
      <button type="submit" class="submit-btn" id="submit-btn">
        <span class="btn-text">Send</span>
        <span class="btn-dots">
          <span class="dot"></span><span class="dot"></span><span class="dot"
          ></span>
        </span>
      </button>
    </div>
  </div>
</div>
