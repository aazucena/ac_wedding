---
// rsvp/RsvpStepExtras.astro — Step 3: Hotel, transportation, song request
---

<div class="wizard-step" id="step-3">
  <p class="step-eyebrow">A Few More Details</p>
  <div class="step-fields">
    <div class="field">
      <label class="field-label">Do you need any of the following?</label>
      <div class="card-option-list">
        <label class="card-option card-option--check">
          <input type="checkbox" id="hotel" />
          <span class="card-option-icon">🏨</span>
          <span class="card-option-body">
            <span class="card-option-title">Hotel Room</span>
            <span class="card-option-desc">We can help arrange accommodation nearby</span>
          </span>
          <span class="card-option-check">✓</span>
        </label>
        <label class="card-option card-option--check">
          <input type="checkbox" id="transport" />
          <span class="card-option-icon">🚌</span>
          <span class="card-option-body">
            <span class="card-option-title">Transportation</span>
            <span class="card-option-desc">Shuttle between venues and hotel</span>
          </span>
          <span class="card-option-check">✓</span>
        </label>
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="song">
        Song Request <span class="optional">optional</span>
      </label>
      <input type="text" id="song" placeholder="Song title & artist — we'll try to fit it in!" autocomplete="off" />
      <p class="field-hint">Suggest a song you'd love to hear at the reception.</p>
    </div>
  </div>
  <div class="wizard-nav wizard-nav--between">
    <button type="button" class="wizard-btn wizard-btn--back" id="back-3">← Back</button>
    <button type="button" class="wizard-btn wizard-btn--next" id="next-3">Continue</button>
  </div>
</div>
