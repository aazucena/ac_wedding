---
// rsvp/RsvpStepContact.astro — Step 2: Party representative + contact details
interface Props {
  guests: Array<{ id: string; name: string; type: string }>;
}
const { guests } = Astro.props;
const isSolo = guests.length === 1;
---

<div class="wizard-step" id="step-2">
  <p class="step-eyebrow">Contact Details</p>
  <p class="step-sub">
    {isSolo
      ? "We'll use these to reach you with any updates."
      : "We'll use these to reach your party representative with any updates."}
  </p>
  <div class="step-fields">
    {!isSolo && (
      <div class="field">
        <label class="field-label">Party Representative</label>
        <div class="card-option-list" id="rep-list">
          {
            guests.map((g, i) => (
              <label
                class="card-option card-option--radio"
                id={`rep-option-${g.id}`}
                data-type={g.type}
              >
                <input
                  type="radio"
                  name="representative"
                  value={g.id}
                  checked={i === 0}
                />
                <span class="card-option-icon">👤</span>
                <span class="card-option-body">
                  <span class="card-option-title">{g.name}</span>
                </span>
                <span class="card-option-check">✓</span>
              </label>
            ))
          }
        </div>
      </div>
    )}
    {isSolo && (
      <input type="hidden" name="representative" value={guests[0]!.id} />
    )}
    <div class="field">
      <label class="field-label" for="contact-phone">
        Phone Number <span class="optional">at least one required</span>
      </label>
      <input
        type="tel"
        id="contact-phone"
        placeholder="+63 917 123 4567"
        autocomplete="tel"
      />
    </div>
    <div class="field">
      <label class="field-label" for="contact-email">
        Email Address <span class="optional">at least one required</span>
      </label>
      <input
        type="email"
        id="contact-email"
        placeholder="you@example.com"
        autocomplete="email"
      />
    </div>
  </div>
  <div class="error-banner" id="error-2"></div>
  <div class="wizard-nav wizard-nav--between">
    <button type="button" class="wizard-btn wizard-btn--back" id="back-2"
      >← Back</button
    >
    <button type="button" class="wizard-btn wizard-btn--next" id="next-2"
      >Continue</button
    >
  </div>
</div>
