---
// rsvp/RsvpForm.astro — multi-step RSVP wizard (5 steps)
// Step 1: responses + details → Step 2: contact → Step 3: extras → Step 4: message → Step 5: review
// Declined path: Step 1 → Step 4 → Step 5  (3 visible steps)

import type { Parties } from '@lib/types';
import iconSrc from '~/assets/icon.png';
import RsvpGuestRow    from './RsvpGuestRow.astro';
import RsvpMemoryUpload from './RsvpMemoryUpload.astro';
import RsvpStepContact from './RsvpStepContact.astro';
import RsvpStepExtras  from './RsvpStepExtras.astro';
import RsvpStepMessage from './RsvpStepMessage.astro';
import RsvpStepReview  from './RsvpStepReview.astro';
import Hashtag         from '../Hashtag.astro';
import '~/styles/rsvp-form.css';

interface Props {
  party:        Parties;
  groomName:    string;
  brideName:    string;
  hashtag:      string;
  rsvpDeadline: string;
}

const { party, groomName, brideName, hashtag, rsvpDeadline } = Astro.props;

type GuestType = 'adult' | 'teen' | 'child' | 'infant';

const TYPE_ORDER: Record<GuestType, number> = { adult: 0, teen: 1, child: 2, infant: 3 };

const guests = (party.members ?? []).map((g) => ({
  id:       g.id,
  personId: g.person?.id ?? null,
  name:     g.person?.preferred_name ?? g.person?.first_name ?? '',
  type:     (g.type ?? 'adult') as GuestType,
  dietary:  g.dietary_restrictions ?? '',
})).sort((a, b) => TYPE_ORDER[a.type] - TYPE_ORDER[b.type]);
---

<div class="card-header">
  <span class="card-header-label">Kindly Reply</span>
  <p class="card-header-greeting">
    Dear <span class="guest-name">{party.name}</span>
  </p>
  {party.invitation_label && party.invitation_type !== 'guest' && (
    <p class="card-header-role">You are invited as our {party.invitation_label}</p>
  )}
  <p class="card-header-sub">Please respond for each member of your party.</p>
  <span class="deadline-badge">⏳ Due on {rsvpDeadline}</span>
</div>

<div class="form-loader" id="form-loader" aria-hidden="true">
  <img class="form-loader-icon" src={iconSrc.src} alt="" width="80" height="80" />
  <p class="form-loader-text">A moment, please…</p>
</div>

<div class="card-body">
  <form id="rsvp-form" novalidate>

    <!-- Progress bar -->
    <div class="wizard-progress">
      <div class="wizard-progress-track">
        <div class="wizard-progress-fill" id="wizard-fill" style="width:20%"></div>
      </div>
      <span class="wizard-label" id="wizard-label">Step 1 of 5</span>
    </div>

    <!-- ── Step 1: Who's coming? + details ───────────── -->
    <div class="wizard-step active" id="step-1">
      <div class="guest-list" id="guest-list">
        {guests.map((g) => (
          <RsvpGuestRow
            guestId={g.id}
            name={g.name}
            dietary={g.dietary}
          />
        ))}
      </div>
      <div class="error-banner" id="error-1"></div>
      <div class="wizard-nav wizard-nav--right">
        <button type="button" class="wizard-btn wizard-btn--next" id="next-1">Continue</button>
      </div>
    </div>

    <!-- ── Step 2: Contact details ───────────────────── -->
    <RsvpStepContact guests={guests} />

    <!-- ── Step 3: Extras ────────────────────────────── -->
    <RsvpStepExtras />

    <!-- ── Step 4: Message ───────────────────────────── -->
    <RsvpStepMessage groomName={groomName} brideName={brideName} />

    <!-- ── Step 5: Review ────────────────────────────── -->
    <RsvpStepReview />

  </form>

  <div class="success-state" id="state-success">
    <div class="success-icon">💌</div>
    <h2 class="success-title">Thank you!</h2>
    <p class="success-sub" id="success-message">
      Your RSVP has been received.<br />We can't wait to celebrate with you.
    </p>
    <a href="/" class="success-home-btn" id="success-home-btn" style="display:none">Visit our wedding website</a>
    <Hashtag as="span" class="success-hashtag" tag={hashtag} />
  </div>

  <RsvpMemoryUpload
    sectionId="upload-section"
    dzId="dz-new"
    thumbGridId="thumb-grid-new"
    submitBtnId="upload-submit-new"
    statusId="upload-status-new"
  />

</div>

<Fragment set:html={`
<script type="application/json" id="rsvp-data">
  ${JSON.stringify({
    partyId:   party.id,
    guestList: guests.map(g => ({ id: g.id, personId: g.personId, name: g.name, type: g.type })),
    rsvpToken: party.rsvp_token,
  })}
</script>
`}/>

<script>
  import '~/scripts/rsvp-wizard';
</script>
