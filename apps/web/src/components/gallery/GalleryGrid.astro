---
import type { DirectusFiles } from "../../lib/types";
import { assetUrl } from "../../lib/utils/format";
import logoSrc from "@assets/favicon.png";
import { PUBLIC_DOWNLOAD_GALLERY_IMAGES } from "astro:env/client";

interface GalleryItem {
  id: string;
  title?: string | null;
  description?: string | null;
  image?: DirectusFiles | null;
  sort?: number | null;
  category?: string | null;
  bw?: boolean | null;
}
interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
const allowDownload = PUBLIC_DOWNLOAD_GALLERY_IMAGES ?? false;
const padCount = (3 - (items.length % 3)) % 3;
---

<div
  class="gallery-grid"
  id="gallery-grid"
  data-allow-download={String(allowDownload)}
>
  {
    items.map((photo, i) => (
      <button
        class="gallery-item"
        data-index={i}
        data-src={photo.image ? assetUrl(photo.image) : null}
        data-title={photo.title}
        data-desc={photo.description}
        data-category={photo.category ?? ""}
        data-bw={photo.bw ? "true" : "false"}
        onclick="openLightbox(this)"
        aria-label={photo.title ?? `Photo ${i + 1}`}
      >
        {photo.image ? (
          <>
            <img
              src={assetUrl(photo.image, {
                width: 600,
                height: 600,
                fit: "cover",
              })}
              alt={photo.title ?? `Photo ${i + 1}`}
              loading="lazy"
              decoding="async"
              class="gallery-img"
            />
            <div class="gallery-loader" aria-hidden="true">
              <img src={logoSrc.src} alt="" class="gallery-loader-logo" />
            </div>
          </>
        ) : (
          <div class="gallery-placeholder">
            <span class="gallery-placeholder-icon">📷</span>
          </div>
        )}
        <div class="gallery-overlay">
          {photo.title && <p class="gallery-item-title">{photo.title}</p>}
        </div>
      </button>
    ))
  }
  {
    Array.from({ length: padCount }, () => (
      <div class="gallery-item gallery-item--pad" aria-hidden="true">
        <div class="gallery-placeholder">
          <span class="gallery-placeholder-icon">📷</span>
        </div>
      </div>
    ))
  }
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    width: 100%;
    opacity: 0;
    animation: fadeUp 0.8s 0.2s ease forwards;
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    background: none;
    padding: 0;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .gallery-item:hover {
    transform: scale(1.02);
    box-shadow: var(--shadow-hover);
    z-index: 1;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-img.protected {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.05);
  }

  .gallery-loader {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cp) 18%, var(--warm)),
      color-mix(in srgb, var(--cs) 14%, var(--warm))
    );
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .gallery-loader.loaded {
    opacity: 0;
    pointer-events: none;
  }

  .gallery-loader-logo {
    width: 120px;
    height: auto;
    animation: gallery-logo-pulse 2s ease-in-out infinite;
  }

  @keyframes gallery-logo-pulse {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.06);
    }
  }

  .gallery-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--cp) 18%, var(--warm)),
      color-mix(in srgb, var(--cs) 14%, var(--warm))
    );
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    opacity: 0.5;
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 50%,
      rgba(26, 26, 46, 0.6) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 12px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }

  .gallery-item-title {
    font-family: var(--fd);
    font-size: 14px;
    font-style: italic;
    color: #fff;
    line-height: 1.2;
  }

  .gallery-item--pad {
    cursor: default;
    pointer-events: none;
    opacity: 0.35;
  }
  .gallery-item--pad:hover {
    transform: none;
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .gallery-item--pad {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const grid = document.getElementById("gallery-grid") as HTMLElement | null;
    if (!grid) return;
    const allowDownload = grid.dataset.allowDownload === "true";

    document.querySelectorAll<HTMLElement>(".gallery-item").forEach((item) => {
      const img = item.querySelector<HTMLImageElement>("img.gallery-img");
      const loader = item.querySelector<HTMLElement>(".gallery-loader");
      if (!img || !loader) return;

      const dismiss = () => loader.classList.add("loaded");
      if (img.complete && img.naturalWidth > 0) {
        dismiss();
        return;
      }
      img.addEventListener("load", dismiss, { once: true });
      img.addEventListener("error", dismiss, { once: true });

      if (!allowDownload) {
        img.classList.add("protected");
        img.addEventListener("contextmenu", (e) => e.preventDefault());
        img.addEventListener("dragstart", (e) => e.preventDefault());
      }
    });
  });
</script>
