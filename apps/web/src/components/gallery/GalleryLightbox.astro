---
// GalleryLightbox.astro — full-screen photo lightbox overlay
// Reads .gallery-item buttons from DOM; functions exposed on window.*
import { assetUrl } from '../../lib/utils/format';
import type { DirectusFiles } from '../../lib/types';
interface Props {
  photographer?: string | null;
  photographerLogo?: { id: string } | null;
}
const { photographer, photographerLogo } = Astro.props;
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">✕</button>
  <button class="lightbox-prev"  onclick="prevPhoto()"    aria-label="Previous">‹</button>
  <button class="lightbox-next"  onclick="nextPhoto()"    aria-label="Next">›</button>

  <div class="lightbox-content">
    <img class="lightbox-img" id="lightbox-img" src="" alt="" />
    <div class="lightbox-placeholder" id="lightbox-placeholder">
      <span>📷</span>
    </div>
    <div class="lightbox-meta" id="lightbox-meta">
      <p class="lightbox-title"   id="lightbox-title"></p>
      <p class="lightbox-desc"    id="lightbox-desc"></p>
      {(photographerLogo || photographer) && (
        <p class="lightbox-credit">
          {photographerLogo
            ? <img src={assetUrl(photographerLogo as DirectusFiles, { height: 20 })} alt={photographer ?? 'Photographer'} class="lightbox-credit-logo" />
            : <>📷 {photographer}</>
          }
        </p>
      )}
      <div class="lightbox-footer">
        <p class="lightbox-counter" id="lightbox-counter"></p>
        <a class="lightbox-download" id="lightbox-download" href="#" download aria-label="Download photo">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const items = Array.from(document.querySelectorAll('.gallery-item'));
  let current = 0;

  function openLightbox(btn) {
    current = parseInt(btn.dataset.index);
    showPhoto(current);
    document.getElementById('lightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  }

  function showPhoto(i) {
    const btn      = items[i];
    const src      = btn.dataset.src;
    const img      = document.getElementById('lightbox-img');
    const ph       = document.getElementById('lightbox-placeholder');
    const title    = document.getElementById('lightbox-title');
    const desc     = document.getElementById('lightbox-desc');
    const ctr      = document.getElementById('lightbox-counter');
    const dlBtn    = document.getElementById('lightbox-download');

    if (src && src !== 'null') {
      img.src = src;
      img.alt = btn.dataset.title ?? '';
      img.style.display = 'block';
      ph.style.display  = 'none';
      dlBtn.href = src + (src.includes('?') ? '&' : '?') + 'download';
      dlBtn.style.display = 'inline-flex';
    } else {
      img.style.display   = 'none';
      ph.style.display    = 'flex';
      dlBtn.style.display = 'none';
    }

    title.textContent = btn.dataset.title && btn.dataset.title !== 'null' ? btn.dataset.title : '';
    desc.textContent  = btn.dataset.desc  && btn.dataset.desc  !== 'null' ? btn.dataset.desc  : '';
    ctr.textContent   = `${i + 1} / ${items.length}`;
  }

  function prevPhoto() {
    current = (current - 1 + items.length) % items.length;
    showPhoto(current);
  }

  function nextPhoto() {
    current = (current + 1) % items.length;
    showPhoto(current);
  }

  // Keyboard nav
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft')  prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === 'Escape')     closeLightbox();
  });

  // Click outside to close
  document.getElementById('lightbox').addEventListener('click', e => {
    if (e.target === document.getElementById('lightbox')) closeLightbox();
  });

  window.openLightbox  = openLightbox;
  window.closeLightbox = closeLightbox;
  window.prevPhoto     = prevPhoto;
  window.nextPhoto     = nextPhoto;
</script>

<style>
.lightbox {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(26, 26, 46, 0.92);
  backdrop-filter: blur(12px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox.open { opacity: 1; pointer-events: auto; }

.lightbox-content {
  position: relative; max-width: 90vw; max-height: 85vh;
  display: flex; flex-direction: column; align-items: center; gap: 16px;
}

.lightbox-img {
  max-width: 90vw; max-height: 70vh;
  object-fit: contain;
  border-radius: var(--radius);
  box-shadow: 0 24px 80px rgba(0,0,0,0.5);
}

.lightbox-placeholder {
  width: 480px; height: 360px; max-width: 90vw;
  background: color-mix(in srgb, var(--warm) 20%, rgba(26,26,46,0.8));
  border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
  font-size: 48px; opacity: 0.4;
}

.lightbox-meta { text-align: center; }

.lightbox-title {
  font-family: var(--fd); font-size: 20px; font-style: italic;
  color: #fff; margin-bottom: 4px;
}

.lightbox-desc {
  font-family: var(--fb); font-size: 13px; font-weight: 300;
  color: rgba(255,255,255,0.6); margin-bottom: 4px;
}

.lightbox-credit {
  font-family: var(--fb); font-size: 11px; font-weight: 300;
  font-style: italic; color: rgba(255,255,255,0.4); margin-bottom: 8px;
}
.lightbox-credit-logo {
  height: 20px; width: auto; object-fit: contain;
  opacity: 0.45; vertical-align: middle; filter: brightness(0) invert(1);
}

.lightbox-footer {
  display: flex; align-items: center; justify-content: center; gap: 16px;
}

.lightbox-counter {
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 2px; color: rgba(255,255,255,0.4);
}

.lightbox-download {
  display: inline-flex; align-items: center; gap: 5px;
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 20px; padding: 4px 12px;
  transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.lightbox-download:hover {
  color: #fff; border-color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.08);
}

.lightbox-close {
  position: fixed; top: 20px; right: 24px;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%; width: 40px; height: 40px;
  color: #fff; font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.lightbox-close:hover { background: rgba(255,255,255,0.2); }

.lightbox-prev,
.lightbox-next {
  position: fixed; top: 50%; transform: translateY(-50%);
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--radius-xs); width: 48px; height: 64px;
  color: #fff; font-size: 28px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.lightbox-prev:hover,
.lightbox-next:hover { background: rgba(255,255,255,0.2); }
.lightbox-prev { left: 16px; }
.lightbox-next { right: 16px; }

@media (max-width: 640px) {
  .lightbox-prev { left: 8px; }
  .lightbox-next { right: 8px; }
}
</style>
