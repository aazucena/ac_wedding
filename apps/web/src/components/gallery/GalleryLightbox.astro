---
// GalleryLightbox.astro — full-screen photo lightbox overlay
// Reads .gallery-item buttons from DOM; functions exposed on window.*
import { assetUrl } from "../../lib/utils/format";
import type { DirectusFiles } from "../../lib/types";
import logoSrc from "@assets/favicon.png";
import { PUBLIC_DOWNLOAD_GALLERY_IMAGES } from "astro:env/client";
interface Props {
  photographer?: string | null;
  photographerLogo?: { id: string } | null;
  showDownload?: boolean;
  /** Native share sheet for the open photo — /memories only. */
  showShare?: boolean;
  /** Sent alongside a shared photo or link, e.g. the wedding hashtag. */
  shareText?: string | null;
}
const allowDownload = PUBLIC_DOWNLOAD_GALLERY_IMAGES ?? false;
const {
  photographer,
  photographerLogo,
  showDownload = allowDownload,
  showShare = false,
  shareText = null,
} = Astro.props;
---

<div
  class="lightbox"
  id="lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
  data-allow-download={String(showDownload)}
  data-share-text={shareText ?? ""}
>
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close"
    >✕</button
  >
  <button class="lightbox-prev" onclick="prevPhoto()" aria-label="Previous"
    >‹</button
  >
  <button class="lightbox-next" onclick="nextPhoto()" aria-label="Next"
    >›</button
  >

  <div class="lightbox-content">
    <div class="lightbox-img-wrap" id="lightbox-img-wrap">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <div class="lightbox-loader" id="lightbox-loader" aria-hidden="true">
        <img src={logoSrc.src} alt="" class="lightbox-loader-logo" />
      </div>
    </div>
    <div class="lightbox-placeholder" id="lightbox-placeholder">
      <span>📷</span>
    </div>

    <div class="lightbox-mobile-nav" aria-label="Photo navigation">
      <button
        onclick="prevPhoto()"
        class="lightbox-mob-btn"
        aria-label="Previous">‹</button
      >
      <p
        class="lightbox-counter lightbox-counter--mob"
        id="lightbox-counter-mob"
      >
      </p>
      <button onclick="nextPhoto()" class="lightbox-mob-btn" aria-label="Next"
        >›</button
      >
    </div>

    <div class="lightbox-meta" id="lightbox-meta">
      <p class="lightbox-title" id="lightbox-title"></p>
      <p class="lightbox-desc" id="lightbox-desc"></p>
      {
        /* Empty unless the tile carries data-author / data-date — /gallery
          items carry neither, and :empty collapses them there. */
      }
      <p class="lightbox-author" id="lightbox-author"></p>
      <p class="lightbox-date" id="lightbox-date"></p>
      {
        photographer && (
          <p class="lightbox-credit">
            {photographerLogo && (
              <img
                src={assetUrl(photographerLogo as DirectusFiles, {
                  height: 16,
                })}
                alt=""
                class="lightbox-credit-logo"
              />
            )}
            📷 {photographer}
          </p>
        )
      }
      <div class="lightbox-footer">
        <p class="lightbox-counter" id="lightbox-counter"></p>
        {
          showDownload && (
            <a
              class="lightbox-download"
              id="lightbox-download"
              href="#"
              download
              aria-label="Download photo"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </>
              </svg>
              Download
            </a>
          )
        }
        {
          showShare && (
            <button
              type="button"
              class="lightbox-download lightbox-share"
              id="lightbox-share"
              aria-label="Share photo"
              hidden
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <>
                  <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                  <polyline points="16 6 12 2 8 6" />
                  <line x1="12" y1="2" x2="12" y2="15" />
                </>
              </svg>
              Share
            </button>
          )
        }
        {
          showShare && (
            <span
              class="lightbox-share-feedback"
              id="lightbox-share-feedback"
              aria-live="polite"
            />
          )
        }
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // The router runs an inline script once and never again, so nothing here may
  // hold on to the page it first ran on: every element lookup and listener is
  // redone per page in initLightbox (same pattern as Navbar.astro). Capturing
  // the tiles at the top level left the viewer walking a previous visit's
  // photos after navigating away and back.
  let _lbAbort = null;

  function initLightbox() {
    if (_lbAbort) _lbAbort.abort();
    _lbAbort = new AbortController();
    const sig = { signal: _lbAbort.signal };

    const lb = document.getElementById("lightbox");
    if (!lb) return;

    // The photos next/previous walks through, rebuilt from the live page each
    // time the viewer opens: everything, or just the tiles the /gallery filter
    // left showing (it marks the rest data-filtered-out). Not a visibility
    // check — /memories hides off-page tiles but still slides through.
    let list = [];
    let current = 0;

    // ── Share (/memories) ──────────────────────────────────────────
    // navigator.share() needs transient user activation, and an await between
    // the tap and the call can spend it — iOS Safari then rejects the share (see
    // shareShot() in scripts/camera.ts). So the open photo's File is fetched when
    // it is SHOWN, never on the tap. One blob alive at a time; shareToken drops a
    // fetch that finishes after the guest has already swiped on.
    const shareBtn = document.getElementById("lightbox-share");
    const shareFeedback = document.getElementById("lightbox-share-feedback");
    const shareText = lb.dataset.shareText || "";
    let shareFile = null;
    let shareToken = 0;

    if (shareBtn && (navigator.share || navigator.clipboard)) {
      shareBtn.hidden = false;
    }

    function prepareShare(src, i) {
      shareFile = null;
      const t = ++shareToken;
      if (!shareBtn || !navigator.canShare || !src || src === "null") return;
      fetch(src)
        .then((res) => (res.ok ? res.blob() : null))
        .then((blob) => {
          if (!blob || t !== shareToken) return;
          const ext = (blob.type.split("/")[1] || "jpg").replace("jpeg", "jpg");
          const file = new File([blob], `memory-${i + 1}.${ext}`, {
            type: blob.type,
          });
          if (navigator.canShare({ files: [file] })) shareFile = file;
        })
        .catch(() => {});
    }

    function sharePhoto() {
      const url = `${location.origin}/memories`;
      // No await before share(): see the note above.
      const shared = shareFile
        ? navigator.share({ files: [shareFile], text: shareText || undefined })
        : navigator.share
          ? navigator.share({ title: document.title, text: shareText, url })
          : null;
      if (shared) {
        // AbortError when they back out of the sheet — nothing to report.
        shared.catch(() => {});
        return;
      }
      navigator.clipboard
        ?.writeText(shareText ? `${shareText} — ${url}` : url)
        .then(() => {
          if (!shareFeedback) return;
          shareFeedback.textContent = "Link copied";
          setTimeout(() => (shareFeedback.textContent = ""), 3000);
        })
        .catch(() => {});
    }
    shareBtn?.addEventListener("click", sharePhoto, sig);

    function openLightbox(btn) {
      list = Array.from(
        document.querySelectorAll(".gallery-item:not(.gallery-item--pad)"),
      ).filter((el) => !el.hasAttribute("data-filtered-out"));
      current = Math.max(0, list.indexOf(btn));
      showPhoto(current);
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      lb.classList.remove("open");
      document.body.style.overflow = "";
      // Don't keep a full-size photo in memory after the viewer closes.
      shareFile = null;
      shareToken++;
    }

    function showPhoto(i) {
      const btn = list[i];
      const src = btn.dataset.src;
      const img = document.getElementById("lightbox-img");
      const loader = document.getElementById("lightbox-loader");
      const ph = document.getElementById("lightbox-placeholder");
      const title = document.getElementById("lightbox-title");
      const desc = document.getElementById("lightbox-desc");
      const date = document.getElementById("lightbox-date");
      const author = document.getElementById("lightbox-author");
      const ctr = document.getElementById("lightbox-counter");
      const dlBtn = document.getElementById("lightbox-download");

      if (src && src !== "null") {
        img.classList.remove("revealed");
        if (loader) loader.classList.remove("hidden");
        img.alt = btn.dataset.title ?? "";
        img.style.display = "block";
        ph.style.display = "none";
        // If revisiting a cached image, reveal immediately — otherwise wait for load
        if (
          img.getAttribute("src") === src &&
          img.complete &&
          img.naturalWidth > 0
        ) {
          img.classList.add("revealed");
          if (loader) loader.classList.add("hidden");
        } else {
          img.addEventListener(
            "load",
            () => {
              img.classList.add("revealed");
              if (loader) loader.classList.add("hidden");
            },
            { once: true },
          );
          img.addEventListener(
            "error",
            () => {
              if (loader) loader.classList.add("hidden");
            },
            { once: true },
          );
          img.src = src;
        }
        if (dlBtn) {
          dlBtn.href = src + (src.includes("?") ? "&" : "?") + "download";
          dlBtn.style.display = "inline-flex";
        }
        prepareShare(src, i);
      } else {
        img.classList.remove("revealed");
        img.style.display = "none";
        ph.style.display = "flex";
        if (loader) loader.classList.add("hidden");
        if (dlBtn) dlBtn.style.display = "none";
        prepareShare(null, i);
      }

      title.textContent =
        btn.dataset.title && btn.dataset.title !== "null"
          ? btn.dataset.title
          : "";
      desc.textContent =
        btn.dataset.desc && btn.dataset.desc !== "null" ? btn.dataset.desc : "";
      if (author)
        author.textContent =
          btn.dataset.author && btn.dataset.author !== "null"
            ? `Photo by ${btn.dataset.author}`
            : "";
      if (date)
        date.textContent =
          btn.dataset.date && btn.dataset.date !== "null"
            ? btn.dataset.date
            : "";
      ctr.textContent = `${i + 1} / ${list.length}`;
      const ctrMob = document.getElementById("lightbox-counter-mob");
      if (ctrMob) ctrMob.textContent = ctr.textContent;
    }

    function prevPhoto() {
      current = (current - 1 + list.length) % list.length;
      showPhoto(current);
    }

    function nextPhoto() {
      current = (current + 1) % list.length;
      showPhoto(current);
    }

    // Keyboard nav
    document.addEventListener(
      "keydown",
      (e) => {
        if (!lb.classList.contains("open")) return;
        if (e.key === "ArrowLeft") prevPhoto();
        if (e.key === "ArrowRight") nextPhoto();
        if (e.key === "Escape") closeLightbox();
      },
      sig,
    );

    // Click outside to close
    lb.addEventListener(
      "click",
      (e) => {
        if (e.target === lb) closeLightbox();
      },
      sig,
    );

    // Swipe navigation (mobile)
    let _touchStartX = 0;
    lb.addEventListener(
      "touchstart",
      (e) => {
        _touchStartX = e.touches[0].clientX;
      },
      { passive: true, ...sig },
    );
    lb.addEventListener(
      "touchend",
      (e) => {
        if (!lb.classList.contains("open")) return;
        const delta = e.changedTouches[0].clientX - _touchStartX;
        if (Math.abs(delta) > 50) delta < 0 ? nextPhoto() : prevPhoto();
      },
      sig,
    );

    // Download protection
    if (lb.dataset.allowDownload !== "true") {
      const lbImg = document.getElementById("lightbox-img");
      lbImg.addEventListener("contextmenu", (e) => e.preventDefault(), sig);
      lbImg.addEventListener("dragstart", (e) => e.preventDefault(), sig);
    }

    window.openLightbox = openLightbox;
    window.closeLightbox = closeLightbox;
    window.prevPhoto = prevPhoto;
    window.nextPhoto = nextPhoto;
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(26, 26, 46, 0.92);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .lightbox.open {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-content {
    position: relative;
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .lightbox-img-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: min(480px, 90vw);
    min-height: min(320px, 70vh);
    border-radius: var(--radius);
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .lightbox-img.revealed {
    opacity: 1;
  }

  [data-allow-download="false"] .lightbox-img {
    -webkit-user-drag: none;
    -webkit-touch-callout: none;
    user-select: none;
  }

  .lightbox-loader {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: rgba(26, 26, 46, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .lightbox-loader.hidden {
    opacity: 0;
  }

  .lightbox-loader-logo {
    width: 120px;
    height: auto;
    animation: lb-logo-pulse 2s ease-in-out infinite;
  }

  @keyframes lb-logo-pulse {
    0%,
    100% {
      opacity: 0.2;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.55;
      transform: scale(1.06);
    }
  }

  .lightbox-placeholder {
    width: 480px;
    height: 360px;
    max-width: 90vw;
    background: color-mix(in srgb, var(--warm) 20%, rgba(26, 26, 46, 0.8));
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    opacity: 0.4;
  }

  .lightbox-meta {
    text-align: center;
  }

  .lightbox-title {
    font-family: var(--fd);
    font-size: 20px;
    font-style: italic;
    color: #fff;
    margin-bottom: 4px;
  }

  .lightbox-desc {
    font-family: var(--fb);
    font-size: 13px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 4px;
  }

  /* Credit for a guest photo. Display face and near-full white, so it reads as
     a byline rather than as metadata — the date below stays quiet. */
  .lightbox-author {
    font-family: var(--fd);
    font-size: 14px;
    font-style: italic;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 3px;
  }
  .lightbox-author:empty {
    display: none;
  }

  /* Only /memories tiles carry a date. `:empty` keeps this from adding a gap
     on /gallery, where the element renders but never gets text. */
  .lightbox-date {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 4px;
  }
  .lightbox-date:empty {
    display: none;
  }

  .lightbox-credit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--fb);
    font-size: 12px;
    font-weight: 400;
    font-style: italic;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 8px;
  }
  .lightbox-credit-logo {
    height: 16px;
    width: auto;
    object-fit: contain;
    opacity: 0.7;
    vertical-align: middle;
  }

  .lightbox-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .lightbox-counter {
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.4);
  }

  .lightbox-download {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    padding: 4px 12px;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .lightbox-share {
    background: none;
    cursor: pointer;
  }
  .lightbox-share[hidden] {
    display: none;
  }
  .lightbox-share-feedback {
    font-family: var(--fb);
    font-size: 11px;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.55);
  }
  .lightbox-share-feedback:empty {
    display: none;
  }
  .lightbox-download:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.08);
  }

  .lightbox-close {
    position: fixed;
    top: 20px;
    right: 24px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    color: #fff;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-prev,
  .lightbox-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-xs);
    width: 48px;
    height: 64px;
    color: #fff;
    font-size: 28px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
  }
  .lightbox-prev {
    left: 16px;
  }
  .lightbox-next {
    right: 16px;
  }

  /* Mobile inline nav row — hidden on desktop */
  .lightbox-mobile-nav {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .lightbox-mob-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-xs);
    width: 52px;
    height: 44px;
    color: #fff;
    font-size: 26px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  .lightbox-mob-btn:hover {
    background: rgba(255, 255, 255, 0.22);
  }

  @media (max-width: 640px) {
    .lightbox-prev,
    .lightbox-next {
      display: none;
    }

    .lightbox-mobile-nav {
      display: flex;
    }

    /* Photo → who & when → what you can do → prev/next. The action row lives
       inside .lightbox-meta, so the nav row lands last, in thumb reach.
       Reordered with `order` so the DOM (and desktop) stay as they are. */
    .lightbox-content {
      gap: 14px;
      width: 100%;
      max-width: 100%;
      max-height: 100vh;
      max-height: 100dvh;
      padding: 64px 16px max(16px, env(safe-area-inset-bottom));
    }
    .lightbox-img-wrap,
    .lightbox-placeholder {
      order: 0;
    }
    .lightbox-meta {
      order: 1;
    }
    .lightbox-mobile-nav {
      order: 2;
    }
    .lightbox-footer {
      order: 3;
    }

    .lightbox-img {
      max-height: 55vh;
      max-height: 55dvh;
    }
    .lightbox-img-wrap {
      min-height: unset;
      min-width: unset;
    }

    /* Caption: one tight group, description last and clamped so a long one
       can never push the buttons off-screen. */
    .lightbox-meta {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      width: min(100%, 320px);
    }
    .lightbox-meta > * {
      margin: 0;
    }
    .lightbox-title {
      font-size: 18px;
    }
    .lightbox-desc {
      order: 1;
      margin-top: 6px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* Nav + counter on one row */
    .lightbox-mobile-nav {
      justify-content: space-between;
      width: min(100%, 320px);
    }
    .lightbox-footer .lightbox-counter {
      display: none;
    }

    /* Actions: equal-width, thumb-sized */
    .lightbox-footer {
      flex-wrap: wrap;
      width: 100%;
      gap: 10px;
      margin-top: 14px;
    }
    .lightbox-download {
      flex: 1 1 0;
      justify-content: center;
      min-height: 44px;
      font-size: 12px;
      border-radius: var(--radius-sm);
    }
    .lightbox-share-feedback {
      flex-basis: 100%;
      text-align: center;
    }
    .lightbox-placeholder {
      height: 52vw;
      width: 90vw;
    }
  }
</style>
