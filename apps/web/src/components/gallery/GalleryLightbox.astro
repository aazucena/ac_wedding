---
// GalleryLightbox.astro — full-screen photo lightbox overlay
// Reads .gallery-item buttons from DOM; functions exposed on window.*
import { assetUrl } from '../../lib/utils/format';
import type { DirectusFiles } from '../../lib/types';
import logoSrc from '@assets/favicon.png';
import { PUBLIC_DOWNLOAD_GALLERY_IMAGES } from 'astro:env/client';
interface Props {
  photographer?: string | null;
  photographerLogo?: { id: string } | null;
  showDownload?: boolean;
}
const allowDownload = PUBLIC_DOWNLOAD_GALLERY_IMAGES ?? false;
const { photographer, photographerLogo, showDownload = allowDownload } = Astro.props;
---

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" data-allow-download={String(allowDownload)}>
  <button class="lightbox-close" onclick="closeLightbox()" aria-label="Close">✕</button>
  <button class="lightbox-prev"  onclick="prevPhoto()"    aria-label="Previous">‹</button>
  <button class="lightbox-next"  onclick="nextPhoto()"    aria-label="Next">›</button>

  <div class="lightbox-content">
    <div class="lightbox-img-wrap" id="lightbox-img-wrap">
      <img class="lightbox-img" id="lightbox-img" src="" alt="" />
      <div class="lightbox-loader" id="lightbox-loader" aria-hidden="true">
        <img src={logoSrc.src} alt="" class="lightbox-loader-logo" />
      </div>
    </div>
    <div class="lightbox-placeholder" id="lightbox-placeholder">
      <span>📷</span>
    </div>

    <div class="lightbox-mobile-nav" aria-label="Photo navigation">
      <button onclick="prevPhoto()" class="lightbox-mob-btn" aria-label="Previous">‹</button>
      <button onclick="nextPhoto()" class="lightbox-mob-btn" aria-label="Next">›</button>
    </div>

    <div class="lightbox-meta" id="lightbox-meta">
      <p class="lightbox-title"   id="lightbox-title"></p>
      <p class="lightbox-desc"    id="lightbox-desc"></p>
      {photographer && (
        <p class="lightbox-credit">
          {photographerLogo && (
            <img src={assetUrl(photographerLogo as DirectusFiles, { height: 16 })} alt="" class="lightbox-credit-logo" />
          )}
          📷 {photographer}
        </p>
      )}
      <div class="lightbox-footer">
        <p class="lightbox-counter" id="lightbox-counter"></p>
        {showDownload && (
          <a class="lightbox-download" id="lightbox-download" href="#" download aria-label="Download photo">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const items = Array.from(document.querySelectorAll('.gallery-item:not(.gallery-item--pad)'));
  let current = 0;

  function openLightbox(btn) {
    current = parseInt(btn.dataset.index);
    showPhoto(current);
    document.getElementById('lightbox').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
    document.body.style.overflow = '';
  }

  function showPhoto(i) {
    const btn    = items[i];
    const src    = btn.dataset.src;
    const img    = document.getElementById('lightbox-img');
    const loader = document.getElementById('lightbox-loader');
    const ph     = document.getElementById('lightbox-placeholder');
    const title  = document.getElementById('lightbox-title');
    const desc   = document.getElementById('lightbox-desc');
    const ctr    = document.getElementById('lightbox-counter');
    const dlBtn  = document.getElementById('lightbox-download');

    if (src && src !== 'null') {
      img.classList.remove('revealed');
      if (loader) loader.classList.remove('hidden');
      img.alt = btn.dataset.title ?? '';
      img.style.display = 'block';
      ph.style.display  = 'none';
      // If revisiting a cached image, reveal immediately — otherwise wait for load
      if (img.getAttribute('src') === src && img.complete && img.naturalWidth > 0) {
        img.classList.add('revealed');
        if (loader) loader.classList.add('hidden');
      } else {
        img.addEventListener('load',  () => { img.classList.add('revealed'); if (loader) loader.classList.add('hidden'); }, { once: true });
        img.addEventListener('error', () => { if (loader) loader.classList.add('hidden'); }, { once: true });
        img.src = src;
      }
      if (dlBtn) { dlBtn.href = src + (src.includes('?') ? '&' : '?') + 'download'; dlBtn.style.display = 'inline-flex'; }
    } else {
      img.classList.remove('revealed');
      img.style.display = 'none';
      ph.style.display  = 'flex';
      if (loader) loader.classList.add('hidden');
      if (dlBtn) dlBtn.style.display = 'none';
    }

    title.textContent = btn.dataset.title && btn.dataset.title !== 'null' ? btn.dataset.title : '';
    desc.textContent  = btn.dataset.desc  && btn.dataset.desc  !== 'null' ? btn.dataset.desc  : '';
    ctr.textContent   = `${i + 1} / ${items.length}`;
  }

  function prevPhoto() {
    current = (current - 1 + items.length) % items.length;
    showPhoto(current);
  }

  function nextPhoto() {
    current = (current + 1) % items.length;
    showPhoto(current);
  }

  // Keyboard nav
  document.addEventListener('keydown', e => {
    if (!document.getElementById('lightbox').classList.contains('open')) return;
    if (e.key === 'ArrowLeft')  prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
    if (e.key === 'Escape')     closeLightbox();
  });

  // Click outside to close
  document.getElementById('lightbox').addEventListener('click', e => {
    if (e.target === document.getElementById('lightbox')) closeLightbox();
  });

  // Swipe navigation (mobile)
  let _touchStartX = 0;
  const lb = document.getElementById('lightbox');
  lb.addEventListener('touchstart', e => { _touchStartX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', e => {
    if (!lb.classList.contains('open')) return;
    const delta = e.changedTouches[0].clientX - _touchStartX;
    if (Math.abs(delta) > 50) delta < 0 ? nextPhoto() : prevPhoto();
  });

  // Download protection
  if (document.getElementById('lightbox').dataset.allowDownload !== 'true') {
    const lbImg = document.getElementById('lightbox-img');
    lbImg.addEventListener('contextmenu', e => e.preventDefault());
    lbImg.addEventListener('dragstart',   e => e.preventDefault());
  }

  window.openLightbox  = openLightbox;
  window.closeLightbox = closeLightbox;
  window.prevPhoto     = prevPhoto;
  window.nextPhoto     = nextPhoto;
</script>

<style>
.lightbox {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(26, 26, 46, 0.92);
  backdrop-filter: blur(12px);
  display: flex; align-items: center; justify-content: center;
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease;
}

.lightbox.open { opacity: 1; pointer-events: auto; }

.lightbox-content {
  position: relative; max-width: 90vw; max-height: 85vh;
  display: flex; flex-direction: column; align-items: center; gap: 16px;
}

.lightbox-img-wrap {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  min-width: min(480px, 90vw); min-height: min(320px, 70vh);
  border-radius: var(--radius);
}

.lightbox-img {
  max-width: 90vw; max-height: 70vh;
  object-fit: contain;
  border-radius: var(--radius);
  box-shadow: 0 24px 80px rgba(0,0,0,0.5);
  position: relative; z-index: 1;
  opacity: 0; transition: opacity 0.35s ease;
}
.lightbox-img.revealed { opacity: 1; }

[data-allow-download="false"] .lightbox-img {
  -webkit-user-drag: none;
  -webkit-touch-callout: none;
  user-select: none;
}

.lightbox-loader {
  position: absolute; inset: 0;
  border-radius: var(--radius);
  background: rgba(26, 26, 46, 0.55);
  display: flex; align-items: center; justify-content: center;
  opacity: 1; transition: opacity 0.35s ease;
  pointer-events: none;
}
.lightbox-loader.hidden { opacity: 0; }

.lightbox-loader-logo {
  width: 120px; height: auto;
  animation: lb-logo-pulse 2s ease-in-out infinite;
}

@keyframes lb-logo-pulse {
  0%, 100% { opacity: 0.20; transform: scale(0.92); }
  50%       { opacity: 0.55; transform: scale(1.06); }
}

.lightbox-placeholder {
  width: 480px; height: 360px; max-width: 90vw;
  background: color-mix(in srgb, var(--warm) 20%, rgba(26,26,46,0.8));
  border-radius: var(--radius);
  display: flex; align-items: center; justify-content: center;
  font-size: 48px; opacity: 0.4;
}

.lightbox-meta { text-align: center; }

.lightbox-title {
  font-family: var(--fd); font-size: 20px; font-style: italic;
  color: #fff; margin-bottom: 4px;
}

.lightbox-desc {
  font-family: var(--fb); font-size: 13px; font-weight: 300;
  color: rgba(255,255,255,0.6); margin-bottom: 4px;
}

.lightbox-credit {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--fb); font-size: 12px; font-weight: 400;
  font-style: italic; color: rgba(255,255,255,0.70); margin-bottom: 8px;
}
.lightbox-credit-logo {
  height: 16px; width: auto; object-fit: contain;
  opacity: 0.70; vertical-align: middle;
}

.lightbox-footer {
  display: flex; align-items: center; justify-content: center; gap: 16px;
}

.lightbox-counter {
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 2px; color: rgba(255,255,255,0.4);
}

.lightbox-download {
  display: inline-flex; align-items: center; gap: 5px;
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  letter-spacing: 1px; text-transform: uppercase;
  color: rgba(255,255,255,0.55);
  text-decoration: none;
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 20px; padding: 4px 12px;
  transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}
.lightbox-download:hover {
  color: #fff; border-color: rgba(255,255,255,0.5);
  background: rgba(255,255,255,0.08);
}

.lightbox-close {
  position: fixed; top: 20px; right: 24px;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50%; width: 40px; height: 40px;
  color: #fff; font-size: 16px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.lightbox-close:hover { background: rgba(255,255,255,0.2); }

.lightbox-prev,
.lightbox-next {
  position: fixed; top: 50%; transform: translateY(-50%);
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  border-radius: var(--radius-xs); width: 48px; height: 64px;
  color: #fff; font-size: 28px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.lightbox-prev:hover,
.lightbox-next:hover { background: rgba(255,255,255,0.2); }
.lightbox-prev { left: 16px; }
.lightbox-next { right: 16px; }

/* Mobile inline nav row — hidden on desktop */
.lightbox-mobile-nav {
  display: none;
  align-items: center; justify-content: center; gap: 16px;
}
.lightbox-mob-btn {
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25);
  border-radius: var(--radius-xs); width: 52px; height: 44px;
  color: #fff; font-size: 26px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s ease;
}
.lightbox-mob-btn:hover { background: rgba(255,255,255,0.22); }

@media (max-width: 640px) {
  .lightbox-prev,
  .lightbox-next { display: none; }

  .lightbox-mobile-nav { display: flex; }

  .lightbox-img { max-height: 52vh; }
  .lightbox-img-wrap { min-height: unset; min-width: unset; }
  .lightbox-placeholder { height: 52vw; width: 90vw; }
}
</style>
