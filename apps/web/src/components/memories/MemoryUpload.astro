---
// components/memories/MemoryUpload.astro
// "Share your photo" form — POSTs multipart to /api/photo/upload.
//
// Identity is name + table number, the same check Roll Call uses at /camera,
// rather than the RSVP invitation code. Nobody at a reception wants to dig an
// email link out of their phone, and a guest who used the camera already knows
// this flow.
import "../../styles/memory-upload.css";
---

<section class="mu-section" id="mu-section">
  <!-- ── CTA banner (collapsed state) ─────────────────────── -->
  <div class="mu-cta" id="mu-cta">
    <div class="mu-cta-left">
      <p class="mu-cta-title font-display">Share your photos</p>
      <p class="mu-cta-body">
        Upload a photo from the day to add it to our memories.
      </p>
    </div>
    <button class="mu-open-btn" id="mu-open" type="button">
      Upload
      <span class="mu-open-arrow" aria-hidden="true">↑</span>
    </button>
  </div>

  <!-- ── Upload form (expanded state) ──────────────────────── -->
  <div class="mu-expand" id="mu-expand" hidden>
    <form class="mu-form" id="mu-form" novalidate>
      <!-- File drop zone -->
      <div
        class="mu-drop"
        id="mu-drop"
        tabindex="0"
        role="button"
        aria-label="Select a photo to upload"
      >
        <input
          class="mu-file-input"
          id="mu-file"
          type="file"
          accept="image/*"
          tabindex="-1"
          aria-hidden="true"
        />

        <div class="mu-drop-ph" id="mu-drop-ph">
          <span class="mu-drop-icon" aria-hidden="true">📷</span>
          <span class="mu-drop-label">Click or drag a photo here</span>
          <span class="mu-drop-hint">JPG · PNG · WEBP · max 10 MB</span>
        </div>

        <div class="mu-drop-preview" id="mu-drop-preview" hidden>
          <img
            class="mu-preview-img"
            id="mu-preview-img"
            alt="Selected photo preview"
          />
          <button
            class="mu-remove"
            id="mu-remove"
            type="button"
            aria-label="Remove photo"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Who's uploading: name, then the table number on their place card -->
      <div class="mu-field">
        <label class="mu-label" for="mu-name">Your name</label>
        <input
          class="mu-input"
          id="mu-name"
          type="text"
          placeholder="e.g. Maria Santos"
          autocomplete="off"
          autocapitalize="words"
          spellcheck={false}
        />
        <div
          class="mu-suggestions"
          id="mu-suggestions"
          role="listbox"
          aria-label="Guest matches"
          hidden
        >
        </div>
        <p class="mu-hint" id="mu-name-hint">
          Type your name as it appears on your place card.
        </p>
      </div>

      <div class="mu-field" id="mu-table-field" hidden>
        <label class="mu-label" for="mu-table">Table number</label>
        <input
          class="mu-input"
          id="mu-table"
          type="number"
          min="1"
          max="99"
          inputmode="numeric"
          placeholder="e.g. 7"
          autocomplete="off"
        />
        <p class="mu-hint">It's on your place card.</p>
      </div>

      <!-- Caption (optional) -->
      <div class="mu-field">
        <label class="mu-label" for="mu-caption">
          Caption <span class="mu-optional">(optional)</span>
        </label>
        <input
          class="mu-input"
          id="mu-caption"
          type="text"
          placeholder="Describe this moment…"
          maxlength="120"
        />
      </div>

      <div
        class="mu-error"
        id="mu-error"
        role="alert"
        aria-live="polite"
        hidden
      >
      </div>

      <div class="mu-actions">
        <button class="mu-cancel-btn" id="mu-cancel" type="button"
          >Cancel</button
        >
        <button class="mu-submit-btn" id="mu-submit" type="submit">
          <span class="mu-submit-text">Upload photo</span>
          <span class="mu-submit-dots" aria-hidden="true">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </span>
        </button>
      </div>
    </form>

    <!-- ── Success state ──────────────────────────────────── -->
    <!-- Shows the photo back to the guest. "Submitted" is a receipt; seeing
         the actual picture is what reads as "you got it". -->
    <div class="mu-success" id="mu-success" role="status" hidden>
      <div class="mu-success-card">
        <div class="mu-success-thumb-wrap">
          <img class="mu-success-thumb" id="mu-success-thumb" alt="" />
          <span class="mu-success-check" aria-hidden="true">✓</span>
        </div>

        <div class="mu-success-text">
          <p class="mu-success-eyebrow">Added to the album</p>
          <p class="mu-success-title font-display" id="mu-success-title">
            Thank you 💛
          </p>
          <p class="mu-success-body">
            It'll appear on this page once we've had a look — we're reading
            every one.
          </p>
          <p class="mu-success-caption" id="mu-success-caption" hidden></p>
        </div>
      </div>

      <p class="mu-success-count" id="mu-success-count" hidden></p>

      <div class="mu-success-actions">
        <button class="mu-another-btn" id="mu-another" type="button">
          Add another
        </button>
        <button class="mu-done-btn" id="mu-done" type="button">Done</button>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/memory-upload";
</script>
