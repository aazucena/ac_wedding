---
// components/memories/MemoryUpload.astro
// "Share your photo" form — POSTs multipart to /api/photo/upload.
// defaultToken pre-fills the token field when navigated from the RSVP link.
import '../../styles/memory-upload.css';
interface Props {
  defaultToken?: string;
}
const { defaultToken = '' } = Astro.props;
---

<section class="mu-section" id="mu-section">

  <!-- ── CTA banner (collapsed state) ─────────────────────── -->
  <div class="mu-cta" id="mu-cta">
    <div class="mu-cta-left">
      <p class="mu-cta-title font-display">Share your photos</p>
      <p class="mu-cta-body">
        Upload a photo from the day to add it to our memories.
      </p>
    </div>
    <button class="mu-open-btn" id="mu-open" type="button">
      Upload
      <span class="mu-open-arrow" aria-hidden="true">↑</span>
    </button>
  </div>

  <!-- ── Upload form (expanded state) ──────────────────────── -->
  <div class="mu-expand" id="mu-expand" hidden>

    <form class="mu-form" id="mu-form" novalidate>

      <!-- File drop zone -->
      <div class="mu-drop" id="mu-drop" tabindex="0" role="button"
           aria-label="Select a photo to upload">
        <input class="mu-file-input" id="mu-file" type="file"
               accept="image/*" tabindex="-1" aria-hidden="true" />

        <div class="mu-drop-ph" id="mu-drop-ph">
          <span class="mu-drop-icon" aria-hidden="true">📷</span>
          <span class="mu-drop-label">Click or drag a photo here</span>
          <span class="mu-drop-hint">JPG · PNG · WEBP · max 10 MB</span>
        </div>

        <div class="mu-drop-preview" id="mu-drop-preview" hidden>
          <img class="mu-preview-img" id="mu-preview-img" alt="Selected photo preview" />
          <button class="mu-remove" id="mu-remove" type="button" aria-label="Remove photo">
            ✕
          </button>
        </div>
      </div>

      <!-- Invitation token -->
      <div class="mu-field">
        <label class="mu-label" for="mu-token">Invitation code</label>
        <input class="mu-input" id="mu-token" type="text"
               value={defaultToken}
               placeholder="Paste the code from your RSVP link"
               autocomplete="off" spellcheck={false} />
        <p class="mu-hint">The unique code at the end of your invitation email link.</p>
      </div>

      <!-- Caption (optional) -->
      <div class="mu-field">
        <label class="mu-label" for="mu-caption">
          Caption <span class="mu-optional">(optional)</span>
        </label>
        <input class="mu-input" id="mu-caption" type="text"
               placeholder="Describe this moment…"
               maxlength="120" />
      </div>

      <div class="mu-error" id="mu-error" role="alert" aria-live="polite" hidden></div>

      <div class="mu-actions">
        <button class="mu-cancel-btn" id="mu-cancel" type="button">Cancel</button>
        <button class="mu-submit-btn" id="mu-submit" type="submit">
          <span class="mu-submit-text">Upload photo</span>
          <span class="mu-submit-dots" aria-hidden="true">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </span>
        </button>
      </div>

    </form>

    <!-- ── Success state ──────────────────────────────────── -->
    <div class="mu-success" id="mu-success" hidden>
      <span class="mu-success-icon" aria-hidden="true">✦</span>
      <p class="mu-success-title font-display">Photo submitted!</p>
      <p class="mu-success-body">
        Your photo will appear in our memories once it's approved. Thank you!
      </p>
      <button class="mu-another-btn" id="mu-another" type="button">
        Upload another
      </button>
    </div>

  </div>

</section>

<script>import '../../scripts/memory-upload';</script>

