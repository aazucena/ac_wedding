---
// info/ContactCard.astro — contact info section
import { toTelHref } from "~/lib/utils/format";
interface Props {
  email?: string | null;
  phone?: string | null;
}
const { email, phone } = Astro.props;
const emailVal = email ?? "couple@email.com";
const phoneVal = phone ?? "+1 (000) 000-0000";
const phoneHref = toTelHref(phoneVal);
---

<section class="info-section" id="contact">
  <div class="section-header">
    <p class="section-eyebrow">Still have questions?</p>
    <h2 class="section-title">Get in Touch</h2>
  </div>
  <div class="contact-card">
    <div class="contact-col">
      <span class="contact-icon">📧</span>
      <p class="contact-label">Email</p>
      <a href={`mailto:${emailVal}`} class="contact-value">{emailVal}</a>
    </div>
    <div class="contact-divider"></div>
    <div class="contact-col">
      <span class="contact-icon">📱</span>
      <p class="contact-label">Phone / WhatsApp</p>
      <a href={phoneHref} class="contact-value">{phoneVal}</a>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: var(--ivory);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .contact-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--cp), var(--cs));
  }

  .contact-col {
    flex: 1;
    text-align: center;
    padding: 16px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .contact-divider {
    width: 1px;
    height: 80px;
    background: var(--border);
    flex-shrink: 0;
  }

  .contact-icon {
    font-size: 28px;
  }

  .contact-label {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact-value {
    font-family: var(--fd);
    font-size: 22px;
    font-style: italic;
    color: var(--cs);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--cs) 35%, transparent);
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .contact-value:hover {
    opacity: 0.7;
  }

  @media (max-width: 520px) {
    .contact-card {
      flex-direction: column;
    }
    .contact-divider {
      width: 80px;
      height: 1px;
    }
  }
</style>
