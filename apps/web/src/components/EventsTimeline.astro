---
// components/EventsTimeline.astro — grouped date/time event cards
import { formatTime } from '~/lib/utils/format';
import AddToCalendar from './AddToCalendar.astro';
import { toCalDt, toCalEndDt } from '~/lib/utils/calendar';

interface TimelineEventItem {
  start_time?: string | null;
  end_time?:   string | null;
  name:        string;
  venue?:      { name?: string | null; maps_url?: string | null } | null;
  host?:       { first_name?: string | null; last_name?: string | null } | null;
  notes?:      string | null;
  icsKey?:     string | null;
}

interface GroupedDate {
  date:        string;
  label:       string;
  isWeddingDay: boolean;
  events:      TimelineEventItem[];
}

interface Props {
  groupedDates: GroupedDate[];
}

const { groupedDates } = Astro.props;

function hostName(person?: TimelineEventItem['host']): string {
  if (!person) return '';
  return `${person.first_name ?? ''} ${person.last_name ?? ''}`.trim();
}

---

<div id="timeline" class="event-groups">
  {groupedDates.map((group, gi) => (
    <section class="event-group" style={`animation-delay: ${0.1 + gi * 0.1}s`}>
      <div class="event-group-header">
        <h2 class="event-date-label">{group.label}</h2>
        {group.isWeddingDay && (
          <span class="wedding-day-badge">Wedding Day</span>
        )}
      </div>

      <div class="event-cards">
        {group.events.map(ev => (
          <div class="event-card">
            <div class="event-card-time">
              {ev.start_time && (
                <span class="event-time">{formatTime(ev.start_time)}</span>
              )}
              {ev.end_time && (
                <span class="event-time-end">– {formatTime(ev.end_time)}</span>
              )}
            </div>

            <div class="event-card-body">
              <h3 class="event-name">{ev.name}</h3>

              {ev.venue && (
                <div class="event-venue">
                  <span class="event-venue-name">{ev.venue.name}</span>
                  {ev.venue.maps_url && (
                    <a
                      href={ev.venue.maps_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="event-maps-link"
                    >
                      Map →
                    </a>
                  )}
                </div>
              )}

              {hostName(ev.host) && (
                <p class="event-host">Hosted by {hostName(ev.host)}</p>
              )}

              {ev.notes && (
                <p class="event-notes">{ev.notes}</p>
              )}

              {ev.icsKey && (
                <div class="event-cal-wrap">
                  <AddToCalendar
                    name={ev.name}
                    icsKey={ev.icsKey}
                    start={toCalDt(group.date, ev.start_time)}
                    end={toCalEndDt(group.date, ev.start_time, ev.end_time)}
                    location={ev.venue?.name ?? undefined}
                  />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
.event-groups { display: flex; flex-direction: column; gap: 52px; width: 100%; }

.event-group { opacity: 0; animation: fadeUp 0.8s ease forwards; }
.event-group:has(.atc-dropdown[open]) { position: relative; z-index: 1; }

.event-group-header {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  margin-bottom: 20px;
}

.event-date-label {
  font-family: var(--fd); font-size: 28px; font-weight: 300; font-style: italic;
  color: var(--dark);
}

.wedding-day-badge {
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 3px; text-transform: uppercase;
  background: linear-gradient(135deg,
    color-mix(in srgb, var(--cp) 30%, white),
    color-mix(in srgb, var(--cs) 25%, white));
  border: 1px solid color-mix(in srgb, var(--cs) 30%, transparent);
  color: var(--dark); border-radius: 999px; padding: 5px 14px;
}

.event-cards { display: flex; flex-direction: column; gap: 14px; }

.event-card {
  display: grid; grid-template-columns: 100px 1fr; gap: 20px;
  background: var(--ivory); border: 1px solid var(--border);
  border-radius: var(--radius-sm); box-shadow: var(--shadow-card);
  padding: 20px 24px; align-items: start;
  position: relative;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.event-card::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--cp), var(--cs));
}
.event-card:hover { box-shadow: var(--shadow-hover); }

.event-card-time {
  display: flex; flex-direction: column; gap: 2px; padding-top: 3px;
  border-right: 1px solid var(--border);
}
.event-time     { font-family: var(--fb); font-size: 14px; font-weight: 500; color: var(--dark); }
.event-time-end { font-family: var(--fb); font-size: 12px; font-weight: 300; color: var(--muted); }

.event-card-body { display: flex; flex-direction: column; gap: 6px; }

.event-name {
  font-family: var(--fd); font-size: 22px; font-weight: 400; color: var(--dark);
  line-height: 1.2;
}

.event-venue      { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.event-venue-name { font-family: var(--fb); font-size: 12px; font-weight: 400; color: var(--muted); }
.event-maps-link  {
  font-family: var(--fb); font-size: 11px; font-weight: 500;
  color: var(--cs); text-decoration: none; transition: color 0.2s ease;
}
.event-maps-link:hover { color: var(--dark); }

.event-host  { font-family: var(--fb); font-size: 12px; font-weight: 300; font-style: italic; color: var(--muted); }
.event-notes { font-family: var(--fb); font-size: 13px; font-weight: 300; color: var(--muted); line-height: 1.6; margin-top: 2px; }

.event-cal-wrap { margin-top: 8px; }

@media (max-width: 600px) {
  .event-card { grid-template-columns: 1fr; gap: 8px; }
  .event-card-time { border-right: none; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
  .event-time, .event-time-end { display: inline; }
}
</style>
