---
// home/HeroSection.astro — hero + countdown  (2.5D parallax + motion graphics)
import Stacked       from '@assets/stacked.png';
import { Image } from 'astro:assets';
import CountdownBar  from './CountdownBar.astro';
import { assetUrl, focalPoint } from '~/lib/utils/format';
import type { Gallery, Vendors } from '~/lib/types';
import { PUBLIC_DOWNLOAD_GALLERY_IMAGES } from 'astro:env/client';

interface Props {
  groomFull: string;
  brideFull: string;
  weddingDateLabel: string;
  weddingLocation: string;
  weddingDate: string;
  heroPhotos?: Gallery[];
  photographer?: Vendors | string | null;
}
const { groomFull, brideFull, weddingDateLabel, weddingLocation, weddingDate, heroPhotos = [], photographer } = Astro.props;

const credit = photographer && typeof photographer === 'object' ? photographer : null;

const allowDownload = PUBLIC_DOWNLOAD_GALLERY_IMAGES ?? false;
const slides = heroPhotos.filter(p => p.image?.id);
for (let i = slides.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  const tmp = slides[i]!; slides[i] = slides[j]!; slides[j] = tmp;
}

---

<section class="hero" id="hero-parallax">

  <!-- ▸ Depth 0 — photo crossfade (moves most, opposite to cursor) -->
  <div class="hero-bg" id="hero-bg">
    {slides.length > 0
      ? slides.map((photo, i) => (
          <img
            class="hero-slide"
            src={i === 0 ? assetUrl(photo.image!, { width: 1920, height: 1080, quality: 80, fit: 'cover', format: 'auto' }) : undefined}
            data-src={i > 0 ? assetUrl(photo.image!, { width: 1920, height: 1080, quality: 80, fit: 'cover', format: 'auto' }) : undefined}
            alt=""
            loading={i === 0 ? 'eager' : undefined}
            style={`object-position: ${focalPoint(photo.image)}`}
            data-download-protected={String(!allowDownload)}
          />
        ))
      : <div class="hero-bg-placeholder"></div>
    }
  </div>

  <!-- ▸ Depth 1 — vignette overlay (static, no parallax) -->
  <div class="hero-overlay"></div>

  <!-- ▸ Depth 2 — bokeh orbs (only shown for gradient placeholder, not over photos) -->
  {slides.length === 0 && (
    <div class="hero-orbs" id="hero-orbs" aria-hidden="true">
      <span class="hero-orb hero-orb--1"></span>
      <span class="hero-orb hero-orb--2"></span>
      <span class="hero-orb hero-orb--3"></span>
      <span class="hero-orb hero-orb--4"></span>
      <span class="hero-orb hero-orb--5"></span>
    </div>
  )}

  <!-- ▸ Depth 3 — foreground content (floats toward viewer) -->
  <div class:list={['hero-content', { 'hero-content--with-photos': slides.length > 0 }]} id="hero-content">
    <CountdownBar weddingDate={weddingDate} />
    <p class="hero-eyebrow">{weddingDateLabel} · {weddingLocation}</p>
    <p class="hero-sub">Nuptial Mass &amp; Reception</p>
    <div class="hero-emblem-wrap">
      <Image src={Stacked} class:list={['hero-emblem', { 'hero-emblem--over-photo': slides.length > 0 }]} alt={`${groomFull} & ${brideFull}`} />
    </div>
  </div>

  {slides.length > 0 && credit && (
    <p class="hero-photo-credit" aria-label={`Photography by ${credit.name}`}>
      {credit.website
        ? <a href={credit.website} target="_blank" rel="noopener noreferrer">Photography by {credit.name}</a>
        : <>Photography by {credit.name}</>
      }
    </p>
  )}

  <button
    class="hero-scroll-cue"
    aria-label="Scroll down"
    onclick="document.getElementById('main-content').scrollIntoView({ behavior: 'smooth' })"
  >
    <span class="hero-scroll-text hero-scroll-text--mouse">Scroll</span>
    <span class="hero-scroll-text hero-scroll-text--touch">Swipe</span>
    <span class="hero-scroll-arrow">↓</span>
  </button>

  {slides.length > 0 && (
    <button class="hero-focus-btn" id="hero-focus-btn" aria-label="Toggle focus mode" aria-pressed="false">
      <!-- Eye open — shown when NOT in immersive mode -->
      <svg class="hero-focus-icon hero-focus-icon--expand" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
        <circle cx="12" cy="12" r="3"/>
      </svg>
      <!-- Eye off — shown when IN immersive mode -->
      <svg class="hero-focus-icon hero-focus-icon--compress" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
        <line x1="1" y1="1" x2="23" y2="23"/>
      </svg>
      <span class="hero-focus-label hero-focus-label--on">Focus</span>
      <span class="hero-focus-label hero-focus-label--off">Exit</span>
    </button>
  )}
</section>

<style>
/* ── Shell ──────────────────────────────────────────────────── */
.hero {
  position: relative;
  width: 100vw;
  margin-left: calc(50% - 50vw);
  height: 100vh;
  min-height: 560px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  margin-bottom: 72px;
  opacity: 0;
  animation: fadeUp 0.9s 0.1s ease forwards;
}

/* ── Depth 0: photo layer ───────────────────────────────────── */
/* inset: -10% gives a 10% bleed on all sides so JS             */
/* translations never expose the hero edge (overflow: hidden     */
/* clips it). No transform needed in CSS — JS sets translate.   */
.hero-bg {
  position: absolute;
  inset: -15%;
  will-change: transform;
}
.hero-bg-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(165deg,
    color-mix(in srgb, var(--dark) 40%, var(--warm)) 0%,
    color-mix(in srgb, var(--cs) 35%, var(--warm)) 45%,
    color-mix(in srgb, var(--cp) 25%, var(--warm)) 100%
  );
}

/* ── Photo crossfade animation ──────────────────────────────── */
/* @keyframes hero-crossfade is injected dynamically above      */
/* so stop percentages match the actual slide count.            */
@keyframes hero-kb {
  from { transform: scale(1.00) translate(  0%,  0%); }
  to   { transform: scale(1.10) translate(-3%, -1%); }
}
@keyframes hero-pan-left  { from { transform: translateX(0); } to { transform: translateX(-10%); } }
@keyframes hero-pan-right { from { transform: translateX(0); } to { transform: translateX( 10%); } }
@keyframes hero-pan-up    { from { transform: translateY(0); } to { transform: translateY(-7%); } }
@keyframes hero-pan-down  { from { transform: translateY(0); } to { transform: translateY( 7%); } }

.hero-slide {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0;
  animation: hero-pan-left 30s ease-in-out infinite alternate;
  will-change: opacity, transform;
}
.hero-slide:nth-child(2) { animation-name: hero-pan-right; }
.hero-slide:nth-child(3) { animation-name: hero-pan-up;    }
.hero-slide:nth-child(4) { animation-name: hero-pan-down;  }
.hero-slide:nth-child(5) { animation-name: hero-pan-right; }
.hero-slide:only-child {
  opacity: 1;
  animation: hero-kb 20s ease-in-out infinite alternate;
}
@media (prefers-reduced-motion: reduce) {
  .hero-slide             { animation: none; opacity: 0; }
  .hero-slide:first-child { opacity: 1; }
}

/* ── Depth 1: vignette ──────────────────────────────────────── */
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(
    180deg,
    rgba(26,26,46,0.18) 0%,
    rgba(26,26,46,0.35) 40%,
    rgba(26,26,46,0.75) 80%,
    rgba(26,26,46,0.90) 100%
  );
  pointer-events: none;
}

/* ── Depth 2: bokeh orbs ────────────────────────────────────── */
.hero-orbs {
  position: absolute; inset: 0;
  pointer-events: none;
  /* No will-change here — it creates an isolated stacking context
     that breaks mix-blend-mode: screen on child orbs.
     The JS parallax transform still works without it. */
}
.hero-orb {
  position: absolute;
  border-radius: 50%;
  opacity: 0.55;
}

@keyframes orb-drift-1 {
  0%   { transform: translate(  0px,   0px) scale(1.00); }
  25%  { transform: translate(-55px, -45px) scale(1.04); }
  50%  { transform: translate( 30px, -70px) scale(1.07); }
  75%  { transform: translate( 60px, -25px) scale(1.03); }
  100% { transform: translate(  0px,   0px) scale(1.00); }
}
@keyframes orb-drift-2 {
  0%   { transform: translate(  0px,   0px) scale(1.00); }
  30%  { transform: translate( 50px, -55px) scale(0.96); }
  60%  { transform: translate(-40px, -65px) scale(1.05); }
  100% { transform: translate(  0px,   0px) scale(1.00); }
}
@keyframes orb-drift-3 {
  0%   { transform: translate(  0px,   0px) scale(1.00); }
  40%  { transform: translate( 65px, -40px) scale(1.05); }
  70%  { transform: translate( 30px, -75px) scale(0.95); }
  100% { transform: translate(  0px,   0px) scale(1.00); }
}
@keyframes orb-drift-4 {
  0%   { transform: translate(  0px,   0px) scale(1.00); }
  20%  { transform: translate( 45px, -35px) scale(1.07); }
  50%  { transform: translate(-30px, -60px) scale(0.93); }
  80%  { transform: translate( 40px, -15px) scale(1.03); }
  100% { transform: translate(  0px,   0px) scale(1.00); }
}
@keyframes orb-drift-5 {
  0%   { transform: translate(  0px,   0px) scale(1.00); }
  35%  { transform: translate(-60px, -50px) scale(1.04); }
  65%  { transform: translate( 50px, -30px) scale(0.96); }
  100% { transform: translate(  0px,   0px) scale(1.00); }
}

.hero-orb--1 {
  width: 260px; height: 260px; top: 8%; left: 5%;
  background: radial-gradient(circle, var(--cp) 0%, transparent 70%);
  filter: blur(60px);
  animation: orb-drift-1 20s ease-in-out infinite;
}
.hero-orb--2 {
  width: 160px; height: 160px; top: 60%; right: 6%;
  background: radial-gradient(circle, var(--cp) 0%, transparent 70%);
  filter: blur(44px);
  animation: orb-drift-2 15s ease-in-out infinite 2.5s;
}
.hero-orb--3 {
  width: 320px; height: 320px; top: 22%; left: 28%;
  background: radial-gradient(circle, var(--cp) 0%, transparent 70%);
  filter: blur(80px);
  animation: orb-drift-3 26s ease-in-out infinite 5s;
}
.hero-orb--4 {
  width: 120px; height: 120px; top: 74%; left: 16%;
  background: radial-gradient(circle, var(--cp) 0%, transparent 70%);
  filter: blur(32px);
  animation: orb-drift-4 13s ease-in-out infinite 1s;
}
.hero-orb--5 {
  width: 200px; height: 200px; top: 44%; right: 22%;
  background: radial-gradient(circle, var(--cp) 0%, transparent 70%);
  filter: blur(64px);
  animation: orb-drift-5 18s ease-in-out infinite 7s;
}
@media (prefers-reduced-motion: reduce) {
  .hero-orb { animation: none; }
}

/* ── Depth 3: foreground content ────────────────────────────── */
.hero-content {
  position: relative; z-index: 1;
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 80px 40px 32px;
  text-align: center;
  will-change: transform;
}
.hero-eyebrow {
  font-family: var(--fb); font-size: 10px; font-weight: 600;
  letter-spacing: 4px; text-transform: uppercase;
  color: rgba(255,255,255,0.70); margin-top: 20px; margin-bottom: 0;
}
.hero-content--with-photos {
  justify-content: flex-end;
}
.hero-emblem-wrap {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  margin: 8px 0 4px;
  order: -1;
}
.hero-emblem-wrap::before {
  content: '';
  position: absolute;
  inset: -100%;
  background: radial-gradient(
    ellipse 40% 30% at 50% 50%,
    rgba(255,255,255,1.00)  0%,
    rgba(255,255,255,1.00) 30%,
    rgba(255,255,255,0.70) 50%,
    rgba(255,255,255,0.30) 68%,
    rgba(255,255,255,0.08) 82%,
    rgba(255,255,255,0.00) 100%
  );
  pointer-events: none;
  filter: blur(16px);
}
.hero-content--with-photos .hero-emblem-wrap {
  order: 0;
}
.hero-content--with-photos .hero-emblem-wrap::before {
  display: none;
}
.hero-emblem {
  position: relative;
  width: clamp(220px, 42vw, 380px);
  height: auto;
  filter: drop-shadow(0 0 40px rgba(255,255,255,0.35)) drop-shadow(0 4px 32px rgba(0,0,0,0.30));
}
.hero-emblem.hero-emblem--over-photo {
  width: clamp(60px, 10vw, 88px);
  margin-top: 16px;
  filter: drop-shadow(0 4px 32px rgba(0,0,0,0.30));
  animation: emblem-pulse 4s ease-in-out infinite;
}
@keyframes emblem-pulse {
  0%, 100% { opacity: 0.50; }
  50%       { opacity: 1.00; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-emblem.hero-emblem--over-photo { animation: none; opacity: 1; }
}
.hero-sub {
  font-family: var(--fb); font-size: 10px; font-weight: 400;
  letter-spacing: 3.5px; text-transform: uppercase;
  color: rgba(255,255,255,0.60); margin-top: 5px;
}

/* ── Photo credit ───────────────────────────────────────────── */
.hero-photo-credit {
  position: absolute;
  bottom: 0px; right: 0px;
  z-index: 12;
  margin: 0;
  padding: 8px 16px;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 6px 0px 0px 0px;
  font-family: var(--fb); font-size: 11px;
  font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase;
  color: rgba(255,255,255,0.90);
  pointer-events: none;
}
.hero-photo-credit a {
  color: inherit; text-decoration: none;
  pointer-events: auto;
  transition: color 0.2s ease;
}
.hero-photo-credit a:hover { color: rgba(255,255,255,1); }
@media (max-width: 640px) {
  .hero-photo-credit {
    bottom: auto; right: auto;
    top: 0; left: 0;
    border-radius: 0px 0px 6px 0px;
    padding: 5px 10px;
    font-size: 8px;
    letter-spacing: 1.5px;
  }
}

/* ── Scroll cue ─────────────────────────────────────────────── */
.hero-scroll-cue {
  position: relative; z-index: 2;
  display: flex; flex-direction: column;
  width: 100%;
  align-items: center; gap: 6px;
  background: none; border: none; cursor: pointer;
  padding: 12px 20px;
  color: rgba(255,255,255,0.50);
  transition: color 0.2s ease;
}
.hero-scroll-cue:hover { color: rgba(255,255,255,0.90); }
.hero-scroll-text {
  font-family: var(--fb); font-size: 8px;
  font-weight: 600; letter-spacing: 3px; text-transform: uppercase;
}
.hero-scroll-text--touch { display: none; }
@media (hover: none) and (pointer: coarse) {
  .hero-scroll-text--mouse { display: none; }
  .hero-scroll-text--touch { display: inline; }
}
.hero-scroll-arrow {
  font-size: 14px;
  animation: scrollBounce 2s ease-in-out infinite;
}
@keyframes scrollBounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(5px); }
}
@media (prefers-reduced-motion: reduce) {
  .hero-scroll-arrow { animation: none; }
}

/* ── Focus / immersive mode ─────────────────────────────────── */
.hero-content,
.hero-overlay,
.hero-orbs,
.hero-scroll-cue {
  transition: opacity 0.6s ease;
}

.hero--immersive .hero-content,
.hero--immersive .hero-orbs,
.hero--immersive .hero-scroll-cue {
  opacity: 0;
  pointer-events: none;
}
.hero--immersive .hero-overlay { opacity: 0.08; }

/* Focus toggle button */
.hero-focus-btn {
  position: absolute; bottom: 0; left: 0; z-index: 12;
  display: flex; align-items: center; gap: 6px;
  padding: 10px 24px;
  background: rgba(0,0,0,0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: none; border-radius: 0 6px 0 0;
  color: rgba(255,255,255,0.65); cursor: pointer;
  font-family: var(--fb); font-size: 9px; font-weight: 600;
  letter-spacing: 2px; text-transform: uppercase;
  transition: color 0.2s ease, background 0.2s ease;
}
.hero-focus-btn:hover { color: rgba(255,255,255,1); background: rgba(0,0,0,0.6); }

.hero-focus-icon--compress,
.hero-focus-label--off { display: none; }

.hero--immersive .hero-focus-icon--expand,
.hero--immersive .hero-focus-label--on  { display: none; }
.hero--immersive .hero-focus-icon--compress,
.hero--immersive .hero-focus-label--off { display: inline; }

/* ── Responsive ─────────────────────────────────────────────── */
@media (max-width: 640px) {
  .hero { min-height: 380px; }
  .hero-content { padding: 60px 24px 24px; }
  .hero-eyebrow { font-size: 8px; letter-spacing: 2.5px; }
  .hero-sub     { font-size: 8px; letter-spacing: 2px; }

  /* Focus button: icon only on mobile, no label */
  .hero-focus-btn { padding: 8px 10px; gap: 0; }
  .hero-focus-label--on,
  .hero-focus-label--off { display: none !important; }
}

.hero-slide[data-download-protected="true"] {
  -webkit-user-drag: none;
  -webkit-touch-callout: none;
  user-select: none;
}

/* Countdown margin when inside hero */
:global(.hero-content .countdown-bar) { margin-top: 24px; }
</style>

<script>
  // Module-level handles so astro:before-swap can cancel them before each nav
  let _rafId: number | null = null;
  const _slideTimers: ReturnType<typeof setTimeout>[] = [];
  let _keydownHandler: ((e: KeyboardEvent) => void) | null = null;
  let _heroObserver: IntersectionObserver | null = null;

  function cleanup() {
    if (_rafId !== null) { cancelAnimationFrame(_rafId); _rafId = null; }
    _slideTimers.splice(0).forEach(clearTimeout);
    if (_keydownHandler) { document.removeEventListener('keydown', _keydownHandler); _keydownHandler = null; }
    if (_heroObserver)   { _heroObserver.disconnect(); _heroObserver = null; }
  }

  function initHero() {
    const hero    = document.getElementById('hero-parallax') as HTMLElement | null;
    const heroBg  = document.getElementById('hero-bg')       as HTMLElement | null;
    const heroOrb = document.getElementById('hero-orbs')     as HTMLElement | null;
    const heroCnt = document.getElementById('hero-content')  as HTMLElement | null;

    if (!hero || !heroBg || !heroCnt) return;

    // ── Slideshow crossfade ────────────────────────────────────
    const allSlides = Array.from(
      document.querySelectorAll<HTMLImageElement>('#hero-bg .hero-slide')
    );

    document.querySelectorAll<HTMLImageElement>('.hero-slide[data-download-protected="true"]').forEach(img => {
      img.addEventListener('contextmenu', e => e.preventDefault());
      img.addEventListener('dragstart',   e => e.preventDefault());
    });

    if (allSlides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const SHOW_MS = 6000;
      const FADE_MS = 2000;
      let current = 0;

      allSlides[0]!.style.opacity = '1';

      function loadSlide(img: HTMLImageElement) {
        if (img.dataset.src && !img.src) img.src = img.dataset.src;
      }

      loadSlide(allSlides[1]!);

      function crossfadeTo(next: number) {
        const from = allSlides[current]!;
        const to   = allSlides[next]!;
        loadSlide(to);
        from.style.transition = `opacity ${FADE_MS / 1000}s linear`;
        to.style.transition   = `opacity ${FADE_MS / 1000}s linear`;
        requestAnimationFrame(() => requestAnimationFrame(() => {
          from.style.opacity = '0';
          to.style.opacity   = '1';
        }));
        current = next;
        const preloadIdx = (next + 1) % allSlides.length;
        _slideTimers.push(setTimeout(() => loadSlide(allSlides[preloadIdx]!), SHOW_MS / 2));
        _slideTimers.push(setTimeout(() => crossfadeTo((next + 1) % allSlides.length), SHOW_MS + FADE_MS));
      }

      _slideTimers.push(setTimeout(() => crossfadeTo(1), SHOW_MS));
    }

    // ── Focus / immersive mode ─────────────────────────────────
    const focusBtn = document.getElementById('hero-focus-btn');
    const nav      = document.getElementById('site-nav');

    function enterFocus() {
      hero.classList.add('hero--immersive');
      focusBtn?.setAttribute('aria-pressed', 'true');
      if (nav) { nav.style.opacity = '0'; nav.style.pointerEvents = 'none'; }
    }
    function exitFocus() {
      hero.classList.remove('hero--immersive');
      focusBtn?.setAttribute('aria-pressed', 'false');
      if (nav) { nav.style.opacity = ''; nav.style.pointerEvents = ''; }
    }

    focusBtn?.addEventListener('click', () => {
      hero.classList.contains('hero--immersive') ? exitFocus() : enterFocus();
    });

    _keydownHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && hero.classList.contains('hero--immersive')) exitFocus();
    };
    document.addEventListener('keydown', _keydownHandler);

    _heroObserver = new IntersectionObserver(([entry]) => {
      if (!entry!.isIntersecting) exitFocus();
    }, { threshold: 0 });
    _heroObserver.observe(hero);

    // ── Parallax ──────────────────────────────────────────────
    const BG_STR  = 16;
    const ORB_STR =  8;
    const CNT_STR =  4;

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const bg  = heroBg;
      const cnt = heroCnt;

      let tx = 0, ty = 0;
      let cx = 0, cy = 0;

      function setTarget(nx: number, ny: number) { tx = nx; ty = ny; }

      hero.addEventListener('mousemove', (e: MouseEvent) => {
        const r = hero.getBoundingClientRect();
        setTarget(
          ((e.clientX - r.left) / r.width  - 0.5) * 2,
          ((e.clientY - r.top)  / r.height - 0.5) * 2,
        );
      });
      hero.addEventListener('mouseleave', () => { tx = 0; ty = 0; });

      if (typeof DeviceOrientationEvent !== 'undefined') {
        window.addEventListener('deviceorientation', (e: DeviceOrientationEvent) => {
          if (e.gamma == null && e.beta == null) return;
          setTarget(
            Math.max(-1, Math.min(1, (e.gamma ?? 0) / 25)),
            Math.max(-1, Math.min(1, ((e.beta ?? 45) - 45) / 25)),
          );
        }, { passive: true });
      }

      function tick() {
        cx += (tx - cx) * 0.025;
        cy += (ty - cy) * 0.025;
        bg.style.transform  = `translate3d(${cx * -BG_STR}px,  ${cy * -BG_STR  * 0.5}px, 0)`;
        if (heroOrb) heroOrb.style.transform = `translate3d(${cx * -ORB_STR}px, ${cy * -ORB_STR * 0.5}px, 0)`;
        cnt.style.transform = `translate3d(${cx *  CNT_STR}px, ${cy *  CNT_STR * 0.5}px, 0)`;
        _rafId = requestAnimationFrame(tick);
      }
      _rafId = requestAnimationFrame(tick);
    }
  }

  document.addEventListener('astro:before-swap', cleanup);
  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('hero-parallax')) initHero();
  });
</script>
