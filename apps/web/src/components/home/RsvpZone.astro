---
// home/RsvpZone.astro — RSVP counter, deadline, and CTA button
import { formatDate } from "../../lib/utils/format";
interface Props {
  count: number;
  deadline?: string | null;
}
const { count, deadline } = Astro.props;
const deadlineLabel = deadline ? formatDate(deadline) : null;
---

<div class="rsvp-zone">
  {
    deadlineLabel && (
      <p class="rsvp-deadline-text">Kindly reply by {deadlineLabel}</p>
    )
  }
  <a href="/invite" class="rsvp-cta-btn">RSVP Now</a>
  {
    count > 0 && (
      <p class="rsvp-counter">
        <span class="rsvp-counter-num">{count}</span>
        <span class="rsvp-counter-lbl"> guests confirmed</span>
      </p>
    )
  }
</div>

<style>
  .rsvp-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.8s 0.4s ease forwards;
  }
  .rsvp-counter {
    font-family: var(--fb);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 1px;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .rsvp-counter-num {
    font-family: var(--fd);
    font-size: 22px;
    font-weight: 400;
    color: var(--dark);
  }
  .rsvp-deadline-text {
    font-family: var(--fb);
    font-size: 12px;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.5px;
  }
  .rsvp-cta-btn {
    display: inline-block;
    padding: 17px 52px;
    background: linear-gradient(135deg, var(--dark), var(--dark2));
    color: color-mix(in srgb, var(--cp) 80%, white);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    box-shadow: 0 8px 32px rgba(26, 26, 46, 0.2);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .rsvp-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(26, 26, 46, 0.28);
  }
</style>
