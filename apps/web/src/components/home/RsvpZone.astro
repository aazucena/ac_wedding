---
// home/RsvpZone.astro — confirmed-guest counter (RSVP closed after the wedding)
interface Props {
  count: number;
}
const { count } = Astro.props;
---

{
  count > 0 && (
    <div class="rsvp-zone">
      <p class="rsvp-counter">
        <span class="rsvp-counter-num">{count}</span>
        <span class="rsvp-counter-lbl"> guests celebrated with us</span>
      </p>
    </div>
  )
}

<style>
  .rsvp-zone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    text-align: center;
    opacity: 0;
    animation: fadeUp 0.8s 0.4s ease forwards;
  }
  .rsvp-counter {
    font-family: var(--fb);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 1px;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }
  .rsvp-counter-num {
    font-family: var(--fd);
    font-size: 22px;
    font-weight: 400;
    color: var(--dark);
  }
</style>
