---
// apps/web/src/components/home/EnvelopePreloader.astro
interface Props {
  groomFull: string;
  brideFull: string;
  weddingDateLabel: string;
  weddingLocation: string;
}
const { groomFull, brideFull, weddingDateLabel, weddingLocation } = Astro.props;
---

<div
  id="envelope-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Wedding Invitation"
>
  <div
    class="env-wrapper"
    role="button"
    tabindex="0"
    aria-label="Open invitation"
  >
    <!-- Golden inner glow — z-0, visible through the transparent lid opening.
         Blazes to life when the envelope opens, like light from a treasure chest. -->
    <div class="env-glow" aria-hidden="true"></div>

    <!-- Closed flap: visible when sealed, folds to edge-on (-90°) first -->
    <div class="env-lid env-lid-c" aria-hidden="true"></div>

    <!-- Open/inner flap: starts hidden at -90°, folds fully back (-180°) -->
    <div class="env-lid env-lid-o" aria-hidden="true"></div>

    <!-- Invitation card: z-2 — rises between lid-o (z-1) and env-body (z-3).
         Masked by the colored body borders while inside; visible when above. -->
    <div id="env-letter" class="env-letter">
      <div class="letter-inner">
        <p class="letter-eyebrow">
          <span id="env-dear">Dear <span id="env-name"></span>,</span>
          <span id="env-generic">You are cordially invited</span>
        </p>
        <span class="letter-seal" aria-hidden="true">✦</span>
        <div class="letter-names">
          {groomFull}
          <span class="letter-amp">&amp;</span>
          {brideFull}
        </div>
        <div class="letter-divider" aria-hidden="true">
          <span class="div-rule"></span>
          <span class="div-sym">✦</span>
          <span class="div-rule"></span>
        </div>
        <p class="letter-date">{weddingDateLabel}</p>
        <p class="letter-location">{weddingLocation}</p>
        <div class="letter-cta">
          <button id="env-accept" type="button">I Accept</button>
        </div>
      </div>
    </div>

    <!-- Envelope body: permanent z-3 mask + V-fold decoration.
         border-top transparent = the opening the letter rises through.
         Colored side/bottom borders form the classic fold-crease pattern. -->
    <div class="env-body" aria-hidden="true"></div>

    <!-- Wax seal at the flap junction — fades when envelope opens -->
    <div class="env-seal-disc" aria-hidden="true">
      <span class="env-seal-text">A&amp;C</span>
    </div>
  </div>
  <p id="env-hint" class="env-hint" aria-hidden="true">Tap to open</p>

  <!-- Full-screen Zelda-style flash — fires when lid fully opens -->
  <div id="env-flash" class="env-flash" aria-hidden="true">
    <!-- 8 sparkle particles radiating outward at 45° intervals -->
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>
</div>

<style>
  /* ─── Overlay backdrop ──────────────────────────── */
  #envelope-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    background: rgba(26, 26, 46, 0.78);
    backdrop-filter: blur(10px);
    opacity: 0;
    animation: overlayIn 0.6s 0.1s ease forwards;
  }
  #envelope-overlay.dismissing {
    animation: overlayOut 0.55s ease forwards !important;
    pointer-events: none;
  }
  @keyframes overlayIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes overlayOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  /* ─── Envelope wrapper (the back face) ─────────── */
  .env-wrapper {
    position: relative;
    width: 360px;
    height: 240px;
    background: var(--ivory);
    border-radius: 8px;
    box-shadow:
      0 24px 80px rgba(26, 26, 46, 0.28),
      0 8px 32px rgba(26, 26, 46, 0.14);
    transform: scale(0.84);
    opacity: 0;
    animation: sceneIn 0.65s 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    transition:
      box-shadow 0.5s ease,
      transform 0.2s ease;
    pointer-events: none; /* enabled by JS after sceneIn completes */
  }
  .env-wrapper.ready {
    cursor: pointer;
    pointer-events: auto;
  }
  .env-wrapper.ready:hover {
    transform: translateY(-5px) scale(1.01);
  }
  .env-wrapper.ready:active {
    transform: translateY(-2px) scale(0.99);
  }
  /* External golden halo — sprays upward through the opening like a chest */
  .env-wrapper.is-open {
    box-shadow:
      0 24px 80px rgba(26, 26, 46, 0.28),
      0 8px 32px rgba(26, 26, 46, 0.14),
      0 -30px 80px 10px rgba(255, 210, 60, 0.55),
      0 -10px 120px 20px rgba(255, 170, 20, 0.35),
      0 0px 60px 10px rgba(255, 200, 80, 0.25);
  }
  @keyframes sceneIn {
    from {
      transform: scale(0.84);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* ─── Inner glow ────────────────────────────────── */
  /* Warm radial gradient at z-0 — visible through the transparent border-top
     of env-body (the opening) but masked everywhere else by the colored borders.
     Peaks at ~40% through the 2s animation = ~800ms after is-open fires = lid fully open. */
  .env-glow {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgba(255, 230, 100, 1) 0%,
      rgba(255, 190, 40, 0.9) 20%,
      rgba(255, 150, 0, 0.6) 50%,
      rgba(255, 120, 0, 0.2) 70%,
      transparent 90%
    );
    z-index: 0;
    opacity: 0;
  }
  .env-wrapper.is-open .env-glow {
    animation: chestGlow 2s ease forwards;
  }
  @keyframes chestGlow {
    0% {
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    65% {
      opacity: 0.85;
    }
    100% {
      opacity: 0.3;
    }
  }

  /* ─── Lids (CSS border triangles) ──────────────── */
  /* Both lids are downward-pointing triangles at the top of the envelope.
     transform-origin: top = rotate around the fold crease (base of triangle). */
  .env-lid {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-left: 180px solid transparent;
    border-right: 180px solid transparent;
    transform-origin: top;
    transition: transform 0.3s linear;
  }

  /* Closed face: flat (0°) → folds to edge-on (−90°) */
  .env-lid-c {
    border-top: 120px solid
      color-mix(in srgb, rgba(200, 160, 40, 1) 18%, var(--ivory));
    transform: perspective(900px) rotateX(0deg);
    z-index: 3;
  }

  /* Inner face: starts hidden at −90°, folds fully back (−180°) with a delay */
  .env-lid-o {
    border-top: 120px solid
      color-mix(in srgb, rgba(255, 210, 80, 1) 25%, var(--ivory));
    transform: perspective(900px) rotateX(-90deg);
    z-index: 1;
  }

  .env-wrapper.is-open .env-lid-c {
    transform: perspective(900px) rotateX(-90deg);
  }
  .env-wrapper.is-open .env-lid-o {
    transform: perspective(900px) rotateX(-180deg);
    transition-delay: 0.28s;
  }

  /* ─── Invitation card ───────────────────────────── */
  .env-letter {
    position: absolute;
    top: 10px;
    left: 10%;
    width: 80%;
    z-index: 2;
    background: var(--ivory);
    border-radius: 6px;
    border: 1px solid var(--border);
    box-shadow: 0 2px 16px rgba(26, 26, 46, 0.07);
    opacity: 0;
  }
  .env-letter.rising {
    animation: letterRise 4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .env-letter.glowing {
    animation: cardGlow 4s ease forwards;
  }

  @keyframes letterRise {
    0% {
      transform: translateY(80px) scale(1);
      opacity: 0;
      z-index: 2;
    }
    12% {
      opacity: 1;
    }
    59% {
      z-index: 2;
    }
    60% {
      transform: translateY(-180px) scale(1);
      z-index: 5;
    }
    100% {
      transform: translateY(-120px) scale(1.5);
      opacity: 1;
      z-index: 5;
    }
  }
  @keyframes cardGlow {
    0% {
      box-shadow: 0 2px 16px rgba(26, 26, 46, 0.07);
    }
    35% {
      box-shadow:
        0 0 60px 24px rgba(255, 230, 120, 0.9),
        0 0 120px 50px rgba(255, 185, 40, 0.6),
        0 0 80px 20px rgba(255, 255, 200, 0.8);
    }
    100% {
      box-shadow:
        0 8px 48px rgba(26, 26, 46, 0.1),
        0 2px 12px rgba(26, 26, 46, 0.05);
    }
  }

  /* ─── Letter inner content ──────────────────────── */
  .letter-inner {
    padding: 24px 28px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
    opacity: 0;
    pointer-events: none;
  }
  .letter-inner.visible {
    animation: letterFadeUp 0.6s ease forwards;
    pointer-events: auto;
  }
  @keyframes letterFadeUp {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .letter-eyebrow {
    font-family: var(--fb);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.5;
  }
  #env-dear {
    display: none;
  }

  .letter-seal {
    font-size: 16px;
    color: var(--cs);
    line-height: 1;
    animation: sealPulse 3s ease-in-out infinite;
  }
  @keyframes sealPulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.12);
    }
  }

  .letter-names {
    font-family: var(--fd);
    font-size: 24px;
    font-weight: 300;
    font-style: italic;
    color: var(--dark);
    line-height: 1.25;
  }
  .letter-amp {
    display: block;
    color: var(--cs);
    font-style: normal;
    font-size: 17px;
    line-height: 1.1;
  }

  .letter-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 180px;
  }
  .div-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }
  .div-sym {
    font-size: 9px;
    color: var(--cs);
    line-height: 1;
  }

  .letter-date {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--dark);
    line-height: 1.5;
  }
  .letter-location {
    font-family: var(--fb);
    font-size: 9.5px;
    font-weight: 300;
    letter-spacing: 1.5px;
    color: var(--muted);
    line-height: 1.5;
  }

  .letter-cta {
    margin-top: 6px;
  }
  #env-accept {
    padding: 11px 30px;
    background: linear-gradient(135deg, var(--dark), var(--dark2));
    color: color-mix(in srgb, var(--cp) 85%, white);
    border: none;
    border-radius: 999px;
    font-family: var(--fb);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 5px 20px rgba(26, 26, 46, 0.24);
    transition:
      opacity 0.2s ease,
      transform 0.18s ease;
  }
  #env-accept:hover {
    opacity: 0.87;
    transform: translateY(-2px);
  }
  #env-accept:active {
    transform: translateY(0);
    opacity: 1;
  }
  #env-accept:focus-visible {
    outline: 2px solid var(--cp);
    outline-offset: 3px;
  }

  /* ─── Envelope body ─────────────────────────────── */
  /* Zero-size element; borders paint the entire 360×240 area.
     border-top transparent = the opening (120px, same height as lid triangles).
     Colored side/bottom borders create the V-fold crease pattern and mask
     the letter card (z-2) while it is still inside the envelope bounds. */
  .env-body {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-top: 120px solid transparent;
    border-right: 180px solid color-mix(in srgb, var(--cp) 14%, var(--ivory));
    border-bottom: 120px solid color-mix(in srgb, var(--cp) 6%, var(--ivory));
    border-left: 180px solid color-mix(in srgb, var(--cs) 12%, var(--ivory));
    z-index: 3;
  }

  /* ─── Wax seal ──────────────────────────────────── */
  .env-seal-disc {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cs), var(--cp));
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 2px 14px color-mix(in srgb, var(--cs) 45%, transparent),
      inset 0 1px 2px rgba(255, 255, 255, 0.28);
    z-index: 4;
    transition:
      opacity 0.3s ease 0.1s,
      transform 0.3s ease 0.1s;
  }
  .env-seal-text {
    font-family: var(--fd);
    font-size: 12px;
    font-weight: 500;
    font-style: italic;
    color: white;
    letter-spacing: 0.5px;
    user-select: none;
  }
  .env-wrapper.is-open .env-seal-disc {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.75);
  }

  /* ─── Tap hint ──────────────────────────────────── */
  .env-hint {
    font-family: var(--fb);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    animation: hintPulse 2s ease-in-out infinite;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .env-hint.hidden {
    opacity: 0;
  }
  @keyframes hintPulse {
    0%,
    100% {
      opacity: 0.45;
      transform: translateY(0);
    }
    50% {
      opacity: 0.9;
      transform: translateY(-3px);
    }
  }

  /* ─── Zelda flash ───────────────────────────────── */
  /* Full-screen radial burst — brightest at the chest/letter center,
     fades outward. Fires at the exact moment the lid is fully open. */
  .env-flash {
    position: fixed;
    inset: 0;
    z-index: 600;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      ellipse at 50% 52%,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 248, 180, 0.95) 18%,
      rgba(255, 210, 60, 0.7) 45%,
      rgba(255, 160, 10, 0.3) 70%,
      transparent 90%
    );
  }
  .env-flash.active {
    animation: zeldaFlash 1.6s ease-out forwards;
  }
  @keyframes zeldaFlash {
    0% {
      opacity: 0;
    }
    6% {
      opacity: 1;
    } /* near-white peak */
    30% {
      opacity: 0.75;
    }
    100% {
      opacity: 0;
    }
  }

  /* ─── Sparkle particles ─────────────────────────── */
  /* 8 spans inside .env-flash share one @keyframes.
     Each gets a different --angle via nth-child, rotating the
     translateY travel direction to create a starburst pattern. */
  .env-flash span {
    position: absolute;
    top: 52%;
    left: 50%;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 30%, rgba(255, 220, 80, 0.8) 100%);
    opacity: 0;
    box-shadow: 0 0 6px 2px rgba(255, 230, 100, 0.9);
  }
  .env-flash.active span {
    animation: sparkleOut 1.1s ease-out forwards;
  }

  /* Stagger + direction for each of the 8 particles */
  .env-flash span:nth-child(1) {
    animation-delay: 0.35s;
    --angle: 0deg;
  }
  .env-flash span:nth-child(2) {
    animation-delay: 0.4s;
    --angle: 45deg;
  }
  .env-flash span:nth-child(3) {
    animation-delay: 0.35s;
    --angle: 90deg;
  }
  .env-flash span:nth-child(4) {
    animation-delay: 0.4s;
    --angle: 135deg;
  }
  .env-flash span:nth-child(5) {
    animation-delay: 0.35s;
    --angle: 180deg;
  }
  .env-flash span:nth-child(6) {
    animation-delay: 0.4s;
    --angle: 225deg;
  }
  .env-flash span:nth-child(7) {
    animation-delay: 0.35s;
    --angle: 270deg;
  }
  .env-flash span:nth-child(8) {
    animation-delay: 0.4s;
    --angle: 315deg;
  }

  @keyframes sparkleOut {
    0% {
      opacity: 1;
      transform: rotate(var(--angle)) translateY(0) scale(1);
    }
    60% {
      opacity: 1;
      transform: rotate(var(--angle)) translateY(-90px) scale(0.8);
    }
    100% {
      opacity: 0;
      transform: rotate(var(--angle)) translateY(-120px) scale(0.4);
    }
  }

  /* ─── Letter float ───────────────────────────────── */
  /* Gentle bob applied after the rise + glow complete —
     the "Link holds the item above his head" moment. */
  .env-letter.floating {
    animation: letterFloat 4.4s ease-in-out infinite !important;
  }
  @keyframes letterFloat {
    0%,
    100% {
      transform: translateY(-120px) scale(1.5);
    }
    50% {
      transform: translateY(-132px) scale(1.5);
    }
  }

  /* ─── Reduced motion ────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    #envelope-overlay {
      animation: none;
      opacity: 1;
    }
    .env-wrapper {
      animation: none;
      transform: scale(1);
      opacity: 1;
    }
    .env-lid-c,
    .env-lid-o,
    .env-seal-disc {
      display: none;
    }
    .env-letter {
      transform: translateY(-120px) scale(var(--letter-scale, 1.5)) !important;
      opacity: 1 !important;
      animation: none !important;
      z-index: 5 !important;
    }
    .letter-inner {
      opacity: 1 !important;
      pointer-events: auto !important;
      animation: none !important;
    }
    .letter-seal {
      animation: none;
    }
  }

  /* ─── Mobile (≤ 400px) ──────────────────────────── */
  @media (max-width: 400px) {
    .env-wrapper {
      width: min(320px, 92vw);
      height: 213px;
    }
    .env-lid {
      border-left-width: 160px;
      border-right-width: 160px;
    }
    .env-lid-c,
    .env-lid-o {
      border-top-width: 107px;
    }
    .env-body {
      border-top-width: 107px;
      border-right-width: 160px;
      border-bottom-width: 106px;
      border-left-width: 160px;
    }
    :root {
      --letter-scale: 1.25;
    }
    @keyframes letterRise {
      0% {
        transform: translateY(80px) scale(1);
        opacity: 0;
        z-index: 2;
      }
      12% {
        opacity: 1;
      }
      79% {
        z-index: 2;
      }
      80% {
        transform: translateY(-180px) scale(1);
        z-index: 5;
      }
      100% {
        transform: translateY(-120px) scale(1.25);
        opacity: 1;
        z-index: 5;
      }
    }
    @keyframes letterFloat {
      0%,
      100% {
        transform: translateY(-120px) scale(1.25);
      }
      50% {
        transform: translateY(-132px) scale(1.25);
      }
    }
  }
</style>

<!--
  Inline: runs synchronously before first paint.
  - localStorage gate: removes overlay immediately if already seen
  - Personalization: fetches party name from /api/cms if ?token= present
  - Animation sequencer: toggles classes / CSS transitions at timed intervals
-->
<script is:inline>
  // Runs synchronously during every View Transition swap, before the browser
  // paints the new frame. Removing the overlay here prevents the flash where
  // it briefly appears then disappears on pages visited after "I Accept".
  document.addEventListener("astro:after-swap", function () {
    try {
      if (!localStorage.getItem("invitation_seen")) return;
      var el = document.getElementById("envelope-overlay");
      if (el) el.remove();
    } catch (_) {}
  });

  (function () {
    "use strict";

    var STORAGE_KEY = "invitation_seen";

    function shouldShow() {
      try {
        return !localStorage.getItem(STORAGE_KEY);
      } catch (_) {
        return false;
      }
    }

    var overlay = document.getElementById("envelope-overlay");
    if (!overlay) return;

    if (!shouldShow()) {
      overlay.remove();
      return;
    }

    // ── Personalization ──────────────────────────────
    var token = new URLSearchParams(location.search).get("token");
    var namePromise = token
      ? fetch(
          "/api/cms/items/parties?filter[rsvp_token][_eq]=" +
            encodeURIComponent(token) +
            "&fields=name&limit=1",
        )
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (j) {
            return (j && j.data && j.data[0] && j.data[0].name) || null;
          })
          .catch(function () {
            return null;
          })
      : null;

    // ── DOM refs ─────────────────────────────────────
    var wrapper = overlay.querySelector(".env-wrapper");
    var hint = document.getElementById("env-hint");
    var flash = document.getElementById("env-flash");
    var letter = document.getElementById("env-letter");
    var inner = letter && letter.querySelector(".letter-inner");
    var btn = document.getElementById("env-accept");
    var dearEl = document.getElementById("env-dear");
    var nameEl = document.getElementById("env-name");
    var genericEl = document.getElementById("env-generic");

    var dismissed = false;
    var ac = new AbortController();
    var sig = ac.signal;

    // ── Helper: inject resolved party name ───────────
    function applyName(name) {
      if (!name) return;
      if (nameEl) nameEl.textContent = name;
      if (dearEl) dearEl.style.display = "";
      if (genericEl) genericEl.style.display = "none";
    }

    // ── Reduced motion: skip to final state ──────────
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (wrapper) {
        wrapper.classList.add("is-open", "ready");
        wrapper.style.cursor = "default";
      }
      if (hint) hint.classList.add("hidden");
      if (namePromise)
        namePromise.then(function (n) {
          if (!sig.aborted) applyName(n);
        });
      if (inner) inner.classList.add("visible");
      setupAccept();
      return;
    }

    // ── Enable click after sceneIn completes (1s) ────
    setTimeout(function () {
      if (sig.aborted) return;
      if (wrapper) wrapper.classList.add("ready");
    }, 1100);

    // ── Opening sequence (triggered by click) ────────
    function startOpening() {
      if (!wrapper || wrapper.classList.contains("is-open")) return;

      // Hide hint, lock out further clicks, open envelope
      if (hint) hint.classList.add("hidden");
      wrapper.classList.remove("ready");
      wrapper.classList.add("is-open");
      wrapper.style.cursor = "default";

      // T+600ms: lid fully open — Zelda flash fires
      setTimeout(function () {
        if (sig.aborted) return;
        if (flash) flash.classList.add("active");
      }, 600);

      // T+850ms: letter starts rising (4s letterRise animation)
      setTimeout(function () {
        if (sig.aborted) return;
        if (letter) letter.classList.add("rising");
      }, 850);

      // T+4850ms: rise complete (850 + 4000) — lock position, start glow
      setTimeout(function () {
        if (sig.aborted) return;
        if (letter) {
          var scale = window.matchMedia("(max-width: 400px)").matches
            ? "1.25"
            : "1.5";
          letter.style.transform = "translateY(-120px) scale(" + scale + ")";
          letter.style.opacity = "1";
          letter.style.zIndex = "5";
          letter.classList.remove("rising");
          letter.classList.add("glowing");
        }
      }, 4850);

      // T+4900ms: float starts + content reveals simultaneously
      // (glow is still building at this point — content fades in through the gold light)
      setTimeout(function () {
        if (sig.aborted) return;
        if (letter) letter.classList.add("floating");
        var reveal = function (name) {
          if (sig.aborted) return;
          applyName(name);
          if (inner) inner.classList.add("visible");
          if (btn) btn.focus({ preventScroll: true });
          if (typeof window.__launchConfetti === "function")
            window.__launchConfetti();
        };
        if (namePromise) {
          namePromise.then(reveal);
        } else {
          reveal(null);
        }
      }, 4900);
    }

    if (wrapper) {
      wrapper.addEventListener("click", startOpening, { signal: sig });
      wrapper.addEventListener(
        "keydown",
        function (e) {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            startOpening();
          }
        },
        { signal: sig },
      );
    }

    // ── Accept button ─────────────────────────────────
    function setupAccept() {
      if (!btn) return;
      btn.addEventListener(
        "click",
        function () {
          if (dismissed) return;
          dismissed = true;
          try {
            localStorage.setItem(STORAGE_KEY, "1");
          } catch (_) {}
          ac.abort();
          if (typeof window.__launchConfetti === "function")
            window.__launchConfetti();
          overlay.classList.add("dismissing");
          overlay.addEventListener(
            "animationend",
            function () {
              if (overlay.parentNode) overlay.remove();
            },
            { once: true },
          );
        },
        { signal: sig },
      );
    }
    setupAccept();

    // ── SPA navigation cleanup ────────────────────────
    document.addEventListener(
      "astro:before-preparation",
      function () {
        ac.abort();
        if (overlay.parentNode) overlay.remove();
      },
      { once: true },
    );
  })();
</script>
