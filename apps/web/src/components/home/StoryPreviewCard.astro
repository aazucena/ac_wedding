---
// home/StoryPreviewCard.astro — story summary card with link to /story
import type { Stories } from '../../lib/types';
import { assetUrl, focalPoint } from '~/lib/utils/format';
interface Props {
  story?: Stories | null;
}
const { story } = Astro.props;
const cover = story?.cover_image?.id ? story.cover_image : null;
---

<div class="story-card">
  <div class="story-photo-placeholder">
    {cover
      ? <img
          src={assetUrl(cover, { width: 480, height: 360, fit: 'cover', quality: 85, format: 'auto' })}
          alt=""
          class="story-cover-img"
          style={`object-position: ${focalPoint(cover)}`}
        />
      : <span>📷</span>
    }
  </div>
  <div class="story-body">
    {story?.headline && <p class="story-headline">{story.headline}</p>}
    <p class="story-text">{story?.summary ?? 'Our story is coming soon.'}</p>
    <a href="/story" class="story-link">Read our story →</a>
  </div>
</div>

<style>
.story-card {
  background: var(--ivory);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-card);
  display: flex; overflow: hidden;
  position: relative;
}
.story-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--cp), var(--cs));
}
.story-photo-placeholder {
  width: 240px; flex-shrink: 0;
  background: linear-gradient(160deg,
    color-mix(in srgb, var(--cp) 30%, var(--warm)),
    color-mix(in srgb, var(--cs) 20%, var(--warm))
  );
  display: flex; align-items: center; justify-content: center;
  font-size: 36px; opacity: 0.5;
  overflow: hidden;
}
.story-cover-img {
  width: 100%; height: 100%; min-height: 200px;
  object-fit: cover; display: block; opacity: 1;
}
.story-body {
  padding: 40px;
  display: flex; flex-direction: column; justify-content: center; gap: 20px;
}
.story-headline {
  font-family: var(--fb); font-size: 10px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase; color: var(--muted);
}
.story-text {
  font-family: var(--fd); font-size: 20px; font-weight: 300;
  color: var(--dark); line-height: 1.8; font-style: italic;
}
.story-link {
  font-family: var(--fb); font-size: 11px; font-weight: 600;
  letter-spacing: 2.5px; text-transform: uppercase;
  color: var(--cs); text-decoration: none;
  border-bottom: 1px solid color-mix(in srgb, var(--cs) 40%, transparent);
  padding-bottom: 2px; align-self: flex-start; transition: opacity 0.2s;
}
.story-link:hover { opacity: 0.7; }

@media (max-width: 640px) {
  .story-card { flex-direction: column; }
  .story-photo-placeholder { width: 100%; min-height: 140px; }
  .story-body { padding: 24px; }
  .story-text { font-size: 16px; }
  .story-link { font-size: 7px; }
}
</style>
