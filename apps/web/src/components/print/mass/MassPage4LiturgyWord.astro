---
// MassPage4LiturgyWord.astro — Page 4: Liturgy of the Word (First Reading + Psalm)
import CardWatermark from "@components/CardWatermark.astro";
import StackedImg from "@assets/stacked.png";
import { Image } from "astro:assets";

interface Props {
  groomFirst: string;
  brideFirst: string;
  firstReadingRef: string;
  firstReadingReader: string | null;
  psalmRef: string;
  psalmReader: string | null;
}

const {
  groomFirst,
  brideFirst,
  firstReadingRef,
  firstReadingReader,
  psalmRef,
  psalmReader,
} = Astro.props;
---

<div class="booklet-page" style="position:relative;">
  <div class="accent-bar"></div>
  <CardWatermark opacity={0.03} size={180} />

  <div class="page-content">
    <div class="section-header">
      <div class="section-eyebrow">Part Two</div>
      <div class="section-title">Liturgy of the Word</div>
      <div class="section-rule">
        <div class="section-rule-line"></div>
        <span class="section-rule-gem">✦</span>
        <div class="section-rule-line"></div>
      </div>
    </div>

    <div class="reading-meta">
      <span class="reading-type">First Reading</span>
      <span class="reading-ref">{firstReadingRef}</span>
      {
        firstReadingReader && (
          <span class="reading-reader">Read by {firstReadingReader}</span>
        )
      }
    </div>
    <div class="reading-text">
      [Scripture text to be inserted — pending parish confirmation]
    </div>
    <div class="reading-close">The word of the Lord.</div>
    <div class="response-label">All</div>
    <div class="response">Thanks be to God.</div>

    <div class="content-rule">
      <div class="content-rule-line"></div>
      <span class="content-rule-gem">✦</span>
      <div class="content-rule-line"></div>
    </div>

    <div class="reading-meta">
      <span class="reading-type">Responsorial Psalm</span>
      <span class="reading-ref">{psalmRef}</span>
      {psalmReader && <span class="reading-reader">Led by {psalmReader}</span>}
    </div>
    <div class="psalm-antiphon">[Psalm antiphon — to be inserted]</div>
    <div class="response-label">Response</div>
    <div class="response">[Antiphon repeated by assembly]</div>
  </div>

  <div class="page-footer">
    <span class="footer-names"
      >{groomFirst} <span class="footer-amp">&amp;</span> {brideFirst}</span
    >
    <Image src={StackedImg} class="footer-logo" alt="" />
    <span class="footer-page">4</span>
  </div>
  <div class="accent-bar-bottom"></div>
</div>
