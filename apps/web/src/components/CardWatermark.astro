---
// src/components/CardWatermark.astro
// Centred hero emblem watermark, absolutely positioned.
// Drop inside any `position: relative` card face.

interface Props {
  opacity?: number; // default 0.04
  size?: number; // px, default 160
}

import HeroEmblem from "@assets/hero_emblem.png";
import { Image } from "astro:assets";

const { opacity = 0.04, size = 160 } = Astro.props;
---

<div
  class="watermark"
  style={`opacity:${opacity};width:${size}px;height:${size}px;`}
>
  <Image src={HeroEmblem} alt="" />
</div>

<style>
  .watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .watermark :global(img) {
    width: 100%;
    height: 100%;
  }
</style>
