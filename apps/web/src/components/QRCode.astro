---
// src/components/QRCode.astro
// Client-side styled QR code using qr-code-styling.
// Props are passed via data-* attributes; the <script> block initialises all
// instances on the page in a single querySelectorAll pass.

interface Props {
  url: string;
  size?: number; // px — default 120
  label?: string; // optional caption below
  class?: string;
  logo?: string; // asset URL to overlay at centre
  logoRatio?: number; // logo size as fraction of QR width (default 0.45)
  /**
   * Module colour. Mint reads as ours on screen, but it's a mid-tone — only
   * ~3.2:1 against paper, and a printer halftones it into a screen of CMY dots
   * that softens every module edge. Anything printed should pass the near-black
   * card ink instead: ~16:1, and pure K on the press.
   */
  color?: string;
  /**
   * Draw to a <canvas> instead of SVG — the belt-and-braces print path.
   *
   * Flattening (lib/qr-flatten.ts) should be enough: it leaves plain filled
   * vector shapes, which is the most ordinary thing a printer can be asked to
   * render. But if a press still mangles a code, a bitmap has no vector
   * constructs left to mangle. The trade is resolution instead of infinite
   * sharpness, which for a QR's hard edges is a fine trade at print DPI.
   */
  raster?: boolean;
  /**
   * Bitmap resolution when `raster` is on. Independent of `size`, which is only
   * the layout box — print CSS scales the canvas to inches regardless. Default
   * targets roughly 300dpi at the sizes these cards actually print at.
   */
  rasterPx?: number;
}

const {
  url,
  size = 120,
  label,
  class: className,
  logo,
  logoRatio = 0.45,
  color = "#5a9e7a",
  raster = false,
  rasterPx,
} = Astro.props;

// 4x the layout box lands ~300dpi at every size these cards use, and the cap
// keeps eight of them on one print page from eating hundreds of MB of canvas.
const rasterResolution = Math.min(rasterPx ?? size * 4, 1600);
---

<div class:list={["qr-wrap", className]}>
  <div
    class="qr-inner"
    data-url={url}
    data-size={String(size)}
    data-logo={logo ?? ""}
    data-logo-ratio={String(logoRatio)}
    data-color={color}
    data-raster={raster ? String(rasterResolution) : ""}
    style={`width:${size}px;height:${size}px;`}
  >
  </div>
  {label && <p class="qr-label">{label}</p>}
</div>

<script>
  import QRCodeStyling from "qr-code-styling";
  // Printers choke on the library's clip-path; see lib/qr-flatten.ts.
  import { flattenClipPaths } from "@lib/qr-flatten";

  function initQR(el: Element) {
    const url = el.getAttribute("data-url") ?? "";
    const size = parseInt(el.getAttribute("data-size") ?? "120");
    const logo = el.getAttribute("data-logo") || undefined;
    const logoRatio = parseFloat(el.getAttribute("data-logo-ratio") ?? "0.22");
    const color = el.getAttribute("data-color") || "#5a9e7a";
    // Non-empty means raster, and holds the bitmap resolution to draw at.
    const raster = parseInt(el.getAttribute("data-raster") || "0") || 0;

    const qr = new QRCodeStyling({
      type: raster ? "canvas" : "svg",
      // The canvas is drawn far larger than its layout box and scaled down by
      // CSS, so it still has print resolution behind it.
      width: raster || size,
      height: raster || size,
      data: url,
      margin: 0,
      // "H" exists to survive a logo punched through the middle. Without one
      // it just buys density nobody asked for: a ~45x45 grid where "M" gives
      // ~33x33, so the dots come out visibly larger. On a sign that has to
      // scan across a dim reception room, bigger modules beat more redundancy.
      qrOptions: { errorCorrectionLevel: logo ? "H" : "M" },
      dotsOptions: { type: "dots", color },
      cornersSquareOptions: { type: "extra-rounded", color },
      cornersDotOptions: { type: "dot", color },
      backgroundOptions: { color: "transparent" },
      ...(logo && {
        image: logo,
        imageOptions: {
          margin: 8,
          imageSize: logoRatio,
          crossOrigin: "anonymous",
        },
      }),
    });

    qr.append(el as HTMLElement);

    // A bitmap has no clip paths in it to begin with — nothing to flatten.
    if (raster) return;

    // append() is synchronous for a plain code but not when a logo has to load
    // first, so watch for the <svg> rather than assuming it's already there.
    const flattenWhenReady = () => {
      const svg = el.querySelector("svg");
      if (!svg) return false;
      flattenClipPaths(svg);
      return true;
    };
    if (!flattenWhenReady()) {
      const observer = new MutationObserver(() => {
        if (flattenWhenReady()) observer.disconnect();
      });
      observer.observe(el, { childList: true, subtree: true });
      // Don't watch forever if the image never resolves.
      setTimeout(() => observer.disconnect(), 10000);
    }
  }

  function init() {
    document
      .querySelectorAll(".qr-inner[data-url]:not([data-qr-ready])")
      .forEach((el) => {
        el.setAttribute("data-qr-ready", "1");
        initQR(el);
      });
  }

  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  .qr-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .qr-inner {
    position: relative;
    display: inline-flex;
  }
  /* :global because the <svg>/<canvas> is injected at runtime and never gets
     Astro's scoping attribute. A raster code is drawn at up to 1600px and has
     to be scaled back into its layout box; the print stylesheets override both
     of these with !important inch sizes. */
  .qr-inner :global(svg),
  .qr-inner :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .qr-label {
    font-family: "Jost", Arial, sans-serif;
    font-size: 7px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a8499;
    text-align: center;
  }
</style>
