---
// Card.astro — base card with top gradient bar; used across all pages
interface Props {
  accent?: boolean;
  hoverable?: boolean;
  class?: string;
  id?: string;
}
const { accent = true, hoverable = false, class: className, id } = Astro.props;
---

<div
  id={id}
  class:list={[
    "relative overflow-hidden rounded-card bg-ivory/80 shadow-card backdrop-blur-sm",
    accent &&
      "before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-gradient-to-r before:from-primary before:to-secondary",
    hoverable &&
      "transition-all duration-300 hover:-translate-y-0.5 hover:shadow-hover",
    className,
  ]}
>
  <slot />
</div>
