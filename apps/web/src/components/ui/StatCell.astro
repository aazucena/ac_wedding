---
// ui/StatCell.astro — countdown cells, RSVP counter
interface Props {
  value: string | number;
  label: string;
  id?: string;
}
const { value, label, id } = Astro.props;
---

<div class="flex flex-col items-center px-4 md:px-6">
  <span
    id={id}
    class="mb-1 font-display text-4xl font-light leading-none text-dark md:text-5xl"
    >{value}</span
  >
  <span
    class="font-body text-[10px] font-medium uppercase tracking-[3px] text-muted"
  >
    {label}
  </span>
</div>
