---
// ui/LoadingDots.astro — animated loading indicator for buttons
---

<span class="inline-flex items-center gap-1" aria-label="Loading">
  <span
    class="h-1.5 w-1.5 animate-bounce rounded-full bg-current [animation-delay:0ms]"
  ></span>
  <span
    class="h-1.5 w-1.5 animate-bounce rounded-full bg-current [animation-delay:150ms]"
  ></span>
  <span
    class="h-1.5 w-1.5 animate-bounce rounded-full bg-current [animation-delay:300ms]"
  ></span>
</span>
