---
// ui/NameVerifyField.astro — reusable name search + table verify + confirmed chip
// Used by /game/upload and /guestbook.
// JS is supplied by the parent page — this component only renders HTML + global styles.
interface Props {
  placeholder?: string;
}
const { placeholder = "e.g. Maria Santos" } = Astro.props;
---

<div class="field">
  <label class="field-label" for="name-input">Your name</label>

  <!-- Confirmed chip (shown after identity verified) -->
  <div id="name-confirmed" class="name-confirmed hidden">
    <span id="name-confirmed-text"></span>
    <button type="button" id="name-change-btn" class="name-change-btn"
      >Change</button
    >
  </div>

  <!-- Text input -->
  <input
    id="name-input"
    name="name"
    type="text"
    placeholder={placeholder}
    class="field-input"
    autocomplete="off"
    required
  />

  <!-- Suggestions dropdown -->
  <div
    id="name-suggestions"
    class="name-suggestions hidden"
    role="listbox"
    aria-label="Guest matches"
  >
  </div>
</div>

<!-- Table verify modal (position:fixed — outside .field) -->
<div
  id="table-verify"
  class="modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="table-verify-title"
>
  <div class="modal-card">
    <div class="modal-header">
      <div class="modal-header-text">
        <p class="modal-eyebrow">Verify identity</p>
        <h2 class="modal-title" id="table-verify-title">What's your table?</h2>
        <p class="modal-desc">
          Confirming as <strong id="pending-name-display"></strong>
        </p>
      </div>
      <button
        type="button"
        id="table-verify-cancel"
        class="modal-close"
        aria-label="Cancel">✕</button
      >
    </div>
    <div class="modal-body">
      <input
        id="table-number-input"
        class="field-input table-number-input"
        type="number"
        min="1"
        max="99"
        placeholder="Your table number"
        autocomplete="off"
        inputmode="numeric"
      />
      <p id="table-verify-error" class="table-verify-error hidden"></p>
    </div>
    <div class="modal-footer">
      <button type="button" class="modal-cancel js-table-cancel">Cancel</button>
      <button type="button" id="table-verify-btn" class="modal-confirm"
        >Confirm</button
      >
    </div>
  </div>
</div>

<style is:global>
  /* ── Utility ─────────────────────────────────────────────────────────────── */
  .hidden {
    display: none !important;
  }

  /* ── Field base ──────────────────────────────────────────────────────────── */
  .field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .field-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dark);
  }
  .field-input {
    padding: 13px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-family: var(--fb);
    font-size: 15px;
    color: var(--dark);
    background: var(--ivory);
    outline: none;
    transition: border-color 0.15s;
    width: 100%;
  }
  .field-input:focus {
    border-color: var(--cs);
  }

  /* ── Name suggestions dropdown ───────────────────────────────────────────── */
  .name-suggestions {
    margin-top: 6px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    background: var(--ivory);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(26, 26, 46, 0.09);
  }
  .name-suggestion-item {
    width: 100%;
    padding: 11px 16px;
    border: none;
    border-bottom: 1px solid var(--border);
    background: transparent;
    cursor: pointer;
    text-align: left;
    font-family: var(--fb);
    font-size: 14px;
    font-weight: 400;
    color: var(--dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: background 0.12s;
  }
  .name-suggestion-item:last-child {
    border-bottom: none;
  }
  .name-suggestion-item:hover {
    background: color-mix(in srgb, var(--cs) 10%, var(--ivory));
  }
  .name-suggestion-confirm {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }
  .name-suggestion-item:hover .name-suggestion-confirm {
    color: var(--dark);
  }
  .name-suggestions-empty {
    padding: 11px 16px;
    font-family: var(--fb);
    font-size: 13px;
    font-weight: 300;
    color: var(--muted);
    font-style: italic;
  }

  /* ── Name confirmed chip ─────────────────────────────────────────────────── */
  .name-confirmed {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border: 1.5px solid var(--cp);
    border-radius: 8px;
    background: color-mix(in srgb, var(--cp) 12%, var(--ivory));
    font-family: var(--fb);
    font-size: 15px;
    font-weight: 500;
    color: var(--dark);
  }
  .name-change-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 0.15s;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .name-change-btn:hover {
    color: var(--dark);
  }

  /* ── Table verify modal ──────────────────────────────────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(26, 26, 46, 0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }
  .modal-card {
    background: white;
    width: 100%;
    max-width: 480px;
    border-radius: 20px;
    box-shadow: 0 8px 40px rgba(26, 26, 46, 0.18);
    overflow: hidden;
    max-height: 90vh;
    overflow-y: auto;
  }
  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 28px 28px 20px;
    border-bottom: 1px solid var(--border);
  }
  .modal-header-text {
    flex: 1;
    min-width: 0;
  }
  .modal-eyebrow {
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .modal-title {
    font-family: var(--fd);
    font-size: 36px;
    font-weight: 300;
    font-style: italic;
    color: var(--dark);
    line-height: 1;
    margin: 0;
  }
  .modal-desc {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 300;
    color: var(--muted);
    margin-bottom: 0;
  }
  .modal-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 16px;
    color: var(--muted);
    padding: 4px;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
    transition: color 0.15s;
  }
  .modal-close:hover {
    color: var(--dark);
  }
  .modal-body {
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .modal-footer {
    display: flex;
    gap: 12px;
    padding: 0 28px 28px;
  }
  .modal-cancel {
    flex: 1;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    background: transparent;
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .modal-cancel:hover {
    border-color: var(--cs);
    color: var(--dark);
  }
  .modal-confirm {
    flex: 2;
    padding: 14px;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    background: var(--dark);
    color: var(--cp);
    font-family: var(--fb);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    transition: opacity 0.15s;
  }
  .modal-confirm:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .table-number-input {
    width: 100%;
    margin: 0;
  }
  .table-verify-error {
    font-family: var(--fb);
    font-size: 12px;
    color: #c0392b;
    margin: 0;
  }
</style>
