---
// ui/Badge.astro — eyebrow labels, section labels, category tags
interface Props {
  text: string;
  variant?: "primary" | "secondary" | "accent";
}
const { text, variant = "primary" } = Astro.props;
---

<span
  class:list={[
    "mb-5 inline-flex items-center rounded-full border px-4 py-1.5 font-body text-[10px] font-medium uppercase tracking-[3.5px] text-dark",
    variant === "primary" &&
      "border-[color-mix(in_srgb,var(--cs)_30%,transparent)] bg-gradient-to-r from-[color-mix(in_srgb,var(--cp)_28%,white)] to-[color-mix(in_srgb,var(--cs)_22%,white)]",
    variant === "secondary" &&
      "border-[color-mix(in_srgb,var(--cs)_25%,transparent)] bg-[color-mix(in_srgb,var(--cs)_15%,white)]",
    variant === "accent" &&
      "border-[color-mix(in_srgb,var(--cp)_25%,transparent)] bg-[color-mix(in_srgb,var(--cp)_15%,white)]",
  ]}
>
  {text}
</span>
