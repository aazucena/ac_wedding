---
// ui/ErrorBanner.astro — inline error message
interface Props {
  message?: string;
  id?: string;
}
const { message, id } = Astro.props;
---

{
  message && (
    <div
      id={id}
      role="alert"
      class="w-full rounded-xs border border-red-200 bg-red-50 px-4 py-3 text-center font-body text-sm text-red-700"
    >
      {message}
    </div>
  )
}
{
  !message && id && (
    <div
      id={id}
      role="alert"
      class="hidden w-full rounded-xs border border-red-200 bg-red-50 px-4 py-3 text-center font-body text-sm text-red-700"
    />
  )
}
