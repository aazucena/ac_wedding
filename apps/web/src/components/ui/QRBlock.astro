---
// ui/QRBlock.astro — QR code + label wrapper (for print pages)
import QRCode from "../QRCode.astro";
interface Props {
  url: string;
  label: string;
  size?: number;
}
const { url, label, size = 120 } = Astro.props;
---

<div class="flex flex-col items-center gap-2">
  <QRCode url={url} size={size} />
  <span
    class="text-center font-body text-[9px] uppercase tracking-[2px] text-muted"
    >{label}</span
  >
</div>
