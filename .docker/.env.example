# wedding-planner/.env
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in all values before running docker compose.
# Never commit .env — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# ── Directus ──────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
DIRECTUS_SECRET=
DIRECTUS_PORT=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public-facing URL of this Directus instance
# Local:      http://localhost:8055
# Production: https://planner.aazucena.com
PUBLIC_URL=

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
CACHE_ENABLED=
CACHE_AUTO_PURGE=

# ── WebSockets ────────────────────────────────────────────────────────────────
WEBSOCKETS_ENABLED=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ENABLED=
# Comma-separated list of allowed origins
# Local:      http://localhost:4321
# Production: https://wedding.aazucena.com
CORS_ORIGIN=

# ── Cookies ───────────────────────────────────────────────────────────────────
# Local dev: false / lax / (empty)
# Production: true / strict / aazucena.com
REFRESH_TOKEN_COOKIE_SECURE=
REFRESH_TOKEN_COOKIE_SAME_SITE=
REFRESH_TOKEN_COOKIE_DOMAIN=

SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAME_SITE=
SESSION_COOKIE_DOMAIN=

# ── Extensions ────────────────────────────────────────────────────────────────
EXTENSIONS_PATH=
EXTENSIONS_AUTO_RELOAD=
# Use Rolldown bundler (Directus 11+ default)
EXTENSIONS_ROLLDOWN=

# ── Content Security Policy ───────────────────────────────────────────────────
# Allows embedding maps, YouTube, etc. in the Directus data studio
# Add any iframe sources you need separated by spaces
CONTENT_SECURITY_POLICY_DIRECTIVES__FRAME_SRC=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM=
EMAIL_TRANSPORT=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
# ImprovMX SMTP password — generate at: https://app.improvmx.com/ → SMTP Credentials
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=
MARKETPLACE_TRUST=

# ── directus-sync transfer (push to production) ───────────────────────────────
# TRANSFER_URL: production Directus URL
# TRANSFER_TOKEN: static token of the admin user on production (set via ADMIN_TOKEN in Railway)
TRANSFER_URL=https://planner.aazucena.com
TRANSFER_TOKEN=

# ── RSVP App (Astro) ──────────────────────────────────────────────────────────
# These are used by apps/web — not by Docker, but kept here for reference
# Copy the values you need into apps/web/.env.local
PUBLIC_DIRECTUS_URL=